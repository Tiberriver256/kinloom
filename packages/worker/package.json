{
  "name": "@kinloom/worker",
  "version": "0.21.0",
  "type": "module",
  "license": "MIT",
  "description": "Cloudflare Worker API, D1 revision ledger, R2 media and bundle cache, and auth/RBAC layer for Kinloom family archives.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/worker"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "^0.21.0",
    "@kinloom/server": "^0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.168.0"
  }
}
