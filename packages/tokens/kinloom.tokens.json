{
  "$description": "Kinloom Design Tokens — W3C DTCG 2025.10 base set (Paper & Ink palette, 9-step modular typographic scale, and semantic geometry). Verified to WCAG 2.2 AA/AAA and APCA 0.0.98G-4g-base-W3.",
  "color": {
    "$type": "color",
    "primitive": {
      "cotton-rag": { "$value": "#F5EFE2", "$description": "Primary archival cotton-rag paper surface." },
      "subtle-rag": { "$value": "#EFE8D8", "$description": "Subtle tinted cotton-rag strip surface." },
      "rag-card": { "$value": "#FCF9F2", "$description": "Elevated paper card and inverse ink on dark chrome." },
      "warm-linen": { "$value": "#EAE1CE", "$description": "Tinted linen surface, muted chrome ink, and decorative hairline." },
      "archival-indigo": { "$value": "#1B2A41", "$description": "Primary display heading, top chrome bar, and primary action surface." },
      "iron-ink": { "$value": "#23272E", "$description": "Primary body copy and strong structural border." },
      "warm-sepia": { "$value": "#4E4A42", "$description": "Secondary archival metadata ink." },
      "loom-ochre": { "$value": "#562E07", "$description": "Primary ochre accent and active jump/memory foreground." },
      "deep-moss": { "$value": "#244A3C", "$description": "Secondary pine-moss accent and cited/addition foreground." },
      "cobalt-ink": { "$value": "#1D4E89", "$description": "Keyboard focus indicator ink." },
      "deep-crimson": { "$value": "#7F231B", "$description": "Conflict status and diff-deletion foreground." },
      "slate-taupe": { "$value": "#827A6A", "$description": "Interactive form control border (WCAG 3:1+)." },
      "sage-wash": { "$value": "#E2EFE7", "$description": "Cited badge and diff-addition surface tint." },
      "rose-wash": { "$value": "#F6E2DF", "$description": "Diff-deletion surface tint." },
      "charcoal-folio": { "$value": "#171614", "$description": "Nocturnal folio canvas, chrome bar, and inverse ink." },
      "slate-card": { "$value": "#1F1D1A", "$description": "Nocturnal elevated card and subtle tinted surface." },
      "smoked-linen": { "$value": "#2A2723", "$description": "Nocturnal linen surface, action surface, and decorative hairline." },
      "parchment-heading": { "$value": "#E4DDD0", "$description": "Halation-capped parchment ink (APCA Lc 82..88 on nocturnal folio)." },
      "warm-stone": { "$value": "#D2C9BA", "$description": "Nocturnal secondary metadata ink (APCA >= Lc 72 on nocturnal surfaces)." },
      "warm-brass": { "$value": "#F6D191", "$description": "Nocturnal brass accent and active highlight ink." },
      "verdigris-sage": { "$value": "#7CC2A6", "$description": "Nocturnal secondary sage accent and cited/addition ink." },
      "archival-sky": { "$value": "#7DB6F2", "$description": "Nocturnal keyboard focus indicator ink." },
      "vermilion-tint": { "$value": "#F39287", "$description": "Nocturnal conflict and diff-deletion ink." },
      "pewter-taupe": { "$value": "#8E8577", "$description": "Nocturnal interactive form control border (WCAG 3:1+)." },
      "night-water": { "$value": "#17222D", "$description": "Nocturnal archival map water fill (JS/MapLibre token)." }
    },
    "semantic": {
      "surface-canvas": { "$value": "{color.primitive.cotton-rag}" },
      "surface-card": { "$value": "{color.primitive.rag-card}" },
      "surface-subtle": { "$value": "{color.primitive.subtle-rag}" },
      "surface-linen": { "$value": "{color.primitive.warm-linen}" },
      "surface-muted": { "$value": "{color.primitive.warm-linen}" },
      "surface-header": { "$value": "{color.primitive.archival-indigo}" },
      "surface-chrome-bar": { "$value": "{color.primitive.archival-indigo}" },
      "surface-action-primary": { "$value": "{color.primitive.archival-indigo}" },
      "surface-action-primary-hover": { "$value": "{color.primitive.archival-indigo}" },
      "text-primary": { "$value": "{color.primitive.iron-ink}" },
      "text-secondary": { "$value": "{color.primitive.warm-sepia}" },
      "text-inverse": { "$value": "{color.primitive.rag-card}" },
      "text-chrome-bar": { "$value": "{color.primitive.rag-card}" },
      "text-on-action-primary": { "$value": "{color.primitive.rag-card}" },
      "text-on-action-primary-muted": { "$value": "{color.primitive.warm-linen}" },
      "accent-primary": { "$value": "{color.primitive.loom-ochre}" },
      "accent-secondary": { "$value": "{color.primitive.deep-moss}" },
      "action-focus": { "$value": "{color.primitive.cobalt-ink}" },
      "status-conflict": { "$value": "{color.primitive.deep-crimson}" },
      "border-strong": { "$value": "{color.primitive.iron-ink}" },
      "border-control": { "$value": "{color.primitive.slate-taupe}" },
      "border-decorative": { "$value": "{color.primitive.warm-linen}" },
      "border-action-primary": { "$value": "{color.primitive.archival-indigo}" },
      "diff-add-bg": { "$value": "{color.primitive.sage-wash}" },
      "diff-add-fg": { "$value": "{color.primitive.deep-moss}" },
      "diff-del-bg": { "$value": "{color.primitive.rose-wash}" },
      "diff-del-fg": { "$value": "{color.primitive.deep-crimson}" },
      "badge-memory-bg": { "$value": "{color.primitive.warm-linen}" },
      "badge-memory-fg": { "$value": "{color.primitive.loom-ochre}" },
      "badge-cited-bg": { "$value": "{color.primitive.sage-wash}" },
      "badge-cited-fg": { "$value": "{color.primitive.deep-moss}" },
      "jump-active-fg": { "$value": "{color.primitive.loom-ochre}" }
    }
  },
  "typography": {
    "family": {
      "$type": "fontFamily",
      "serif": { "$value": "'Newsreader', Georgia, 'Times New Roman', serif" },
      "ui": { "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace" }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "0.75rem", "$description": "12px — micro badges, keyboard caps, print running headers." },
      "xs": { "$value": "0.8125rem", "$description": "13px — compact metadata, mono labels, secondary controls." },
      "sm": { "$value": "0.9375rem", "$description": "15px — compact body prose, form inputs, captions." },
      "base": { "$value": "1rem", "$description": "16px — primary archival body copy and mobile form baseline." },
      "lg": { "$value": "1.125rem", "$description": "18px — lead copy, card titles, drawer headers." },
      "xl": { "$value": "1.3125rem", "$description": "21px — section headings and modal titles." },
      "2xl": { "$value": "1.5rem", "$description": "24px — major section headings." },
      "3xl": { "$value": "clamp(1.75rem, 3vw, 2.4rem)", "$description": "28-38.4px — archival page display H1." },
      "4xl": { "$value": "clamp(2.25rem, 4vw, 3rem)", "$description": "36-48px — editorial hero display." }
    }
  },
  "dimension": {
    "$type": "dimension",
    "chrome": {
      "topbar-height": { "$value": "58px" },
      "auth-banner-height": { "$value": "0px" }
    },
    "radius": {
      "sm": { "$value": "2px" },
      "md": { "$value": "4px" },
      "control": { "$value": "4px" },
      "pill": { "$value": "9999px" },
      "sheet": { "$value": "12px" }
    },
    "controlHeight": {
      "sm": { "$value": "32px" },
      "md": { "$value": "36px" },
      "touch": { "$value": "44px" }
    },
    "borderWidth": {
      "thin": { "$value": "1px" },
      "emphasis": { "$value": "2px" }
    }
  }
}
