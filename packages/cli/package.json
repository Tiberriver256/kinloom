{
  "name": "@kinloom/cli",
  "version": "0.13.0",
  "type": "module",
  "license": "MIT",
  "description": "Operator and AI research agent CLI for initializing, slicing GEDCOM, seeding, submitting batches, and exporting Kinloom archives.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kinloom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-skills.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "^0.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
