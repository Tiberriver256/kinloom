{
  "name": "@kinloom/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Operator and AI research agent CLI for initializing, slicing GEDCOM, seeding, submitting batches, and exporting Kinloom archives.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kinloom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "0.1.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  }
}
