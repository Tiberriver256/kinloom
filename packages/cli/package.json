{
  "name": "@kinloom/cli",
  "version": "0.68.1",
  "type": "module",
  "license": "MIT",
  "description": "Operator and AI research agent CLI for initializing, slicing GEDCOM, seeding, submitting batches, and exporting Kinloom archives.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kinloom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "^0.68.1",
    "@kinloom/server": "^0.68.1",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
