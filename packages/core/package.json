{
  "name": "@kinloom/core",
  "version": "0.58.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "description": "Shared TypeScript domain model, EDTF parser, archive compiler, living-person privacy filter, YAML serializer, GEDCOM 7 engine, and revision diff/revert logic for Kinloom.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "import": "./dist/machines/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
