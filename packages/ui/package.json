{
  "name": "@kinloom/ui",
  "version": "0.31.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "description": "Config-driven React 19 archival explorer and wiki UI for Kinloom.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/archival.css": "./dist/styles/archival.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "^0.31.0",
    "@kinloom/tokens": "^0.31.0",
    "@openhistoricalmap/maplibre-gl-dates": "^2.0.0",
    "@xstate/react": "^6.1.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "xstate": "^5.33.4"
  }
}
