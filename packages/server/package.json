{
  "name": "@kinloom/server",
  "version": "0.39.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "description": "Portable Web-Standard Fetch server, use-case services, and runtime-agnostic adapters for Kinloom.",
  "homepage": "https://github.com/Tiberriver256/kinloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiberriver256/kinloom.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/adapterContractSuite.d.ts",
      "import": "./dist/testing/adapterContractSuite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kinloom/core": "^0.39.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
