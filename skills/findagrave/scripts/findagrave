#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
# ]
# ///
"""Find a Grave CLI: search and read memorials, cemeteries, and places.

Uses the site's own GraphQL API (POST https://www.findagrave.com/orc/graphql),
verified live 2026-11-24. The API is undocumented and internal: no key or
login is needed, but it can change without notice. Requests are spaced
0.3 s apart; bursts can trigger Cloudflare challenges.
"""

from __future__ import annotations

from contextlib import contextmanager
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
import hashlib
import json
import math
import os
import re
import shutil
import sys
import time
from pathlib import Path
from typing import Any, Iterator
from urllib.parse import urlencode, urlsplit

import click
import httpx

GRAPHQL_URL = "https://www.findagrave.com/orc/graphql"
WEBSITE_BASE = "https://www.findagrave.com"
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "Chrome/131.0 Safari/537.36"
)
MIN_INTERVAL_S = 0.3
DEFAULT_CACHE_TTL_HOURS = 168.0
GQL_ATTEMPTS = 3
PHOTO_ATTEMPTS = 3
GQL_TIMEOUT_S = 30.0
PHOTO_TIMEOUT_S = 60.0
CONNECT_TIMEOUT_S = 15.0
RETRY_AFTER_CAP_S = 10.0
TRANSIENT_STATUS_CODES = frozenset({429, 500, 502, 503, 504, 520, 522, 524})
VALID_YEAR_FILTERS = frozenset({"before", "after", "exact", "unknown"})
SAFE_ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")
SAFE_EXT_RE = re.compile(r"^\.[A-Za-z0-9]{1,8}$")
_MEMORIAL_URL_RE = re.compile(
    r"^https://(?:www\.)?findagrave\.com/memorial/(\d+)(?:/[^?#]*)?(?:[?#].*)?$",
    re.IGNORECASE,
)
_CEMETERY_URL_RE = re.compile(
    r"^https://(?:www\.)?findagrave\.com/cemetery/(\d+)(?:/[^?#]*)?(?:[?#].*)?$",
    re.IGNORECASE,
)
_PHOTO_ALLOWED_SUFFIXES = ("findagrave.com", "ancestrycdn.com", "cloudfront.net")
MONTHS = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
]


class _IncompletePhotoError(RuntimeError):
    """Raised when a streamed photo stops before Content-Length bytes arrive."""


def get_cache_root() -> Path:
    override = os.environ.get("KINLOOM_FINDAGRAVE_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-findagrave"


def resolve_cache_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(
                f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0)."
            )
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(
                f"Invalid KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS value: {raw!r}."
            ) from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS value: {raw!r} (must be >= 0)."
            )
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


def validate_entity_id(raw_id: str, label: str = "id") -> str:
    cleaned = str(raw_id).strip()
    if not cleaned or "\x00" in cleaned:
        raise click.BadParameter(f"Invalid {label}: {raw_id!r}")
    if cleaned.lower().startswith("https://"):
        label_lower = label.lower()
        if "cemetery" in label_lower:
            match = _CEMETERY_URL_RE.fullmatch(cleaned)
        elif "memorial" in label_lower:
            match = _MEMORIAL_URL_RE.fullmatch(cleaned)
        else:
            match = _MEMORIAL_URL_RE.fullmatch(cleaned) or _CEMETERY_URL_RE.fullmatch(cleaned)
        if match:
            return match.group(1)
        raise click.BadParameter(f"Invalid {label}: {raw_id!r}")
    if not SAFE_ID_RE.match(cleaned) or cleaned in (".", ".."):
        raise click.BadParameter(f"Invalid {label}: {raw_id!r}")
    return cleaned


def validate_photo_url(raw_url: str) -> str:
    """Allow only HTTPS URLs on Find a Grave or its image CDNs."""
    text = str(raw_url or "").strip()
    if not text or "\x00" in text or any(ord(ch) < 32 for ch in text):
        raise click.ClickException(f"Invalid photo URL: {raw_url!r}")
    parts = urlsplit(text)
    host = (parts.hostname or "").lower()
    if (
        parts.scheme.lower() != "https"
        or not host
        or parts.port not in (None, 443)
        or parts.username
        or parts.password
    ):
        raise click.ClickException(f"Refusing non-HTTPS or disallowed photo URL: {text}")
    allowed = any(
        host == suffix or host.endswith(f".{suffix}")
        for suffix in _PHOTO_ALLOWED_SUFFIXES
    )
    if not allowed:
        raise click.ClickException(f"Refusing photo download from disallowed host {host!r}: {text}")
    return text


def _retry_delay_seconds(
    attempt: int,
    response: httpx.Response | None,
    *,
    base_delay: float = 0.5,
    cap: float = RETRY_AFTER_CAP_S,
) -> float:
    """Compute retry wait seconds, honoring numeric or HTTP-date Retry-After."""
    if response is not None:
        raw = response.headers.get("Retry-After", "").strip()
        if raw:
            try:
                parsed = float(raw)
                if math.isfinite(parsed):
                    return min(cap, max(0.0, parsed))
            except ValueError:
                try:
                    dt = parsedate_to_datetime(raw)
                    if dt.tzinfo is None:
                        dt = dt.replace(tzinfo=timezone.utc)
                    delta = (dt - datetime.now(timezone.utc)).total_seconds()
                    if math.isfinite(delta):
                        return min(cap, max(0.0, delta))
                except (TypeError, ValueError, OverflowError):
                    pass
    return min(cap, base_delay * (2 ** (attempt - 1)))


def sanitize_prefix(prefix: str | None) -> str:
    if not prefix:
        return ""
    cleaned = prefix.strip().strip("_")
    if (
        not cleaned
        or "\x00" in cleaned
        or "/" in cleaned
        or "\\" in cleaned
        or ".." in cleaned
        or ":" in cleaned
    ):
        raise click.BadParameter(f"Invalid --prefix value: {prefix!r}")
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", cleaned).lstrip(".")
    if not safe:
        raise click.BadParameter(f"Invalid --prefix value: {prefix!r}")
    return f"{safe}_"


def safe_photo_filename(photo_id: Any, url: str) -> str:
    raw_id = str(photo_id or "").strip()
    if not raw_id or not SAFE_ID_RE.match(raw_id):
        safe_id = hashlib.sha256((url or raw_id).encode("utf-8")).hexdigest()[:16]
    else:
        safe_id = raw_id
    raw_suffix = Path(url.split("?")[0]).suffix.lower()
    suffix = raw_suffix if SAFE_EXT_RE.match(raw_suffix) else ".jpg"
    return f"{safe_id}{suffix}"


def resolve_safe_child(root: Path, filename: str) -> Path:
    if (
        not filename
        or "\x00" in filename
        or "/" in filename
        or "\\" in filename
        or ":" in filename
        or filename in (".", "..")
    ):
        raise ValueError(f"Unsafe filename: {filename!r}")
    root_resolved = root.resolve()
    dest = (root_resolved / filename).resolve()
    if dest == root_resolved or not dest.is_relative_to(root_resolved):
        raise ValueError(f"Unsafe path escaping root: {filename!r}")
    return dest


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive file lock (POSIX flock) with safe fallback on non-POSIX."""
    try:
        import fcntl
    except ImportError:
        yield
        return

    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def read_json_if_valid(path: Path) -> dict[str, Any] | None:
    if not path.is_file():
        return None
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return parsed if isinstance(parsed, dict) else None


def atomic_write_bytes(dest: Path, data: bytes) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def atomic_write_text(dest: Path, text: str) -> None:
    atomic_write_bytes(dest, text.encode("utf-8"))


def atomic_write_json(dest: Path, payload: Any) -> None:
    atomic_write_text(dest, json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def atomic_copy_file(src: Path, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        shutil.copyfile(src, tmp)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def _read_fresh_envelope(path: Path, ttl_hours: float) -> dict[str, Any] | None:
    ttl_seconds = ttl_hours * 3600.0
    if ttl_seconds <= 0:
        return None
    envelope = read_json_if_valid(path)
    if envelope is None:
        return None
    cached_at = envelope.get("cached_at")
    data = envelope.get("data")
    if not isinstance(cached_at, (int, float)) or not isinstance(data, dict):
        return None
    if (time.time() - float(cached_at)) <= ttl_seconds:
        return data
    return None


def _cached_gql_query(
    kind: str,
    canonical_params: dict[str, Any],
    query: str,
    variables: dict[str, Any],
    *,
    cache_root: Path,
    ttl_hours: float,
    refresh: bool,
) -> tuple[dict[str, Any], bool]:
    canonical = json.dumps(
        canonical_params, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    )
    digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    cache_path = resolve_safe_child(cache_root / "_queries" / kind, f"{digest}.json")
    if not refresh:
        cached = _read_fresh_envelope(cache_path, ttl_hours)
        if cached is not None:
            return cached, True
    lock_path = resolve_safe_child(cache_root / "_locks", f"query_{kind}_{digest}.lock")
    with file_lock(lock_path):
        if not refresh:
            cached = _read_fresh_envelope(cache_path, ttl_hours)
            if cached is not None:
                return cached, True
        data = gql(query, variables)
        atomic_write_json(
            cache_path,
            {"cached_at": time.time(), "params": canonical_params, "data": data},
        )
        return data, False


def _load_or_fetch_memorials_with_hits(
    memorial_ids: list[str],
    *,
    cache_root: Path,
    ttl_hours: float,
    refresh: bool,
) -> tuple[list[dict[str, Any]], list[bool], bool]:
    clean_ids = [validate_entity_id(mid, "memorial id") for mid in memorial_ids]
    by_id: dict[str, dict[str, Any]] = {}
    hit_by_id: dict[str, bool] = {}
    missing_ids: list[str] = []

    for mid in clean_ids:
        if mid in by_id or mid in missing_ids:
            continue
        cache_path = resolve_safe_child(cache_root / "memorials", f"{mid}.json")
        if not refresh:
            cached = _read_fresh_envelope(cache_path, ttl_hours)
            if cached is not None:
                by_id[mid] = enrich_memorial(cached)
                hit_by_id[mid] = True
                continue
        missing_ids.append(mid)

    fetched = False
    if missing_ids:
        fetched = True
        data = gql(GET_QUERY, {"ids": missing_ids})
        for raw_mem in data.get("memorialsById") or []:
            mem = enrich_memorial(raw_mem)
            fetched_id = str(mem.get("id") or "").strip()
            if not fetched_id or not SAFE_ID_RE.match(fetched_id):
                continue
            by_id[fetched_id] = mem
            hit_by_id[fetched_id] = False
            cache_path = resolve_safe_child(cache_root / "memorials", f"{fetched_id}.json")
            lock_path = resolve_safe_child(
                cache_root / "_locks", f"memorial_{fetched_id}.lock"
            )
            with file_lock(lock_path):
                atomic_write_json(
                    cache_path, {"cached_at": time.time(), "data": mem}
                )

    ordered: list[dict[str, Any]] = []
    ordered_hits: list[bool] = []
    for mid in clean_ids:
        if mid in by_id:
            ordered.append(by_id[mid])
            ordered_hits.append(bool(hit_by_id.get(mid, False)))
    return ordered, ordered_hits, not fetched


def _load_or_fetch_memorials(
    memorial_ids: list[str],
    *,
    cache_root: Path,
    ttl_hours: float,
    refresh: bool,
) -> tuple[list[dict[str, Any]], bool]:
    ordered, _hits, all_hit = _load_or_fetch_memorials_with_hits(
        memorial_ids,
        cache_root=cache_root,
        ttl_hours=ttl_hours,
        refresh=refresh,
    )
    return ordered, all_hit


def _load_or_fetch_cemetery_by_id(
    cemetery_id: str,
    *,
    cache_root: Path,
    ttl_hours: float,
    refresh: bool,
) -> tuple[dict[str, Any], bool]:
    clean_id = validate_entity_id(cemetery_id, "cemetery id")
    cache_path = resolve_safe_child(cache_root / "cemeteries", f"{clean_id}.json")
    if not refresh:
        cached = _read_fresh_envelope(cache_path, ttl_hours)
        if cached is not None:
            cem = enrich_cemetery(cached)
            return {"total": 1, "cemeteries": [cem]}, True

    lock_path = resolve_safe_child(cache_root / "_locks", f"cemetery_{clean_id}.lock")
    with file_lock(lock_path):
        if not refresh:
            cached = _read_fresh_envelope(cache_path, ttl_hours)
            if cached is not None:
                cem = enrich_cemetery(cached)
                return {"total": 1, "cemeteries": [cem]}, True
        data = gql(CEMETERY_BY_ID_QUERY, {"ids": [clean_id]})
        result = data.get("cemeteries") or {}
        cemeteries_list = [enrich_cemetery(c) for c in (result.get("cemeteries") or [])]
        result["cemeteries"] = cemeteries_list
        if cemeteries_list:
            atomic_write_json(
                cache_path, {"cached_at": time.time(), "data": cemeteries_list[0]}
            )
        return result, False

SEARCH_QUERY = """
query($s: MemorialSearchInput) {
  memorialSearch(search: $s) {
    total
    memorials {
      id
      name { first last maiden }
      birth { date { year month day circa } place { names { name } } }
      death { date { year month day circa } place { names { name } } }
      cemetery { id names { name } memorialCount coordinates { lat lon } }
      plot
      hasGravePhoto
      isVeteran
    }
  }
}
"""

GET_QUERY = """
query($ids: [ID!]!) {
  memorialsById(ids: $ids) {
    id
    name { first last maiden }
    birth { date { year month day circa } place { names { name } } }
    death { date { year month day circa } place { names { name } } }
    coordinates { lat lon }
    cemetery {
      id
      names { name }
      memorialCount
      coordinates { lat lon }
      physicalAddress { full { value } }
    }
    plot
    inscription { value }
    bio { value }
    isVeteran
    hasGravePhoto
    hasPersonPhoto
    dateCreated
    dateModified
    relationships { type yearMarried memorial { id name { first last } } }
    photos(size: 50) { total photos { id path caption type } }
  }
}
"""

CEMETERY_QUERY = """
query($s: CemeterySearchInput) {
  cemeteries(search: $s) {
    total
    cemeteries {
      id
      names { name }
      memorialCount
      coordinates { lat lon }
      physicalAddress { full { value } }
    }
  }
}
"""

CEMETERY_BY_ID_QUERY = """
query($ids: [ID!]) {
  cemeteries(ids: $ids) {
    total
    cemeteries {
      id
      names { name }
      memorialCount
      coordinates { lat lon }
      physicalAddress { full { value } }
    }
  }
}
"""

PLACE_QUERY = """
query($s: LocationSearchInput) {
  locationsByTypeahead(search: $s) {
    total
    locations {
      __typename
      ... on Location { id names { name } type }
      ... on Cemetery { id names { name } memorialCount }
    }
  }
}
"""


def _new_gql_client() -> httpx.Client:
    return httpx.Client(
        timeout=httpx.Timeout(
            connect=CONNECT_TIMEOUT_S,
            read=GQL_TIMEOUT_S,
            write=15.0,
            pool=15.0,
        ),
        follow_redirects=True,
    )


def gql(query: str, variables: dict) -> dict:
    """Run one GraphQL query with transient HTTP/timeout/HTML retries and return its data dict."""
    headers = {
        "Content-Type": "application/json",
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
    }
    time.sleep(MIN_INTERVAL_S)
    with _new_gql_client() as client:
        for attempt in range(1, GQL_ATTEMPTS + 1):
            try:
                resp = client.post(
                    GRAPHQL_URL,
                    json={"query": query, "variables": variables},
                    headers=headers,
                )
            except (httpx.TimeoutException, httpx.TransportError) as exc:
                if attempt < GQL_ATTEMPTS:
                    time.sleep(_retry_delay_seconds(attempt, None))
                    continue
                click.echo(f"Request failed after {GQL_ATTEMPTS} attempts: {exc}", err=True)
                raise SystemExit(1)
            except httpx.HTTPError as exc:
                click.echo(f"Request failed: {exc}", err=True)
                raise SystemExit(1)

            if resp.status_code == 403:
                click.echo(
                    "Find a Grave returned 403 (Cloudflare challenge). "
                    "Wait a few minutes and retry, or use the website in a browser.",
                    err=True,
                )
                raise SystemExit(1)
            if resp.status_code in TRANSIENT_STATUS_CODES:
                if attempt < GQL_ATTEMPTS:
                    time.sleep(_retry_delay_seconds(attempt, resp))
                    continue
                click.echo(
                    f"HTTP {resp.status_code} from {GRAPHQL_URL} after {GQL_ATTEMPTS} attempts",
                    err=True,
                )
                raise SystemExit(1)
            if resp.status_code != 200:
                click.echo(f"HTTP {resp.status_code} from {GRAPHQL_URL}", err=True)
                raise SystemExit(1)

            content_type = resp.headers.get("content-type", "").lower()
            raw_bytes = resp.content
            if "html" in content_type or _looks_like_html(raw_bytes):
                if attempt < GQL_ATTEMPTS:
                    time.sleep(_retry_delay_seconds(attempt, resp))
                    continue
                click.echo(
                    f"Find a Grave returned an HTML error page instead of JSON from {GRAPHQL_URL}",
                    err=True,
                )
                raise SystemExit(1)
            try:
                body = resp.json()
            except ValueError as exc:
                if attempt < GQL_ATTEMPTS:
                    time.sleep(_retry_delay_seconds(attempt, resp))
                    continue
                click.echo(f"Invalid JSON from {GRAPHQL_URL}: {exc}", err=True)
                raise SystemExit(1)
            if not isinstance(body, dict):
                click.echo(f"Unexpected GraphQL payload from {GRAPHQL_URL}", err=True)
                raise SystemExit(1)
            if body.get("errors"):
                for err in body["errors"]:
                    click.echo(f"GraphQL error: {err.get('message')}", err=True)
                raise SystemExit(1)
            return body.get("data") or {}
    click.echo(f"Request failed for {GRAPHQL_URL}", err=True)
    raise SystemExit(1)


def primary_name(memorial: dict) -> str:
    names = memorial.get("name") or []
    if not names:
        return ""
    first = names[0] or {}
    parts = [first.get("first"), first.get("last")]
    text = " ".join(p for p in parts if p)
    maiden = first.get("maiden")
    if maiden:
        text += f" (nee {maiden})"
    return text


def first_place_name(place: dict | None) -> str:
    if not place:
        return ""
    names = place.get("names") or []
    if not names:
        return ""
    return names[0].get("name") or ""


def fmt_date(date: dict | None) -> str:
    if not date:
        return ""
    year = date.get("year")
    month = date.get("month")
    day = date.get("day")
    if year is None:
        return ""
    text = str(year)
    if month:
        text = f"{MONTHS[month - 1]} {text}" if 1 <= month <= 12 else text
        if day:
            text = f"{day} {text}"
    if date.get("circa"):
        text = f"c. {text}"
    return text


def fmt_event(event: dict | None) -> str:
    if not event:
        return ""
    date = fmt_date(event.get("date"))
    place = first_place_name(event.get("place"))
    return ", ".join(p for p in (date, place) if p)


def fmt_cemetery(cemetery: dict | None) -> str:
    if not cemetery:
        return ""
    names = cemetery.get("names") or []
    return names[0].get("name") if names else ""


def _coords_pair(obj: dict | None) -> tuple[float | None, float | None]:
    if not isinstance(obj, dict):
        return None, None
    lat = obj.get("lat")
    lon = obj.get("lon")
    if lon is None:
        lon = obj.get("lng")
    if isinstance(lat, (int, float)) and isinstance(lon, (int, float)):
        return float(lat), float(lon)
    return None, None


def enrich_cemetery(cemetery: dict | None) -> dict | None:
    """Attach convenient lat/lng fields alongside GraphQL coordinates { lat lon }."""
    if not isinstance(cemetery, dict):
        return cemetery
    lat, lon = _coords_pair(cemetery.get("coordinates"))
    if lat is not None and lon is not None:
        cemetery["lat"] = lat
        cemetery["lng"] = lon
    return cemetery


def enrich_memorial(memorial: dict) -> dict:
    """Attach cemetery_lat/cemetery_lng (and cemetery.lat/lng) from GraphQL GPS coordinates."""
    cem = memorial.get("cemetery")
    if isinstance(cem, dict):
        enrich_cemetery(cem)
        cem_lat, cem_lon = _coords_pair(cem.get("coordinates"))
        memorial["cemetery_lat"] = cem_lat
        memorial["cemetery_lng"] = cem_lon
    else:
        memorial["cemetery_lat"] = None
        memorial["cemetery_lng"] = None
    return memorial


def memorial_url(memorial_id: str) -> str:
    return f"{WEBSITE_BASE}/memorial/{memorial_id}"


def cemetery_url(cemetery_id: str) -> str:
    return f"{WEBSITE_BASE}/cemetery/{cemetery_id}"


def emit(data: dict, as_json: bool) -> None:
    if as_json:
        click.echo(json.dumps(data, indent=2))


def _normalize_year_filter(raw: str | None, flag: str) -> str | None:
    if raw is None:
        return None
    cleaned = raw.strip().lower()
    if cleaned not in VALID_YEAR_FILTERS:
        choices = ", ".join(sorted(VALID_YEAR_FILTERS))
        raise click.BadParameter(f"Invalid {flag} value {raw!r}. Choose from: {choices}.")
    return cleaned


def _resolve_positional_name(
    query_parts: tuple[str, ...],
    first_name: str | None,
    last_name: str | None,
    full_name: str | None = None,
) -> tuple[str | None, str | None]:
    pos_tokens = [tok for part in query_parts for tok in part.strip().split() if tok]
    name_tokens = [tok for tok in (full_name or "").strip().split() if tok]
    if pos_tokens and name_tokens:
        raise click.UsageError("Pass either positional name arguments or --name, not both.")
    tokens = name_tokens or pos_tokens
    if not tokens:
        return first_name, last_name
    if first_name and last_name:
        raise click.UsageError(
            "Pass either positional name / --name or --first/--last, not both."
        )
    if first_name and not last_name:
        return first_name, " ".join(tokens)
    if last_name and not first_name:
        return " ".join(tokens), last_name
    if len(tokens) == 1:
        return None, tokens[0]
    return " ".join(tokens[:-1]), tokens[-1]


@click.group(context_settings={"help_option_names": ["-h", "--help"]})
def cli() -> None:
    """Search and read Find a Grave memorials, cemeteries, and places."""


@cli.command()
@click.argument("query_parts", nargs=-1, metavar="[NAME...]")
@click.option("--name", "full_name", default=None, help="Full name (split into first and last name).")
@click.option("--first", "--first-name", "--given", "--given-name", "first_name", default=None, help="First name.")
@click.option("--last", "--last-name", "--surname", "last_name", default=None, help="Last name.")
@click.option("--birth-year", "--birth", "--born", "birth_year", type=int, default=None)
@click.option("--death-year", "--death", "--died", "death_year", type=int, default=None)
@click.option(
    "--year-range",
    "--birth-range",
    "--death-range",
    "--birth-year-range",
    "--death-year-range",
    "--date-spread",
    "year_range",
    type=int,
    default=None,
    help="Plus/minus years around a birth/death year.",
)
@click.option("--birth-year-filter", default=None,
              help="before, after, exact, or unknown.")
@click.option("--death-year-filter", default=None,
              help="before, after, exact, or unknown.")
@click.option("--cemetery-id", "--cemetery", "cemetery_id", multiple=True, help="Repeatable cemetery id or URL.")
@click.option("--location-id", "--location", "location_id", default=None,
              help="Place id, e.g. city_<id> (see the place command).")
@click.option("--bio", default=None, help="Words in the biography.")
@click.option("--text", "--full-text", "text", default=None, help="Words anywhere on the memorial.")
@click.option("--relative", default=None,
              help="Name of a linked relative.")
@click.option("--exact/--no-exact", default=False,
              help="Exact name match (default: site matching).")
@click.option("--include-maiden/--no-include-maiden", default=True,
              help="Also match married women under maiden names.")
@click.option("-n", "--limit", "--rows", "--size", "limit", type=int, default=10, show_default=True,
              help="Rows per call (max 50).")
@click.option("--page", type=int, default=None, help="1-based result page (alternative to --offset).")
@click.option("--offset", type=int, default=None, help="0-based result offset (default: 0).")
@click.option("--refresh", is_flag=True, help="Bypass local disk cache and query Find a Grave fresh.")
@click.option("--cache-ttl-hours", type=float, default=None,
              help="Override cache TTL in hours (default: 168 or $KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS).")
@click.option("--json", "as_json", is_flag=True, help="Full JSON output.")
def search(query_parts, full_name, first_name, last_name, birth_year, death_year, year_range,
            birth_year_filter, death_year_filter, cemetery_id, location_id,
            bio, text, relative, exact, include_maiden, limit, page, offset,
            refresh, cache_ttl_hours, as_json):
    """Search memorials. Example: search --first Abraham --last Lincoln."""
    if limit < 1:
        raise click.BadParameter(f"Invalid --limit value: {limit!r} (must be >= 1).")
    if offset is not None and offset < 0:
        raise click.BadParameter(f"Invalid --offset value: {offset!r} (must be >= 0).")
    if page is not None and page < 1:
        raise click.BadParameter(f"Invalid --page value: {page!r} (must be >= 1).")
    if page is not None and offset is not None:
        raise click.UsageError("Pass either --page or --offset, not both.")
    first_name, last_name = _resolve_positional_name(query_parts, first_name, last_name, full_name)
    norm_birth_filter = _normalize_year_filter(birth_year_filter, "--birth-year-filter")
    norm_death_filter = _normalize_year_filter(death_year_filter, "--death-year-filter")
    ttl_hours = resolve_cache_ttl_hours(cache_ttl_hours)
    cache_root = get_cache_root()
    page_size = min(limit, 50)
    resolved_offset = offset if offset is not None else ((page - 1) * page_size if page is not None else 0)
    search_input: dict = {}
    if first_name:
        search_input["firstName"] = first_name
    if last_name:
        search_input["lastName"] = last_name
    if birth_year is not None:
        search_input["birthYear"] = birth_year
    if death_year is not None:
        search_input["deathYear"] = death_year
    if year_range is not None:
        if birth_year is not None:
            search_input["birthYearRange"] = year_range
        if death_year is not None:
            search_input["deathYearRange"] = year_range
    if norm_birth_filter:
        search_input["birthYearFilter"] = norm_birth_filter
    if norm_death_filter:
        search_input["deathYearFilter"] = norm_death_filter
    if cemetery_id:
        search_input["cemeteryIds"] = [
            validate_entity_id(cid, "cemetery id") for cid in cemetery_id
        ]
    if location_id:
        search_input["locationId"] = location_id
    if bio:
        search_input["bio"] = bio
    if text:
        search_input["fullText"] = text
    if relative:
        search_input["linkedToName"] = relative
    if exact:
        search_input["exactName"] = True
    search_input["includeMaidenName"] = include_maiden
    search_input["from"] = resolved_offset
    search_input["size"] = page_size
    data, hit = _cached_gql_query(
        "search",
        search_input,
        SEARCH_QUERY,
        {"s": search_input},
        cache_root=cache_root,
        ttl_hours=ttl_hours,
        refresh=refresh,
    )
    result = data.get("memorialSearch") or {}
    memorials = [enrich_memorial(m) for m in (result.get("memorials") or [])]
    result["memorials"] = memorials
    if as_json:
        click.echo(json.dumps({**result, "cache_hit": hit}, indent=2))
        return
    total = result.get("total")
    click.echo(f"{total} memorials")
    for mem in memorials:
        born = fmt_event(mem.get("birth"))
        died = fmt_event(mem.get("death"))
        cem = fmt_cemetery(mem.get("cemetery"))
        photo = "yes" if mem.get("hasGravePhoto") else "no"
        vet = " veteran" if mem.get("isVeteran") else ""
        plot = mem.get("plot") or ""
        row = (
            f"{mem.get('id')} | {primary_name(mem)} | "
            f"b. {born} | d. {died} | {cem} | plot: {plot} | "
            f"grave photo: {photo}{vet} | {memorial_url(str(mem.get('id')))}"
        )
        click.echo(row)


@cli.command()
@click.argument("memorial_ids", nargs=-1, required=True)
@click.option("--refresh", is_flag=True, help="Bypass local disk cache and fetch fresh memorial data.")
@click.option("--cache-ttl-hours", type=float, default=None,
              help="Override cache TTL in hours (default: 168 or $KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS).")
@click.option("--json", "as_json", is_flag=True, help="Full JSON output.")
@click.option("--full", is_flag=True,
              help="Print full bio and inscription instead of truncated.")
@click.option("--photos", is_flag=True,
              help="List photo ids, types, and image URLs.")
def get(memorial_ids, refresh, cache_ttl_hours, as_json, full, photos):
    """Read one or more memorials in full by memorial id or URL (alias: memorial).

    --json prints a list of memorial objects, each carrying a boolean cache_hit
    field so CLI telemetry tracks cache hits without breaking the list contract.
    """
    ttl_hours = resolve_cache_ttl_hours(cache_ttl_hours)
    cache_root = get_cache_root()
    memorials, item_hits, _all_hit = _load_or_fetch_memorials_with_hits(
        list(memorial_ids),
        cache_root=cache_root,
        ttl_hours=ttl_hours,
        refresh=refresh,
    )
    if as_json:
        emitted = [
            {**mem, "cache_hit": bool(hit)}
            for mem, hit in zip(memorials, item_hits, strict=True)
        ]
        click.echo(json.dumps(emitted, indent=2))
        return
    for mem in memorials:
        mid = str(mem.get("id"))
        click.echo(f"Memorial {mid}: {primary_name(mem)}")
        click.echo(f"  URL: {memorial_url(mid)}")
        born = fmt_event(mem.get("birth"))
        died = fmt_event(mem.get("death"))
        if born:
            click.echo(f"  Born: {born}")
        if died:
            click.echo(f"  Died: {died}")
        cem = mem.get("cemetery") or {}
        cem_name = fmt_cemetery(cem)
        if cem_name:
            click.echo(f"  Cemetery: {cem_name} ({cem.get('id')})")
        cem_lat, cem_lon = _coords_pair(cem.get("coordinates"))
        if cem_lat is not None and cem_lon is not None:
            click.echo(f"  Cemetery GPS: {cem_lat}, {cem_lon}")
        grave_lat, grave_lon = _coords_pair(mem.get("coordinates"))
        if grave_lat is not None and grave_lon is not None:
            click.echo(f"  Grave GPS: {grave_lat}, {grave_lon}")
        if mem.get("plot"):
            click.echo(f"  Plot: {mem.get('plot')}")
        click.echo(
            f"  Veteran: {'yes' if mem.get('isVeteran') else 'no'} | "
            f"Grave photo: {'yes' if mem.get('hasGravePhoto') else 'no'} | "
            f"Photos: {(mem.get('photos') or {}).get('total')}"
        )
        inscription = (mem.get("inscription") or {}).get("value")
        bio = (mem.get("bio") or {}).get("value")
        if inscription:
            shown = inscription if full else inscription[:500]
            click.echo(f"  Inscription: {shown}")
        if bio:
            shown = bio if full else bio[:500]
            click.echo(f"  Bio: {shown}")
        relations = mem.get("relationships") or []
        if relations:
            click.echo("  Relationships:")
            for rel in relations:
                target = rel.get("memorial") or {}
                target_name = primary_name(target)
                click.echo(
                    f"    {rel.get('type')}: {target_name} "
                    f"({target.get('id')})"
                )
        if photos:
            photo_list = (mem.get("photos") or {}).get("photos") or []
            if photo_list:
                click.echo("  Photos:")
                for photo in photo_list:
                    click.echo(
                        f"    {photo.get('id')} | {photo.get('type')} | "
                        f"{photo.get('path')}"
                    )
        if mem.get("dateCreated"):
            click.echo(
                f"  Created: {mem.get('dateCreated')} | "
                f"Modified: {mem.get('dateModified')}"
            )


cli.add_command(get, name="memorial")
cli.add_command(get, name="show")


@cli.command()
@click.argument("cemetery_id_arg", required=False, default=None)
@click.option("--name", default=None, help="Cemetery name to search.")
@click.option("--id", "cemetery_id", default=None,
              help="Read one cemetery by id or URL (or pass id as a positional argument).")
@click.option("--place", default=None,
              help="Containing place name, e.g. 'Sangamon County, Illinois'.")
@click.option("-n", "--limit", "limit", type=int, default=10, show_default=True)
@click.option("--offset", type=int, default=0, show_default=True)
@click.option("--refresh", is_flag=True, help="Bypass local disk cache and fetch fresh cemetery data.")
@click.option("--cache-ttl-hours", type=float, default=None,
              help="Override cache TTL in hours (default: 168 or $KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS).")
@click.option("--json", "as_json", is_flag=True, help="Full JSON output.")
def cemetery(cemetery_id_arg, name, cemetery_id, place, limit, offset, refresh, cache_ttl_hours, as_json):
    """Search cemeteries by name, or read one by id."""
    if limit < 1:
        raise click.BadParameter(f"Invalid --limit value: {limit!r} (must be >= 1).")
    if offset < 0:
        raise click.BadParameter(f"Invalid --offset value: {offset!r} (must be >= 0).")
    ttl_hours = resolve_cache_ttl_hours(cache_ttl_hours)
    cache_root = get_cache_root()
    resolved_id = cemetery_id or cemetery_id_arg
    if resolved_id:
        result, hit = _load_or_fetch_cemetery_by_id(
            resolved_id,
            cache_root=cache_root,
            ttl_hours=ttl_hours,
            refresh=refresh,
        )
        cemeteries_list = result.get("cemeteries") or []
    else:
        if not name:
            raise click.UsageError("Pass a cemetery id, --id, or --name.")
        search_input: dict = {"name": name}
        if place:
            search_input["containingLocationName"] = place
        search_input["from"] = offset
        search_input["size"] = min(limit, 100)
        data, hit = _cached_gql_query(
            "cemetery_search",
            search_input,
            CEMETERY_QUERY,
            {"s": search_input},
            cache_root=cache_root,
            ttl_hours=ttl_hours,
            refresh=refresh,
        )
        result = data.get("cemeteries") or {}
        cemeteries_list = [enrich_cemetery(c) for c in (result.get("cemeteries") or [])]
        result["cemeteries"] = cemeteries_list
    if as_json:
        click.echo(json.dumps({**result, "cache_hit": hit}, indent=2))
        return
    click.echo(f"{result.get('total')} cemeteries")
    for cem in cemeteries_list:
        names = cem.get("names") or []
        shown = names[0].get("name") if names else ""
        extra = ""
        if len(names) > 1:
            extra = " (also: " + ", ".join(n.get("name") for n in names[1:]) + ")"
        lat, lon = _coords_pair(cem.get("coordinates"))
        gps = f" | GPS: {lat}, {lon}" if lat is not None and lon is not None else ""
        click.echo(
            f"{cem.get('id')} | {shown}{extra} | "
            f"{cem.get('memorialCount')} memorials{gps} | "
            f"{cemetery_url(str(cem.get('id')))}"
        )


@cli.command()
@click.argument("name_parts", nargs=-1, metavar="[PLACE...]")
@click.option("--name", default=None, help="Place name, e.g. Springfield.")
@click.option("-n", "--limit", "limit", type=int, default=10, show_default=True)
@click.option("--refresh", is_flag=True, help="Bypass local disk cache and fetch fresh places.")
@click.option("--cache-ttl-hours", type=float, default=None,
              help="Override cache TTL in hours (default: 168 or $KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS).")
@click.option("--json", "as_json", is_flag=True, help="Full JSON output.")
def place(name_parts, name, limit, refresh, cache_ttl_hours, as_json):
    """Resolve a place name to Find a Grave place ids.

    Use the returned id (e.g. city_<id>) with search --location-id.
    """
    if limit < 1:
        raise click.BadParameter(f"Invalid --limit value: {limit!r} (must be >= 1).")
    pos_name = " ".join(p for p in name_parts if p).strip()
    if pos_name and name:
        raise click.UsageError("Pass either a positional place name or --name, not both.")
    resolved_name = (name or pos_name).strip()
    if not resolved_name:
        raise click.UsageError("Pass a place name positionally or with --name.")
    ttl_hours = resolve_cache_ttl_hours(cache_ttl_hours)
    cache_root = get_cache_root()
    search_input = {"name": resolved_name, "size": min(limit, 50)}
    data, hit = _cached_gql_query(
        "place",
        search_input,
        PLACE_QUERY,
        {"s": search_input},
        cache_root=cache_root,
        ttl_hours=ttl_hours,
        refresh=refresh,
    )
    result = data.get("locationsByTypeahead") or {}
    if as_json:
        click.echo(json.dumps({**result, "cache_hit": hit}, indent=2))
        return
    click.echo(f"{result.get('total')} places")
    for loc in result.get("locations") or []:
        names = loc.get("names") or []
        shown = names[0].get("name") if names else ""
        kind = loc.get("__typename")
        count = loc.get("memorialCount")
        suffix = f" | {count} memorials" if count is not None else ""
        click.echo(f"{loc.get('id')} | {kind} | {shown}{suffix}")


_IMAGE_CONTENT_TYPES = frozenset(
    {"image/jpeg", "image/jpg", "image/png", "image/gif", "image/webp"}
)


def _image_content_type(content_type: str | None) -> str | None:
    if not content_type:
        return None
    base = content_type.split(";", 1)[0].strip().lower()
    if base in _IMAGE_CONTENT_TYPES:
        return base
    return None


def _has_image_magic(content: bytes) -> bool:
    if content.startswith(b"\xff\xd8\xff"):
        return True
    if content.startswith(b"\x89PNG\r\n\x1a\n"):
        return True
    if content.startswith(b"GIF87a") or content.startswith(b"GIF89a"):
        return True
    return len(content) >= 12 and content.startswith(b"RIFF") and content[8:12] == b"WEBP"


def _looks_like_html(content: bytes) -> bool:
    sample = content.lstrip()[:64].lower()
    return (
        sample.startswith(b"<html")
        or sample.startswith(b"<!doctype")
        or sample.startswith(b"<head")
        or sample.startswith(b"<body")
    )


def _photo_bytes_accepted(content: bytes, content_type: str | None) -> bool:
    if not content or _looks_like_html(content):
        return False
    if _has_image_magic(content):
        return True
    return _image_content_type(content_type) is not None


def _photo_type_note(path: Path) -> Path:
    return path.with_name(path.name + ".type")


def _cached_photo_bytes_ok(path: Path, content: bytes) -> bool:
    if not content or _looks_like_html(content):
        return False
    if _has_image_magic(content):
        return True
    note = _photo_type_note(path)
    if not note.is_file():
        return False
    try:
        stored = note.read_text(encoding="utf-8")
    except OSError:
        return False
    return _image_content_type(stored) is not None


def _photo_cache_fresh(path: Path, ttl_hours: float) -> bool:
    ttl_seconds = ttl_hours * 3600.0
    if ttl_seconds <= 0 or not path.is_file():
        return False
    try:
        modified = path.stat().st_mtime
        content = path.read_bytes()
    except OSError:
        return False
    if (time.time() - modified) > ttl_seconds:
        return False
    return _cached_photo_bytes_ok(path, content)


def _store_photo_cache(path: Path, content: bytes, content_type: str | None) -> None:
    atomic_write_bytes(path, content)
    note = _photo_type_note(path)
    image_type = _image_content_type(content_type)
    if image_type and not _has_image_magic(content):
        atomic_write_text(note, image_type + "\n")
    elif note.is_file():
        note.unlink()


def _new_photo_client() -> httpx.Client:
    return httpx.Client(
        timeout=httpx.Timeout(
            connect=CONNECT_TIMEOUT_S,
            read=PHOTO_TIMEOUT_S,
            write=15.0,
            pool=15.0,
        ),
        follow_redirects=True,
    )


def _fetch_photo_bytes(client: httpx.Client, url: str) -> tuple[bytes, str | None]:
    validated_url = validate_photo_url(url)
    for attempt in range(1, PHOTO_ATTEMPTS + 1):
        try:
            with client.stream("GET", validated_url, headers={"User-Agent": USER_AGENT}) as resp:
                if resp.url is not None:
                    validate_photo_url(str(resp.url))
                if resp.status_code in TRANSIENT_STATUS_CODES:
                    if attempt < PHOTO_ATTEMPTS:
                        wait = _retry_delay_seconds(attempt, resp)
                        time.sleep(wait)
                        continue
                    resp.raise_for_status()
                resp.raise_for_status()
                content_type = resp.headers.get("content-type")
                content_encoding = resp.headers.get("content-encoding", "").strip().lower()
                raw_len = resp.headers.get("content-length", "").strip()
                expected_len: int | None = None
                if raw_len and (not content_encoding or content_encoding == "identity"):
                    try:
                        parsed_len = int(raw_len)
                        if parsed_len > 0:
                            expected_len = parsed_len
                    except ValueError:
                        expected_len = None
                chunks: list[bytes] = []
                received = 0
                for chunk in resp.iter_bytes():
                    if chunk:
                        chunks.append(chunk)
                        received += len(chunk)
            if expected_len is not None and received < expected_len:
                raise _IncompletePhotoError(
                    f"Incomplete photo download for {validated_url}: received {received} of {expected_len} bytes"
                )
            return b"".join(chunks), content_type
        except click.ClickException:
            raise
        except httpx.HTTPStatusError as exc:
            status = exc.response.status_code
            if status in TRANSIENT_STATUS_CODES and attempt < PHOTO_ATTEMPTS:
                time.sleep(_retry_delay_seconds(attempt, exc.response))
                continue
            raise click.ClickException(f"HTTP {status} downloading {validated_url}") from exc
        except (httpx.TimeoutException, httpx.TransportError, _IncompletePhotoError) as exc:
            if attempt < PHOTO_ATTEMPTS:
                time.sleep(_retry_delay_seconds(attempt, None))
                continue
            raise click.ClickException(
                f"Failed downloading {validated_url} after {PHOTO_ATTEMPTS} attempts: {exc}"
            ) from exc
    raise click.ClickException(f"Failed downloading {validated_url}")


@cli.command()
@click.argument("memorial_id")
@click.option(
    "-o",
    "--out",
    "--out-dir",
    "--output",
    "out",
    default=".",
    show_default=True,
    help="Directory to save photos into.",
)
@click.option("--type", "photo_type", default=None,
              help="Only download this photo type, e.g. Grave.")
@click.option("--prefix", default=None,
              help="Optional filename prefix, e.g. 'lincoln-abraham' -> '<prefix>_<photo-id>.jpg'.")
@click.option("--all", "all_types", is_flag=True,
              help="Download every photo type. This is the default when --type is omitted.")
@click.option("--metadata", "save_metadata", is_flag=True,
              help="Also write a sidecar JSON file with memorial and photo provenance.")
@click.option("--refresh", is_flag=True,
              help="Bypass local memorial and photo caches and re-download fresh files.")
@click.option("--cache-ttl-hours", type=float, default=None,
              help="Override cache TTL in hours for memorial JSON and photo files (default: 168 or $KINLOOM_FINDAGRAVE_CACHE_TTL_HOURS).")
@click.option("--json", "as_json", is_flag=True,
              help="Print memorial_id, files, and cache_hit instead of text lines.")
def photo(memorial_id, out, photo_type, all_types, prefix, save_metadata, refresh, cache_ttl_hours, as_json):
    """Download a memorial's photos (grave, portrait, family, other; alias: photos)."""
    if "\x00" in str(out):
        raise click.BadParameter(f"Invalid --out path: {out!r}")
    out_dir = Path(out)
    if ".." in out_dir.parts and not out_dir.is_absolute():
        raise click.ClickException(f"Unsafe output directory containing '..': {out_dir}")
    clean_id = validate_entity_id(memorial_id, "memorial id")
    stem_prefix = sanitize_prefix(prefix)
    ttl_hours = resolve_cache_ttl_hours(cache_ttl_hours)
    cache_root = get_cache_root()

    memorials, memorial_cache_hit = _load_or_fetch_memorials(
        [clean_id],
        cache_root=cache_root,
        ttl_hours=ttl_hours,
        refresh=refresh,
    )
    if not memorials:
        click.echo(f"No memorial found with id {clean_id}", err=True)
        raise SystemExit(1)
    memorial = memorials[0]
    photo_list = (memorial.get("photos") or {}).get("photos") or []
    if photo_type and not all_types:
        photo_list = [p for p in photo_list if p.get("type") == photo_type]
    if not photo_list:
        if as_json:
            click.echo(json.dumps({
                "memorial_id": clean_id,
                "files": [],
                "cache_hit": memorial_cache_hit,
            }, indent=2))
            return
        click.echo("No photos found.")
        return
    out_dir.mkdir(parents=True, exist_ok=True)
    photos_cache_dir = cache_root / "photos" / clean_id
    saved_items = []
    file_hits: list[bool] = []
    rejected = False
    client: httpx.Client | None = None
    try:
        for item in photo_list:
            url = validate_photo_url(item.get("path") or "")
            cache_filename = safe_photo_filename(item.get("id"), url)
            cached_path = resolve_safe_child(photos_cache_dir, cache_filename)
            dest = resolve_safe_child(out_dir, f"{stem_prefix}{cache_filename}")

            def copy_cached(from_cache: bool) -> int:
                atomic_copy_file(cached_path, dest)
                size = dest.stat().st_size
                if not as_json:
                    suffix_note = ", cached" if from_cache else ""
                    click.echo(f"{dest} ({size} bytes{suffix_note})")
                return size

            if not refresh and _photo_cache_fresh(cached_path, ttl_hours):
                size = copy_cached(True)
                from_cache = True
            else:
                lock_path = resolve_safe_child(
                    cache_root / "_locks", f"photo_{clean_id}_{cache_filename}.lock"
                )
                from_cache = False
                item_rejected = False
                with file_lock(lock_path):
                    if not refresh and _photo_cache_fresh(cached_path, ttl_hours):
                        from_cache = True
                    else:
                        if client is None:
                            client = _new_photo_client()
                        content, content_type = _fetch_photo_bytes(client, url)
                        if not _photo_bytes_accepted(content, content_type):
                            rejected = True
                            item_rejected = True
                            click.echo(
                                f"Rejected non-image body for photo {item.get('id') or url}",
                                err=True,
                            )
                            continue
                        _store_photo_cache(cached_path, content, content_type)
                if item_rejected or not cached_path.is_file():
                    continue
                size = copy_cached(from_cache)

            file_hits.append(from_cache)
            saved_items.append({
                "id": item.get("id"),
                "type": item.get("type"),
                "caption": item.get("caption"),
                "url": url,
                "file": dest.name,
                "bytes": size,
                "cache_hit": from_cache,
            })
    finally:
        if client is not None:
            client.close()
    metadata_path = None
    if save_metadata:
        meta_path = resolve_safe_child(out_dir, f"{stem_prefix}{clean_id}.metadata.json")
        meta_payload = {
            "memorial_id": str(memorial.get("id")),
            "name": primary_name(memorial),
            "url": memorial_url(str(memorial.get("id"))),
            "cemetery": fmt_cemetery(memorial.get("cemetery")),
            "plot": memorial.get("plot"),
            "photos": [
                {
                    "id": item["id"],
                    "type": item["type"],
                    "caption": item["caption"],
                    "url": item["url"],
                    "file": item["file"],
                }
                for item in saved_items
            ],
        }
        atomic_write_text(meta_path, json.dumps(meta_payload, indent=2) + "\n")
        metadata_path = str(meta_path)
        if not as_json:
            click.echo(f"{meta_path} (metadata)")
    cache_hit = memorial_cache_hit and not rejected and all(file_hits) and len(file_hits) == len(photo_list)
    if as_json:
        payload: dict[str, Any] = {
            "memorial_id": clean_id,
            "files": saved_items,
            "cache_hit": cache_hit,
        }
        if metadata_path is not None:
            payload["metadata_file"] = metadata_path
        click.echo(json.dumps(payload, indent=2))
    if rejected:
        raise SystemExit(1)


cli.add_command(photo, name="photos")


@cli.command()
@click.option("--first", "--first-name", "--given", "--given-name", "first_name", default=None)
@click.option("--last", "--last-name", "--surname", "last_name", default=None)
@click.option("--birth-year", "--birth", "--born", "birth_year", type=int, default=None)
@click.option("--death-year", "--death", "--died", "death_year", type=int, default=None)
def url(first_name, last_name, birth_year, death_year):
    """Print the website search URL for a name (open it in a browser)."""
    params = []
    if first_name:
        params.append(("firstname", first_name))
    if last_name:
        params.append(("lastname", last_name))
    if birth_year is not None:
        params.append(("birthyear", str(birth_year)))
    if death_year is not None:
        params.append(("deathyear", str(death_year)))
    base = f"{WEBSITE_BASE}/memorial/search"
    click.echo(f"{base}?{urlencode(params)}" if params else base)


def _exit_broken_pipe() -> None:
    try:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        os.close(devnull)
    except Exception:
        pass
    sys.exit(0)


if __name__ == "__main__":
    try:
        cli()
        sys.stdout.flush()
    except BrokenPipeError:
        _exit_broken_pipe()
