#!/usr/bin/env -S python3 -S
"""Internet Archive CLI: search items, inspect metadata, grep cached books, and fetch pages.

Uses Python 3.11+ standard library only with lazy network/XML/lock imports for fast
cache-hit startup (~50 ms) and zero external dependency installation.
All APIs are public and read-only.
"""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import json
import math
import os
from pathlib import Path
import re
import sys
import time
from typing import Iterator
from urllib.parse import quote, urlencode

BASE = "https://archive.org"
ADVANCED_SEARCH = f"{BASE}/advancedsearch.php"
FULLTEXT_SEARCH = f"{BASE}/services/search/beta/page_production/"
USER_AGENT = "kinloom archive-org skill (research use)"
DEFAULT_FIELDS = ["identifier", "title", "creator", "date", "mediatype"]
DEFAULT_TIMEOUT = 25.0
SEARCH_TIMEOUT = 45.0
DOWNLOAD_TIMEOUT = 60.0
DEFAULT_QUERY_TTL_HOURS = 168.0
MAX_WORKERS = 6
PAGE_BATCH_LIMIT = 25
PAGE_BATCH_WORKERS = 4
RETRYABLE_HTTP_CODES = frozenset({429, 500, 502, 503, 504})
MAX_HTTP_RETRIES = 2
MAX_RETRY_AFTER_SECONDS = 5.0
SAFE_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp"}


def get_cache_root() -> Path:
    override = os.environ.get("KINLOOM_IA_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-ia"


def resolve_query_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            fail(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).", code=2)
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_IA_QUERY_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError:
            fail(f"Invalid KINLOOM_IA_QUERY_TTL_HOURS value: {raw!r}.", code=2)
        if not math.isfinite(parsed) or parsed < 0:
            fail(f"Invalid KINLOOM_IA_QUERY_TTL_HOURS value: {raw!r} (must be >= 0).", code=2)
        return parsed
    return DEFAULT_QUERY_TTL_HOURS


def validate_identifier(identifier: str) -> str:
    cleaned = identifier.strip()
    if not cleaned or not SAFE_ID_RE.match(cleaned) or cleaned in (".", ".."):
        fail(f"Invalid Internet Archive identifier: {identifier!r}")
    return cleaned


def validate_relative_item_path(name: str, files_root: Path) -> tuple[Path, Path]:
    """Validate an item-relative filename and resolve it strictly inside files_root."""
    if not name or "\x00" in name or "\\" in name or name.startswith("/"):
        raise ValueError(f"Unsafe file path in item: {name!r}")
    parts = name.split("/")
    for part in parts:
        if not part or part in (".", "..") or ":" in part:
            raise ValueError(f"Unsafe file path in item: {name!r}")
    rel = Path(*parts)
    root_resolved = files_root.resolve()
    dest = (root_resolved / rel).resolve()
    if dest == root_resolved or not dest.is_relative_to(root_resolved):
        raise ValueError(f"Unsafe file path in item: {name!r}")
    return rel, dest


def fail(message: str, code: int = 1) -> None:
    sys.stderr.write(f"{message}\n")
    raise SystemExit(code)


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive file lock (POSIX flock) with safe fallback on non-POSIX."""
    try:
        import fcntl
    except ImportError:
        yield
        return

    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def read_json_if_valid(path: Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return parsed if isinstance(parsed, dict) else None


def atomic_write_bytes(dest: Path, data: bytes) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
    except Exception:
        if tmp.exists():
            tmp.unlink(missing_ok=True)
        raise


def atomic_write_text(dest: Path, text: str) -> None:
    atomic_write_bytes(dest, text.encode("utf-8"))


def atomic_write_json(dest: Path, payload: object) -> None:
    atomic_write_text(dest, json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def parse_retry_after_seconds(headers: object, attempt: int) -> float:
    default_delay = min(MAX_RETRY_AFTER_SECONDS, 0.5 * (2**attempt))
    if headers is None or not hasattr(headers, "get"):
        return default_delay
    raw = headers.get("Retry-After")
    if raw is None:
        return default_delay
    raw_str = str(raw).strip()
    if not raw_str:
        return default_delay
    try:
        parsed = float(raw_str)
    except ValueError:
        try:
            from datetime import timezone
            from email.utils import parsedate_to_datetime

            dt = parsedate_to_datetime(raw_str)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            parsed = max(0.0, dt.timestamp() - time.time())
        except Exception:
            return default_delay
    if not math.isfinite(parsed) or parsed < 0:
        return default_delay
    return min(MAX_RETRY_AFTER_SECONDS, parsed)


def http_get_bytes(url: str, timeout: float = DEFAULT_TIMEOUT) -> bytes:
    from http.client import HTTPException, IncompleteRead, RemoteDisconnected
    from urllib.error import HTTPError, URLError
    from urllib.request import Request, urlopen

    req = Request(url, headers={"User-Agent": USER_AGENT})
    for attempt in range(MAX_HTTP_RETRIES + 1):
        try:
            with urlopen(req, timeout=timeout) as resp:
                return resp.read()
        except HTTPError as exc:
            code = exc.code
            headers = exc.headers
            try:
                exc.close()
            except Exception:
                pass
            if code == 403:
                raise RuntimeError(
                    f"HTTP 403 from {url}. This item may be access-restricted or borrow-only."
                ) from exc
            if code == 404:
                raise FileNotFoundError(f"HTTP 404 from {url}") from exc
            if code in RETRYABLE_HTTP_CODES and attempt < MAX_HTTP_RETRIES:
                time.sleep(parse_retry_after_seconds(headers, attempt))
                continue
            raise RuntimeError(f"HTTP {code} from {url}") from exc
        except (IncompleteRead, RemoteDisconnected) as exc:
            if attempt < MAX_HTTP_RETRIES:
                time.sleep(parse_retry_after_seconds(None, attempt))
                continue
            raise RuntimeError(f"Incomplete response from {url}: {exc}") from exc
        except HTTPException as exc:
            raise RuntimeError(f"HTTP protocol error for {url}: {exc}") from exc
        except (URLError, TimeoutError, OSError) as exc:
            # Stay fail-fast on ReadTimeout and socket/connection errors.
            raise RuntimeError(f"Request failed for {url}: {exc}") from exc
    raise RuntimeError(f"Request failed for {url}")


def http_get_json(url: str, timeout: float = DEFAULT_TIMEOUT) -> dict:
    raw = http_get_bytes(url, timeout=timeout)
    try:
        data = json.loads(raw.decode("utf-8", errors="replace"))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Invalid JSON response from {url}: {exc}") from exc
    if not isinstance(data, dict):
        raise RuntimeError(f"Expected JSON object from {url}")
    return data


def query_cache_path(kind: str, canonical_params: dict, cache_root: Path) -> tuple[str, Path]:
    import hashlib

    canonical = json.dumps(canonical_params, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    return digest, cache_root / "_queries" / kind / f"{digest}.json"


def cached_query_json(
    kind: str,
    canonical_params: dict,
    url: str,
    *,
    cache_root: Path | None = None,
    ttl_hours: float = DEFAULT_QUERY_TTL_HOURS,
    refresh: bool = False,
    timeout: float = SEARCH_TIMEOUT,
) -> tuple[dict, bool]:
    root = cache_root if cache_root is not None else get_cache_root()
    digest, cache_path = query_cache_path(kind, canonical_params, root)
    ttl_seconds = ttl_hours * 3600.0

    def read_fresh() -> dict | None:
        if refresh or ttl_seconds <= 0:
            return None
        envelope = read_json_if_valid(cache_path)
        if envelope is None:
            return None
        cached_at = envelope.get("cached_at")
        data = envelope.get("data")
        if not isinstance(cached_at, (int, float)) or not isinstance(data, dict):
            return None
        if (time.time() - float(cached_at)) <= ttl_seconds:
            return data
        return None

    cached = read_fresh()
    if cached is not None:
        return cached, True

    lock_path = root / "_queries" / "_locks" / f"{kind}_{digest}.lock"
    with file_lock(lock_path):
        cached = read_fresh()
        if cached is not None:
            return cached, True
        data = http_get_json(url, timeout=timeout)
        atomic_write_json(
            cache_path,
            {"cached_at": time.time(), "params": canonical_params, "data": data},
        )
        return data, False


def fulltext_api(
    query: str,
    rows: int,
    page: int,
    *,
    cache_root: Path | None = None,
    ttl_hours: float = DEFAULT_QUERY_TTL_HOURS,
    refresh: bool = False,
) -> tuple[dict, bool]:
    qs = urlencode(
        [
            ("user_query", query),
            ("service_backend", "fts"),
            ("hits_per_page", str(rows)),
            ("page", str(page)),
        ]
    )
    canonical_params = {
        "kind": "fulltext",
        "query": query,
        "rows": rows,
        "page": page,
    }
    try:
        return cached_query_json(
            "fulltext",
            canonical_params,
            f"{FULLTEXT_SEARCH}?{qs}",
            cache_root=cache_root,
            ttl_hours=ttl_hours,
            refresh=refresh,
            timeout=SEARCH_TIMEOUT,
        )
    except (RuntimeError, FileNotFoundError) as exc:
        fail(str(exc))
    return {}, False


def search_api(
    query: str,
    fields: list[str],
    rows: int,
    page: int,
    sorts: list[str],
    *,
    cache_root: Path | None = None,
    ttl_hours: float = DEFAULT_QUERY_TTL_HOURS,
    refresh: bool = False,
) -> tuple[dict, bool]:
    params: list[tuple[str, str]] = [
        ("q", query),
        ("output", "json"),
        ("rows", str(rows)),
    ]
    if page > 1:
        params.append(("page", str(page)))
    for field in fields:
        params.append(("fl[]", field))
    for sort in sorts:
        params.append(("sort[]", sort))
    qs = urlencode(params)
    canonical_params = {
        "kind": "search",
        "query": query,
        "fields": list(fields),
        "rows": rows,
        "page": page,
        "sorts": list(sorts),
    }
    try:
        return cached_query_json(
            "search",
            canonical_params,
            f"{ADVANCED_SEARCH}?{qs}",
            cache_root=cache_root,
            ttl_hours=ttl_hours,
            refresh=refresh,
            timeout=SEARCH_TIMEOUT,
        )
    except (RuntimeError, FileNotFoundError) as exc:
        fail(str(exc))
    return {}, False


def _is_valid_metadata(data: dict | None) -> bool:
    return bool(data and (data.get("metadata") or data.get("files")))


def _load_or_fetch_metadata_unlocked(
    item_id: str,
    meta_path: Path,
    *,
    timeout: float = DEFAULT_TIMEOUT,
    refresh: bool = False,
) -> tuple[dict, bool]:
    if not refresh:
        cached = read_json_if_valid(meta_path)
        if _is_valid_metadata(cached):
            assert cached is not None
            return cached, True
    url = f"{BASE}/metadata/{quote(item_id)}"
    data = http_get_json(url, timeout=timeout)
    if not _is_valid_metadata(data):
        raise FileNotFoundError(f"No item with identifier {item_id}")
    atomic_write_json(meta_path, data)
    return data, False


def ensure_item_metadata(
    identifier: str,
    *,
    cache_root: Path | None = None,
    timeout: float = DEFAULT_TIMEOUT,
    refresh: bool = False,
) -> tuple[dict, bool]:
    """Return cached or freshly fetched /metadata/<id> JSON and cache-hit flag."""
    item_id = validate_identifier(identifier)
    root = cache_root if cache_root is not None else get_cache_root()
    item_dir = root / item_id
    meta_path = item_dir / "metadata.json"

    if not refresh:
        cached = read_json_if_valid(meta_path)
        if _is_valid_metadata(cached):
            assert cached is not None
            return cached, True

    with file_lock(item_dir / ".lock"):
        return _load_or_fetch_metadata_unlocked(
            item_id, meta_path, timeout=timeout, refresh=refresh
        )


def metadata_api(
    identifier: str,
    timeout: float = DEFAULT_TIMEOUT,
    *,
    cache_root: Path | None = None,
    refresh: bool = False,
) -> tuple[dict, bool]:
    try:
        return ensure_item_metadata(
            identifier, cache_root=cache_root, timeout=timeout, refresh=refresh
        )
    except FileNotFoundError:
        fail(f"No item with identifier {identifier}")
    except RuntimeError as exc:
        fail(str(exc))
    return {}, False


def item_url(identifier: str) -> str:
    return f"{BASE}/details/{quote(identifier)}"


def page_image_url(identifier: str, leaf_n: int, *, scale: int | None = None, width: int | None = None) -> str:
    if width is not None:
        return f"{BASE}/download/{quote(identifier)}/page/n{leaf_n}_w{width}.jpg"
    effective_scale = scale if scale is not None else 2
    return f"{BASE}/download/{quote(identifier)}/page/n{leaf_n}_s{effective_scale}.jpg"


def page_details_url(identifier: str, leaf_n: int) -> str:
    return f"{BASE}/details/{quote(identifier)}/page/n{leaf_n}"


def short(text: object, limit: int = 300) -> str:
    if not text:
        return ""
    cleaned = " ".join(str(text).split())
    if len(cleaned) <= limit:
        return cleaned
    return cleaned[:limit].rstrip() + " ..."


def find_item_file(files: list[dict], *, suffixes: tuple[str, ...], formats: tuple[str, ...] = ()) -> str | None:
    lower_suffixes = tuple(suf.lower() for suf in suffixes)
    for entry in files:
        name = entry.get("name") or ""
        if any(name.lower().endswith(suf) for suf in lower_suffixes):
            return str(name)
    if formats:
        fmt_set = {f.lower() for f in formats}
        for entry in files:
            fmt = str(entry.get("format") or "").lower()
            name = entry.get("name") or ""
            if fmt in fmt_set and name:
                return str(name)
    return None


def parse_scandata_xml(xml_bytes: bytes) -> dict:
    """Parse scandata.xml into compact bidirectional leaf/page lookup tables.

    Internet Archive BookReader `/page/n<N>` indexes 0-based over leaves with
    `addToAccessFormats == true` (excluding deleted leaves). Storing both raw
    `leafNum` and BookReader `n` eliminates off-by-one page offset bugs.
    """
    import xml.etree.ElementTree as ET

    root = ET.fromstring(xml_bytes)
    if root.find(".//pageData") is None:
        raise ValueError("scandata.xml is missing <pageData>.")
    pages = root.findall(".//pageData/page")
    scandata_to_bookreader: dict[str, int] = {}
    bookreader_to_scandata: dict[str, int] = {}
    scandata_to_printed: dict[str, str] = {}
    bookreader_to_printed: dict[str, str] = {}
    printed_to_bookreader: dict[str, int] = {}
    printed_to_bookreader_ci: dict[str, int] = {}
    printed_to_scandata: dict[str, int] = {}

    access_idx = 0
    for seq_idx, page_el in enumerate(pages):
        raw_leaf = page_el.attrib.get("leafNum")
        try:
            leaf_num = int(raw_leaf) if raw_leaf is not None else seq_idx
        except ValueError:
            leaf_num = seq_idx
        page_type = (page_el.findtext("pageType") or "").strip()
        add_access_raw = page_el.findtext("addToAccessFormats")
        if add_access_raw is not None:
            in_access = add_access_raw.strip().lower() == "true"
        else:
            in_access = page_type.lower() != "delete"

        printed = (page_el.findtext("pageNumber") or "").strip()
        leaf_key = str(leaf_num)
        if printed:
            scandata_to_printed[leaf_key] = printed
            printed_to_scandata.setdefault(printed, leaf_num)

        if in_access:
            br_n = access_idx
            access_idx += 1
            scandata_to_bookreader[leaf_key] = br_n
            bookreader_to_scandata[str(br_n)] = leaf_num
            if printed:
                bookreader_to_printed[str(br_n)] = printed
                printed_to_bookreader.setdefault(printed, br_n)
                printed_to_bookreader_ci.setdefault(printed.lower(), br_n)

    return {
        "leaf_count": len(pages),
        "access_leaf_count": access_idx,
        "scandata_to_bookreader": scandata_to_bookreader,
        "bookreader_to_scandata": bookreader_to_scandata,
        "scandata_to_printed": scandata_to_printed,
        "bookreader_to_printed": bookreader_to_printed,
        "printed_to_bookreader": printed_to_bookreader,
        "printed_to_bookreader_ci": printed_to_bookreader_ci,
        "printed_to_scandata": printed_to_scandata,
        "segment_mode": "scandata",
    }


def empty_page_index() -> dict:
    return {
        "leaf_count": 0,
        "access_leaf_count": 0,
        "scandata_to_bookreader": {},
        "bookreader_to_scandata": {},
        "scandata_to_printed": {},
        "bookreader_to_printed": {},
        "printed_to_bookreader": {},
        "printed_to_bookreader_ci": {},
        "printed_to_scandata": {},
        "segment_mode": "bookreader",
    }


def _maybe_gunzip(raw: bytes) -> bytes:
    if raw.startswith(b"\x1f\x8b"):
        import gzip

        return gzip.decompress(raw)
    return raw


def synthesize_djvu_from_hocr(searchtext_gz: bytes, pageindex_gz: bytes) -> str:
    text = _maybe_gunzip(searchtext_gz).decode("utf-8", errors="replace")
    offsets = json.loads(_maybe_gunzip(pageindex_gz).decode("utf-8", errors="replace"))
    if not isinstance(offsets, list) or not offsets:
        return text
    segments: list[str] = []
    text_len = len(text)
    for row in offsets:
        if isinstance(row, list) and len(row) >= 2:
            start = max(0, min(int(row[0]), text_len))
            end = max(start, min(int(row[1]), text_len))
            segments.append(text[start:end].replace("\x0c", " "))
        else:
            segments.append("")
    return "\x0c".join(segments)


def _fetch_urls_map(
    tasks: dict[str, str], timeout: float
) -> tuple[dict[str, bytes], dict[str, Exception]]:
    fetched: dict[str, bytes] = {}
    fetch_errors: dict[str, Exception] = {}
    if not tasks:
        return fetched, fetch_errors
    if len(tasks) == 1:
        key, url = next(iter(tasks.items()))
        try:
            fetched[key] = http_get_bytes(url, timeout=timeout)
        except Exception as exc:
            fetch_errors[key] = exc
        return fetched, fetch_errors

    from concurrent.futures import ThreadPoolExecutor

    with ThreadPoolExecutor(max_workers=min(MAX_WORKERS, len(tasks))) as pool:
        future_map = {
            key: pool.submit(http_get_bytes, url, timeout) for key, url in tasks.items()
        }
        for key, fut in future_map.items():
            try:
                fetched[key] = fut.result()
            except Exception as exc:
                fetch_errors[key] = exc
    return fetched, fetch_errors


def ensure_item_cache(
    identifier: str,
    *,
    need_djvu: bool,
    cache_root: Path | None = None,
    timeout: float = DEFAULT_TIMEOUT,
    refresh: bool = False,
) -> dict:
    """Populate and return cached metadata, page_index, and optional djvu.txt."""
    item_id = validate_identifier(identifier)
    root = cache_root if cache_root is not None else get_cache_root()
    item_dir = root / item_id
    meta_path = item_dir / "metadata.json"
    scandata_path = item_dir / "scandata.xml"
    page_index_path = item_dir / "page_index.json"
    djvu_path = item_dir / "djvu.txt"

    def cache_ready() -> bool:
        return (
            not refresh
            and _is_valid_metadata(read_json_if_valid(meta_path))
            and read_json_if_valid(page_index_path) is not None
            and (not need_djvu or djvu_path.is_file())
        )

    if cache_ready():
        return {
            "identifier": item_id,
            "item_dir": item_dir,
            "metadata_path": meta_path,
            "scandata_path": scandata_path,
            "page_index_path": page_index_path,
            "djvu_path": djvu_path,
            "cached": True,
        }

    with file_lock(item_dir / ".lock"):
        if cache_ready():
            return {
                "identifier": item_id,
                "item_dir": item_dir,
                "metadata_path": meta_path,
                "scandata_path": scandata_path,
                "page_index_path": page_index_path,
                "djvu_path": djvu_path,
                "cached": True,
            }

        meta_data, _ = _load_or_fetch_metadata_unlocked(
            item_id, meta_path, timeout=timeout, refresh=refresh
        )
        existing_page_index = None if refresh else read_json_if_valid(page_index_path)
        has_page_index = existing_page_index is not None
        has_djvu = (not refresh) and djvu_path.is_file()

        files = meta_data.get("files") or []
        scandata_name = find_item_file(
            files, suffixes=("_scandata.xml", "scandata.xml"), formats=("scandata",)
        )
        djvu_name = find_item_file(files, suffixes=("_djvu.txt",), formats=("djvutxt",))
        hocr_text_name = find_item_file(
            files, suffixes=("_hocr_searchtext.txt.gz",), formats=("ocr search text",)
        )
        hocr_idx_name = find_item_file(
            files, suffixes=("_hocr_pageindex.json.gz",), formats=("ocr page index",)
        )

        # Stage 1: fetch scandata and _djvu.txt first. Only fetch hOCR immediately when
        # _djvu.txt is absent, avoiding eager triple-downloads on healthy items.
        stage1_tasks: dict[str, str] = {}
        if not has_page_index and scandata_name and (refresh or not scandata_path.is_file()):
            stage1_tasks["scandata"] = f"{BASE}/download/{quote(item_id)}/{quote(scandata_name)}"
        if need_djvu and not has_djvu:
            if djvu_name:
                stage1_tasks["djvu"] = f"{BASE}/download/{quote(item_id)}/{quote(djvu_name)}"
            elif hocr_text_name and hocr_idx_name:
                stage1_tasks["hocr_text"] = f"{BASE}/download/{quote(item_id)}/{quote(hocr_text_name)}"
                stage1_tasks["hocr_idx"] = f"{BASE}/download/{quote(item_id)}/{quote(hocr_idx_name)}"

        fetched, fetch_errors = _fetch_urls_map(stage1_tasks, timeout=timeout)

        page_index: dict
        if has_page_index:
            assert existing_page_index is not None
            page_index = existing_page_index
        else:
            scandata_bytes = fetched.get("scandata")
            if scandata_bytes is None and not refresh and scandata_path.is_file():
                scandata_bytes = scandata_path.read_bytes()
            if scandata_bytes is not None:
                try:
                    page_index = parse_scandata_xml(scandata_bytes)
                except Exception:
                    page_index = empty_page_index()
                else:
                    atomic_write_bytes(scandata_path, scandata_bytes)
            else:
                page_index = empty_page_index()

        if need_djvu and not has_djvu:
            djvu_raw = fetched.get("djvu")
            decoded_djvu = djvu_raw.decode("utf-8", errors="replace") if djvu_raw is not None else None
            has_form_feeds = decoded_djvu is not None and "\x0c" in decoded_djvu

            # Stage 2 fallback: fetch hOCR pair only when _djvu.txt failed or lacked \x0c breaks.
            if not has_form_feeds and hocr_text_name and hocr_idx_name:
                hocr_tasks: dict[str, str] = {}
                if "hocr_text" not in fetched:
                    hocr_tasks["hocr_text"] = f"{BASE}/download/{quote(item_id)}/{quote(hocr_text_name)}"
                if "hocr_idx" not in fetched:
                    hocr_tasks["hocr_idx"] = f"{BASE}/download/{quote(item_id)}/{quote(hocr_idx_name)}"
                if hocr_tasks:
                    hocr_fetched, hocr_errors = _fetch_urls_map(hocr_tasks, timeout=timeout)
                    fetched.update(hocr_fetched)
                    fetch_errors.update(hocr_errors)

            djvu_bytes_out: bytes | None = None
            djvu_source: str | None = None
            segment_mode = page_index.get("segment_mode", "scandata")

            if has_form_feeds and djvu_raw is not None and decoded_djvu is not None:
                djvu_bytes_out = djvu_raw
                djvu_source = "djvu_txt"
                seg_count = decoded_djvu.count("\x0c") + 1
                access_count = int(page_index.get("access_leaf_count") or 0)
                leaf_count = int(page_index.get("leaf_count") or 0)
                if access_count and abs(seg_count - access_count) < abs(seg_count - leaf_count):
                    segment_mode = "bookreader"
                else:
                    segment_mode = "scandata"
            elif "hocr_text" in fetched and "hocr_idx" in fetched:
                try:
                    djvu_bytes_out = synthesize_djvu_from_hocr(
                        fetched["hocr_text"], fetched["hocr_idx"]
                    ).encode("utf-8")
                    djvu_source = "hocr"
                    segment_mode = "scandata"
                except (OSError, EOFError, ValueError, json.JSONDecodeError) as exc:
                    fetch_errors["hocr"] = exc

            if djvu_bytes_out is None and djvu_raw is not None:
                djvu_bytes_out = djvu_raw
                djvu_source = "djvu_txt"
                segment_mode = "flat"

            if djvu_bytes_out is None:
                err_detail = "; ".join(f"{k}: {v}" for k, v in fetch_errors.items())
                raise RuntimeError(
                    f"Item {item_id} has no downloadable OCR text (_djvu.txt or _hocr_searchtext.txt.gz)"
                    + (f" ({err_detail})" if err_detail else "")
                )
            page_index["segment_mode"] = segment_mode
            if djvu_source is not None:
                page_index["djvu_source"] = djvu_source
            atomic_write_bytes(djvu_path, djvu_bytes_out)
            atomic_write_json(page_index_path, page_index)
        elif not has_page_index:
            atomic_write_json(page_index_path, page_index)

    return {
        "identifier": item_id,
        "item_dir": item_dir,
        "metadata_path": meta_path,
        "scandata_path": scandata_path,
        "page_index_path": page_index_path,
        "djvu_path": djvu_path,
        "cached": False,
    }


def _reuse_existing_item_artifact(
    item_dir: Path,
    file_name: str,
    file_list: list[dict],
    file_entry: dict,
) -> bytes | None:
    """Reuse scandata.xml or djvu.txt from item cache when it matches the raw file."""
    scandata_name = find_item_file(
        file_list, suffixes=("_scandata.xml", "scandata.xml"), formats=("scandata",)
    )
    scandata_path = item_dir / "scandata.xml"
    if scandata_name and file_name == scandata_name and scandata_path.is_file():
        return scandata_path.read_bytes()

    djvu_name = find_item_file(file_list, suffixes=("_djvu.txt",), formats=("djvutxt",))
    djvu_path = item_dir / "djvu.txt"
    if djvu_name and file_name == djvu_name and djvu_path.is_file():
        page_index = read_json_if_valid(item_dir / "page_index.json") or {}
        djvu_source = page_index.get("djvu_source")
        if djvu_source == "djvu_txt":
            return djvu_path.read_bytes()
        if djvu_source is None:
            raw_size = file_entry.get("size")
            if raw_size is not None:
                try:
                    if djvu_path.stat().st_size == int(raw_size):
                        return djvu_path.read_bytes()
                except (ValueError, OSError):
                    pass
            elif not find_item_file(
                file_list, suffixes=("_hocr_searchtext.txt.gz",), formats=("ocr search text",)
            ):
                return djvu_path.read_bytes()
    return None


def ensure_downloaded_file(
    identifier: str,
    file_name: str,
    file_list: list[dict],
    file_entry: dict,
    *,
    cache_root: Path | None = None,
    timeout: float = DOWNLOAD_TIMEOUT,
    refresh: bool = False,
) -> tuple[bytes, Path, bool]:
    """Return file bytes, cache path, and cache-hit flag for an item file."""
    item_id = validate_identifier(identifier)
    root = cache_root if cache_root is not None else get_cache_root()
    item_dir = root / item_id
    files_root = item_dir / "files"
    _, cache_path = validate_relative_item_path(file_name, files_root)

    if not refresh:
        if cache_path.is_file():
            return cache_path.read_bytes(), cache_path, True
        reused = _reuse_existing_item_artifact(item_dir, file_name, file_list, file_entry)
        if reused is not None:
            return reused, item_dir, True

    with file_lock(item_dir / ".lock"):
        if not refresh:
            if cache_path.is_file():
                return cache_path.read_bytes(), cache_path, True
            reused = _reuse_existing_item_artifact(item_dir, file_name, file_list, file_entry)
            if reused is not None:
                return reused, item_dir, True

        url = f"{BASE}/download/{quote(item_id)}/{quote(file_name)}"
        content = http_get_bytes(url, timeout=timeout)
        atomic_write_bytes(cache_path, content)
        return content, cache_path, False


def ensure_page_image_cache(
    identifier: str,
    leaf_n: int,
    suffix_tag: str,
    url: str,
    *,
    cache_root: Path | None = None,
    timeout: float = DEFAULT_TIMEOUT,
    refresh: bool = False,
) -> tuple[bytes, Path, bool]:
    """Return rendered page JPEG bytes, cache path, and cache-hit flag."""
    item_id = validate_identifier(identifier)
    root = cache_root if cache_root is not None else get_cache_root()
    item_dir = root / item_id
    page_cache_path = item_dir / "pages" / f"n{leaf_n}_{suffix_tag}.jpg"

    if not refresh and page_cache_path.is_file() and page_cache_path.stat().st_size > 0:
        return page_cache_path.read_bytes(), page_cache_path, True

    # One lock per JPEG so different leaves download together. The same leaf still waits.
    page_lock = page_cache_path.with_name(f".{page_cache_path.name}.lock")
    with file_lock(page_lock):
        if not refresh and page_cache_path.is_file() and page_cache_path.stat().st_size > 0:
            return page_cache_path.read_bytes(), page_cache_path, True
        content = http_get_bytes(url, timeout=timeout)
        atomic_write_bytes(page_cache_path, content)
        return content, page_cache_path, False


def resolve_segment_page(seg_idx: int, page_index: dict) -> tuple[int | None, int | None, str | None]:
    """Map a 0-based `\x0c` segment index to (bookreader_leaf_n, scandata_leaf, printed_page)."""
    mode = page_index.get("segment_mode", "scandata")
    if mode == "flat":
        return None, None, None
    key = str(seg_idx)
    if mode == "bookreader":
        scandata_leaf = page_index.get("bookreader_to_scandata", {}).get(key)
        printed = page_index.get("bookreader_to_printed", {}).get(key)
        return seg_idx, scandata_leaf, printed
    # scandata leaf indexing (e.g. hocr_pageindex or full-leaf djvu.txt)
    scandata_to_br = page_index.get("scandata_to_bookreader", {})
    br_n = scandata_to_br.get(key)
    if br_n is None and not scandata_to_br:
        br_n = seg_idx
    printed = page_index.get("scandata_to_printed", {}).get(key)
    return br_n, seg_idx, printed


def extract_snippet(page_text: str, match_start: int, match_end: int, context_chars: int) -> str:
    half = max(20, context_chars // 2)
    start = max(0, match_start - half)
    end = min(len(page_text), match_end + half)
    raw = page_text[start:end]
    cleaned = " ".join(raw.split())
    if start > 0:
        cleaned = "..." + cleaned
    if end < len(page_text):
        cleaned = cleaned + "..."
    return cleaned


def grep_cached_item(
    identifier: str,
    djvu_text: str,
    page_index: dict,
    compiled: re.Pattern[str],
    *,
    context_chars: int,
    limit: int,
) -> tuple[list[dict], int]:
    """Search cached page-delimited text line by line without DOTALL backtracking."""
    hits: list[dict] = []
    total_matches = 0
    pages = djvu_text.split("\x0c")

    for seg_idx, page_text in enumerate(pages):
        if not page_text or not compiled.search(page_text):
            continue
        # Search line by line on matching pages so multi-line DOTALL backtracking cannot happen.
        offset = 0
        for line in page_text.splitlines(keepends=True):
            for match in compiled.finditer(line):
                if match.end() == match.start():
                    continue
                total_matches += 1
                if len(hits) < limit:
                    leaf_n, scandata_leaf, printed_page = resolve_segment_page(seg_idx, page_index)
                    m_start = offset + match.start()
                    m_end = offset + match.end()
                    hits.append(
                        {
                            "identifier": identifier,
                            "leaf": leaf_n,
                            "scandata_leaf": scandata_leaf,
                            "printed_page": printed_page,
                            "match": match.group(0),
                            "snippet": extract_snippet(page_text, m_start, m_end, context_chars),
                            "image_url": page_image_url(identifier, leaf_n, scale=2)
                            if leaf_n is not None
                            else None,
                            "details_url": page_details_url(identifier, leaf_n)
                            if leaf_n is not None
                            else item_url(identifier),
                        }
                    )
            offset += len(line)
    return hits, total_matches


def resolve_printed_page_to_leaf(page_index: dict, printed_page: str) -> tuple[int, int | None]:
    target = printed_page.strip()
    p2b = page_index.get("printed_to_bookreader") or {}
    if target in p2b:
        br_n = int(p2b[target])
        sc_leaf = page_index.get("bookreader_to_scandata", {}).get(str(br_n))
        return br_n, sc_leaf
    p2b_ci = page_index.get("printed_to_bookreader_ci") or {}
    lower = target.lower()
    if lower in p2b_ci:
        br_n = int(p2b_ci[lower])
        sc_leaf = page_index.get("bookreader_to_scandata", {}).get(str(br_n))
        return br_n, sc_leaf
    # Fallback to scandata_to_printed when access mapping is absent
    p2s = page_index.get("printed_to_scandata") or {}
    if target in p2s:
        sc_leaf = int(p2s[target])
        return sc_leaf, sc_leaf
    sample_pages = list(p2b.keys())
    hint = (
        f" (known printed pages: {sample_pages[0]}..{sample_pages[-1]}, total {len(sample_pages)})"
        if sample_pages
        else " (no printed page numbers in scandata.xml)"
    )
    raise KeyError(f"Printed page {printed_page!r} not found in page_index.json{hint}")


def describe_leaf(page_index: dict, leaf_n: int) -> dict:
    """Return BookReader leaf, scandata leaf, and printed page for one BookReader leaf."""
    key = str(leaf_n)
    scandata_leaf = page_index.get("bookreader_to_scandata", {}).get(key)
    printed = page_index.get("bookreader_to_printed", {}).get(key)
    return {"leaf": leaf_n, "scandata_leaf": scandata_leaf, "printed_page": printed}


def validate_leaf_in_index(page_index: dict, leaf_n: int) -> None:
    if leaf_n < 0:
        raise ValueError(f"Leaf index must be >= 0, got {leaf_n}.")
    access_count = int(page_index.get("access_leaf_count") or 0)
    if access_count and leaf_n >= access_count:
        raise ValueError(
            f"Leaf n{leaf_n} is out of range (item has {access_count} BookReader leaves: n0..n{access_count - 1})."
        )


def leaf_from_scandata_leaf(page_index: dict, scandata_leaf: int) -> int:
    s2b = page_index.get("scandata_to_bookreader") or {}
    if str(scandata_leaf) in s2b:
        return int(s2b[str(scandata_leaf)])
    if not s2b:
        raise KeyError(f"Scandata leaf {scandata_leaf} cannot be resolved (no scandata.xml mapping cached).")
    raise KeyError(f"Scandata leaf {scandata_leaf} is not an access leaf (deleted or unknown) in page_index.json.")


def segment_for_leaf(page_index: dict, leaf_n: int, scandata_leaf: int | None) -> int | None:
    """Map a BookReader leaf to its 0-based `\\x0c` segment index in cached djvu.txt."""
    mode = page_index.get("segment_mode", "scandata")
    if mode == "flat":
        return None
    if mode == "bookreader":
        return leaf_n
    if scandata_leaf is not None:
        return int(scandata_leaf)
    if not page_index.get("scandata_to_bookreader"):
        return leaf_n
    return None


def parse_printed_range(page_index: dict, spec: str) -> list[int]:
    """Resolve a printed page range `p1-p2` (or a single label) to inclusive BookReader leaves."""
    cleaned = spec.strip()
    if not cleaned:
        raise ValueError("Empty --pages range.")
    try:
        leaf, _ = resolve_printed_page_to_leaf(page_index, cleaned)
        return [leaf]
    except KeyError:
        pass
    if "-" not in cleaned:
        leaf, _ = resolve_printed_page_to_leaf(page_index, cleaned)
        return [leaf]
    start_label, _, end_label = cleaned.partition("-")
    if not start_label.strip() or not end_label.strip():
        raise ValueError(f"Invalid --pages range {spec!r}; expected <p1>-<p2>.")
    start_leaf, _ = resolve_printed_page_to_leaf(page_index, start_label)
    end_leaf, _ = resolve_printed_page_to_leaf(page_index, end_label)
    if end_leaf < start_leaf:
        raise ValueError(
            f"Invalid --pages range {spec!r}: printed page {end_label.strip()!r} (n{end_leaf}) precedes "
            f"{start_label.strip()!r} (n{start_leaf})."
        )
    return list(range(start_leaf, end_leaf + 1))


def cmd_text(args: argparse.Namespace) -> int:
    identifier = validate_identifier(args.identifier)
    selectors = [s for s in (args.printed_page, args.leaf, args.pages) if s is not None]
    if len(selectors) != 1:
        fail("Pass exactly one of --printed-page <p>, --leaf <n>, or --pages <p1-p2>.", code=2)

    try:
        cache_entry = ensure_item_cache(
            identifier,
            need_djvu=True,
            cache_root=get_cache_root(),
            timeout=args.timeout,
            refresh=args.refresh,
        )
        page_index = json.loads(cache_entry["page_index_path"].read_text(encoding="utf-8"))
        djvu_text = cache_entry["djvu_path"].read_text(encoding="utf-8", errors="replace")
    except Exception as exc:
        fail(str(exc))

    try:
        if args.printed_page is not None:
            leaf, _ = resolve_printed_page_to_leaf(page_index, args.printed_page)
            leaves = [leaf]
        elif args.leaf is not None:
            leaves = [args.leaf]
        else:
            leaves = parse_printed_range(page_index, args.pages)
        for leaf in leaves:
            validate_leaf_in_index(page_index, leaf)
    except (KeyError, ValueError) as exc:
        fail(str(exc.args[0]) if exc.args else str(exc))

    if page_index.get("segment_mode") == "flat":
        fail(
            f"Item {identifier} OCR text has no page breaks; per-page text is unavailable. "
            "Use `grep` or `download` for the full text."
        )
    segments = djvu_text.split("\x0c")
    pages_out: list[dict] = []
    for leaf in leaves:
        info = describe_leaf(page_index, leaf)
        seg_idx = segment_for_leaf(page_index, leaf, info["scandata_leaf"])
        if seg_idx is None or seg_idx < 0 or seg_idx >= len(segments):
            fail(f"No OCR text segment found for leaf n{leaf} in {identifier} (djvu.txt has {len(segments)} pages).")
        info["text"] = segments[seg_idx].strip("\n")
        info["image_url"] = page_image_url(identifier, leaf, scale=2)
        info["details_url"] = page_details_url(identifier, leaf)
        pages_out.append(info)

    payload = {
        "identifier": identifier,
        "cached": bool(cache_entry["cached"]),
        "pages": pages_out,
    }
    if args.as_json:
        print(json.dumps(json_with_cache_hit(payload, bool(cache_entry["cached"])), indent=2, ensure_ascii=False))
        return 0
    for idx, page in enumerate(pages_out):
        if idx:
            print()
        pp = f"p.{page['printed_page']}" if page["printed_page"] else "p.?"
        sc = f", scandata leaf {page['scandata_leaf']}" if page["scandata_leaf"] is not None else ""
        print(f"== {identifier} | n{page['leaf']} ({pp}{sc})")
        print(f"   image: {page['image_url']}")
        print(f"   details: {page['details_url']}")
        print(page["text"])
    return 0


def cmd_lookup(args: argparse.Namespace) -> int:
    identifier = validate_identifier(args.identifier)
    selectors = [s for s in (args.printed_page, args.leaf, args.scandata_leaf) if s is not None]
    if len(selectors) != 1:
        fail("Pass exactly one of --printed-page <p>, --leaf <n>, or --scandata-leaf <n>.", code=2)

    try:
        cache_entry = ensure_item_cache(
            identifier,
            need_djvu=False,
            cache_root=get_cache_root(),
            timeout=args.timeout,
            refresh=args.refresh,
        )
        page_index = json.loads(cache_entry["page_index_path"].read_text(encoding="utf-8"))
    except Exception as exc:
        fail(str(exc))

    try:
        if args.printed_page is not None:
            leaf, _ = resolve_printed_page_to_leaf(page_index, args.printed_page)
        elif args.leaf is not None:
            leaf = args.leaf
        else:
            leaf = leaf_from_scandata_leaf(page_index, args.scandata_leaf)
        validate_leaf_in_index(page_index, leaf)
    except (KeyError, ValueError) as exc:
        fail(str(exc.args[0]) if exc.args else str(exc))

    info = describe_leaf(page_index, leaf)
    payload = {
        "identifier": identifier,
        "cached": bool(cache_entry["cached"]),
        **info,
        "image_url": page_image_url(identifier, leaf, scale=2),
        "details_url": page_details_url(identifier, leaf),
    }
    if args.as_json:
        print(json.dumps(json_with_cache_hit(payload, bool(cache_entry["cached"])), indent=2, ensure_ascii=False))
        return 0
    pp = info["printed_page"] if info["printed_page"] else "?"
    sc = info["scandata_leaf"] if info["scandata_leaf"] is not None else "?"
    print(f"{identifier}: printed page {pp} | BookReader leaf n{leaf} | scandata leaf {sc}")
    print(f"  image: {payload['image_url']}")
    print(f"  details: {payload['details_url']}")
    return 0


def json_with_cache_hit(payload: dict, cache_hit: bool) -> dict:
    """Copy a JSON object and set the telemetry cache_hit flag without mutating cache files."""
    body = dict(payload)
    body["cache_hit"] = bool(cache_hit)
    return body


def cmd_search(args: argparse.Namespace) -> int:
    query = args.query
    if args.mediatype:
        query = f"{query} AND mediatype:({args.mediatype})"
    chosen = list(args.fields) if args.fields else DEFAULT_FIELDS
    ttl_hours = resolve_query_ttl_hours(args.cache_ttl_hours)
    data, cached = search_api(
        query,
        chosen,
        args.rows,
        args.page,
        list(args.sorts),
        ttl_hours=ttl_hours,
        refresh=args.refresh,
    )
    response = data.get("response") or {}
    if args.as_json:
        print(json.dumps(json_with_cache_hit(data, cached), indent=2))
        return 0
    status = "cache-hit" if cached else "fetched"
    print(f"{response.get('numFound')} items ({status})")
    for doc in response.get("docs") or []:
        identifier = doc.get("identifier") or ""
        title = doc.get("title") or ""
        creator = doc.get("creator") or ""
        date = doc.get("date") or ""
        mediatype_out = doc.get("mediatype") or ""
        print(
            f"{identifier} | {title} | {creator} | {date} | "
            f"{mediatype_out} | {item_url(identifier)}"
        )
    return 0


def cmd_get(args: argparse.Namespace) -> int:
    identifier = validate_identifier(args.identifier)
    data, cached = metadata_api(identifier, timeout=args.timeout, refresh=args.refresh)
    if args.as_json:
        print(json.dumps(json_with_cache_hit(data, cached), indent=2))
        return 0
    meta = data.get("metadata") or {}
    status = "cache-hit" if cached else "fetched"
    print(f"{meta.get('title') or identifier}")
    print(f"  Identifier: {meta.get('identifier')}")
    if meta.get("creator"):
        print(f"  Creator: {meta.get('creator')}")
    if meta.get("date"):
        print(f"  Date: {meta.get('date')}")
    if meta.get("mediatype"):
        print(f"  Mediatype: {meta.get('mediatype')}")
    if meta.get("collection"):
        collection = meta.get("collection")
        if isinstance(collection, list):
            collection = ", ".join(collection)
        print(f"  Collection: {collection}")
    if meta.get("description"):
        print(f"  Description: {short(meta.get('description'))}")
    file_list = data.get("files") or []
    print(f"  Files: {len(file_list)} | {item_url(identifier)} ({status})")
    if args.files:
        for entry in file_list:
            size = entry.get("size") or ""
            print(f"    {entry.get('name')} | {entry.get('format')} | {size} bytes")
    return 0


def cmd_download(args: argparse.Namespace) -> int:
    identifier = validate_identifier(args.identifier)
    cache_root = get_cache_root()
    files_root = cache_root / identifier / "files"

    # Validate requested filenames at the CLI boundary before hitting metadata or disk.
    validated_names: list[tuple[str, Path]] = []
    if not args.list_only and args.files:
        for name in args.files:
            try:
                rel, _ = validate_relative_item_path(name, files_root)
            except ValueError as exc:
                fail(str(exc), code=2)
            validated_names.append((name, rel))

    data, _ = metadata_api(
        identifier, cache_root=cache_root, timeout=args.timeout, refresh=args.refresh
    )
    file_list = data.get("files") or []
    if args.list_only or not args.files:
        for entry in file_list:
            size = entry.get("size") or ""
            print(f"{entry.get('name')} | {entry.get('format')} | {size} bytes")
        return 0

    by_name = {entry.get("name"): entry for entry in file_list if entry.get("name")}
    out_dir = Path(args.out)
    out_dir.mkdir(parents=True, exist_ok=True)
    for name, rel in validated_names:
        file_entry = by_name.get(name)
        if file_entry is None:
            fail(f"File not in item {identifier}: {name}")
        try:
            content, _, cached = ensure_downloaded_file(
                identifier,
                name,
                file_list,
                file_entry,
                cache_root=cache_root,
                timeout=args.timeout,
                refresh=args.refresh,
            )
        except ValueError as exc:
            fail(str(exc), code=2)
        except (RuntimeError, FileNotFoundError) as exc:
            fail(str(exc))
        dest = out_dir / rel.name
        atomic_write_bytes(dest, content)
        status = "cache-hit" if cached else "fetched"
        print(f"{dest} ({len(content)} bytes, {status})")
    return 0


def cmd_fulltext(args: argparse.Namespace) -> int:
    ttl_hours = resolve_query_ttl_hours(args.cache_ttl_hours)
    data, cached = fulltext_api(
        args.query,
        args.rows,
        args.page,
        ttl_hours=ttl_hours,
        refresh=args.refresh,
    )
    if args.as_json:
        print(json.dumps(json_with_cache_hit(data, cached), indent=2, ensure_ascii=False))
        return 0
    hits_block = ((data.get("response") or {}).get("body") or {}).get("hits") or {}
    total = hits_block.get("total", 0)
    hits = hits_block.get("hits") or []
    status = "cache-hit" if cached else "fetched"
    print(f"{total} full-text matches (showing {len(hits)}, {status})")
    for hit in hits:
        fields = hit.get("fields") or {}
        identifier = fields.get("identifier") or ""
        title = fields.get("title") or ""
        year = fields.get("year") or fields.get("date") or ""
        snippets = (hit.get("highlight") or {}).get("text") or []
        snippet = short(snippets[0].replace("{{{", "").replace("}}}", ""), 200) if snippets else ""
        print(f"- {identifier} | {title} | {year} | {item_url(identifier)}")
        if snippet:
            print(f"  OCR: {snippet}")
    return 0


def cmd_grep(args: argparse.Namespace) -> int:
    t0 = time.perf_counter()
    if args.context < 0:
        fail(f"--context must be >= 0, got {args.context}.", code=2)
    if args.limit < 0:
        fail(f"--limit must be >= 0, got {args.limit}.", code=2)
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        fail(f"--timeout must be > 0, got {args.timeout!r}.", code=2)

    raw_patterns = [p for p in (args.patterns or []) if p is not None]
    if not raw_patterns:
        fail("Pass --pattern <regex> (or -e <regex>) to search inside items.", code=2)
    pattern = raw_patterns[0] if len(raw_patterns) == 1 else "|".join(f"(?:{p})" for p in raw_patterns)

    flags = re.IGNORECASE if args.ignore_case else 0
    try:
        compiled = re.compile(pattern, flags)
    except re.error as exc:
        fail(f"Invalid regex pattern {pattern!r}: {exc}", code=2)

    seen_ids: set[str] = set()
    identifiers: list[str] = []
    for raw_item in args.identifiers:
        item_id = validate_identifier(raw_item)
        if item_id not in seen_ids:
            seen_ids.add(item_id)
            identifiers.append(item_id)
    cache_root = get_cache_root()

    # Fetch missing items in parallel (max_workers=6, timeout=25).
    def prepare(item_id: str) -> dict:
        return ensure_item_cache(
            item_id,
            need_djvu=True,
            cache_root=cache_root,
            timeout=args.timeout,
            refresh=args.refresh,
        )

    cache_entries: list[dict] = []
    item_errors: list[dict[str, str]] = []

    if len(identifiers) == 1:
        try:
            cache_entries = [prepare(identifiers[0])]
        except Exception as exc:
            fail(str(exc))
    else:
        from concurrent.futures import ThreadPoolExecutor

        with ThreadPoolExecutor(max_workers=min(MAX_WORKERS, len(identifiers))) as pool:
            futures = [(item_id, pool.submit(prepare, item_id)) for item_id in identifiers]
            for item_id, fut in futures:
                try:
                    cache_entries.append(fut.result())
                except Exception as exc:
                    item_errors.append({"identifier": item_id, "error": str(exc)})
        if not cache_entries:
            detail = "; ".join(f"{err['identifier']}: {err['error']}" for err in item_errors)
            fail(detail)

    all_hits: list[dict] = []
    item_summaries: list[dict] = []
    remaining = max(0, args.limit)
    total_matches = 0
    all_cached = len(item_errors) == 0

    for entry in cache_entries:
        item_id = entry["identifier"]
        was_cached = bool(entry["cached"])
        all_cached = all_cached and was_cached
        page_index = json.loads(entry["page_index_path"].read_text(encoding="utf-8"))
        djvu_text = entry["djvu_path"].read_text(encoding="utf-8", errors="replace")
        hits, item_total = grep_cached_item(
            item_id,
            djvu_text,
            page_index,
            compiled,
            context_chars=args.context,
            limit=remaining,
        )
        for h in hits:
            h["cached"] = was_cached
        all_hits.extend(hits)
        remaining = max(0, args.limit - len(all_hits))
        total_matches += item_total
        item_summaries.append(
            {
                "identifier": item_id,
                "cached": was_cached,
                "matches": item_total,
                "returned": len(hits),
                "cache_dir": str(entry["item_dir"]),
            }
        )

    elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
    payload: dict[str, object] = {
        "pattern": pattern,
        "ignore_case": bool(args.ignore_case),
        "cached": all_cached,
        "elapsed_ms": elapsed_ms,
        "total_matches": total_matches,
        "returned": len(all_hits),
        "items": item_summaries,
        "hits": all_hits,
    }
    if item_errors:
        payload["errors"] = item_errors

    if args.as_json:
        print(json.dumps(json_with_cache_hit(payload, all_cached), indent=2, ensure_ascii=False))
        return 0

    status = "cache-hit" if all_cached else "fetched"
    print(f"{total_matches} matches across {len(cache_entries)} item(s) (showing {len(all_hits)}, {status}, {elapsed_ms} ms)")
    for hit in all_hits:
        pp = f"p.{hit['printed_page']}" if hit["printed_page"] else "p.?"
        lf = f"n{hit['leaf']}" if hit["leaf"] is not None else "n?"
        print(f"- {hit['identifier']} | {lf} ({pp}) | {hit['image_url'] or hit['details_url']}")
        print(f"  {hit['snippet']}")
    for err in item_errors:
        sys.stderr.write(f"warning: {err['identifier']}: {err['error']}\n")
    return 0


def parse_leaf_spec(spec: str) -> list[int]:
    """Parse `--leaves` integers and inclusive ranges such as `120-123,130`, deduplicated in order."""
    leaves: list[int] = []
    seen: set[int] = set()
    parts = [part.strip() for part in spec.split(",")]
    if not spec.strip() or not parts or any(not part for part in parts):
        fail("Invalid --leaves value. Use integers or inclusive ranges like 120-123,130.", code=2)
    for part in parts:
        range_match = re.fullmatch(r"(\d+)\s*-\s*(\d+)", part)
        if range_match:
            start = int(range_match.group(1))
            end = int(range_match.group(2))
            if end < start:
                fail(f"Invalid --leaves range {part!r}: {end} precedes {start}.", code=2)
            if (end - start + 1) > PAGE_BATCH_LIMIT:
                fail(
                    f"--leaves asks for more than {PAGE_BATCH_LIMIT} pages. "
                    f"Split the request into batches of {PAGE_BATCH_LIMIT} or fewer.",
                    code=2,
                )
            chunk = range(start, end + 1)
        elif re.fullmatch(r"\d+", part):
            num = int(part)
            chunk = range(num, num + 1)
        else:
            fail(f"Invalid --leaves token {part!r}. Use integers or inclusive ranges like 120-123,130.", code=2)
        for leaf in chunk:
            if leaf not in seen:
                seen.add(leaf)
                leaves.append(leaf)
                if len(leaves) > PAGE_BATCH_LIMIT:
                    fail(
                        f"--leaves asks for more than {PAGE_BATCH_LIMIT} pages. "
                        f"Split the request into batches of {PAGE_BATCH_LIMIT} or fewer.",
                        code=2,
                    )
    return leaves


def parse_printed_page_spec(spec: str) -> list[str]:
    """Parse `--printed-pages` labels and inclusive integer ranges such as `670-674,707`, deduplicated in order."""
    labels: list[str] = []
    seen: set[str] = set()
    parts = [part.strip() for part in spec.split(",")]
    if not spec.strip() or not parts or any(not part for part in parts):
        fail(
            "Invalid --printed-pages value. Use printed labels or inclusive integer ranges like 670-674,707.",
            code=2,
        )
    for part in parts:
        range_match = re.fullmatch(r"(\d+)\s*-\s*(\d+)", part)
        if range_match:
            start = int(range_match.group(1))
            end = int(range_match.group(2))
            if end < start:
                fail(f"Invalid --printed-pages range {part!r}: {end} precedes {start}.", code=2)
            if (end - start + 1) > PAGE_BATCH_LIMIT:
                fail(
                    f"--printed-pages asks for more than {PAGE_BATCH_LIMIT} pages. "
                    f"Split the request into batches of {PAGE_BATCH_LIMIT} or fewer.",
                    code=2,
                )
            chunk = [str(number) for number in range(start, end + 1)]
        else:
            chunk = [part]
        for label in chunk:
            if label not in seen:
                seen.add(label)
                labels.append(label)
                if len(labels) > PAGE_BATCH_LIMIT:
                    fail(
                        f"--printed-pages asks for more than {PAGE_BATCH_LIMIT} pages. "
                        f"Split the request into batches of {PAGE_BATCH_LIMIT} or fewer.",
                        code=2,
                    )
    return labels


def _page_suffix_and_url(identifier: str, leaf: int, scale: int | None, width: int | None) -> tuple[str, str]:
    if scale is not None:
        return f"s{scale}", page_image_url(identifier, leaf, scale=scale)
    chosen_width = width if width is not None else 2400
    return f"w{chosen_width}", page_image_url(identifier, leaf, width=chosen_width)


def _fetch_page_jobs(
    identifier: str,
    jobs: list[dict],
    *,
    cache_root: Path,
    timeout: float,
    refresh: bool,
) -> list[tuple[bytes, Path, bool]]:
    def fetch_one(job: dict) -> tuple[bytes, Path, bool]:
        return ensure_page_image_cache(
            identifier,
            job["leaf"],
            job["suffix"],
            job["url"],
            cache_root=cache_root,
            timeout=timeout,
            refresh=refresh,
        )

    if len(jobs) <= 1:
        return [fetch_one(job) for job in jobs]
    from concurrent.futures import ThreadPoolExecutor

    workers = min(PAGE_BATCH_WORKERS, len(jobs))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [pool.submit(fetch_one, job) for job in jobs]
        return [future.result() for future in futures]


def cmd_page(args: argparse.Namespace) -> int:
    t0 = time.perf_counter()
    identifier = validate_identifier(args.identifier)
    if args.scale is not None and args.scale < 1:
        fail(f"--scale must be >= 1, got {args.scale}.", code=2)
    if args.width is not None and args.width < 1:
        fail(f"--width must be >= 1, got {args.width}.", code=2)
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        fail(f"--timeout must be > 0, got {args.timeout!r}.", code=2)
    cache_root = get_cache_root()

    leaf_from_pos = args.leaf_pos
    leaf_from_flag = args.leaf
    printed_page = args.printed_page
    leaves_spec = args.leaves
    printed_pages_spec = args.printed_pages

    if printed_page is not None and (leaf_from_pos is not None or leaf_from_flag is not None):
        fail("Pass either --printed-page or --leaf (not both).", code=2)
    if leaf_from_pos is not None and leaf_from_flag is not None:
        fail("Pass either positional <leaf> or --leaf (not both).", code=2)
    if leaves_spec is not None and printed_pages_spec is not None:
        fail("Pass either --leaves or --printed-pages, not both.", code=2)
    single_names: list[str] = []
    if leaf_from_pos is not None:
        single_names.append("positional <leaf>")
    if leaf_from_flag is not None:
        single_names.append("--leaf")
    if printed_page is not None:
        single_names.append("--printed-page")
    if leaves_spec is not None and single_names:
        fail(f"Pass either --leaves or {' or '.join(single_names)}, not both.", code=2)
    if printed_pages_spec is not None and single_names:
        fail(f"Pass either --printed-pages or {' or '.join(single_names)}, not both.", code=2)

    jobs: list[dict] = []
    index_cached: bool | None = None

    if printed_pages_spec is not None:
        labels = parse_printed_page_spec(printed_pages_spec)
        try:
            cache_entry = ensure_item_cache(
                identifier,
                need_djvu=False,
                cache_root=cache_root,
                timeout=args.timeout,
                refresh=args.refresh,
            )
            index_cached = bool(cache_entry["cached"])
            page_index = json.loads(cache_entry["page_index_path"].read_text(encoding="utf-8"))
            for label in labels:
                leaf, _scandata = resolve_printed_page_to_leaf(page_index, label)
                validate_leaf_in_index(page_index, leaf)
                info = describe_leaf(page_index, leaf)
                jobs.append(
                    {
                        "leaf": leaf,
                        "scandata_leaf": info["scandata_leaf"],
                        "printed_page": info["printed_page"],
                    }
                )
        except Exception as exc:
            fail(str(exc))
    elif leaves_spec is not None:
        for leaf in parse_leaf_spec(leaves_spec):
            jobs.append({"leaf": leaf, "scandata_leaf": None, "printed_page": None})
    elif printed_page is not None:
        try:
            cache_entry = ensure_item_cache(
                identifier,
                need_djvu=False,
                cache_root=cache_root,
                timeout=args.timeout,
                refresh=args.refresh,
            )
            index_cached = bool(cache_entry["cached"])
            page_index = json.loads(cache_entry["page_index_path"].read_text(encoding="utf-8"))
            target_leaf, scandata_leaf = resolve_printed_page_to_leaf(page_index, printed_page)
        except Exception as exc:
            fail(str(exc))
        jobs.append(
            {"leaf": target_leaf, "scandata_leaf": scandata_leaf, "printed_page": printed_page}
        )
    else:
        target_leaf = leaf_from_flag if leaf_from_flag is not None else leaf_from_pos
        if target_leaf is None:
            fail(
                "Specify a target page with --printed-page <str>, --leaf <int>, positional <leaf>, "
                "--leaves, or --printed-pages.",
                code=2,
            )
        if target_leaf < 0:
            fail(f"Leaf index must be >= 0, got {target_leaf}.", code=2)
        jobs.append({"leaf": target_leaf, "scandata_leaf": None, "printed_page": None})

    for job in jobs:
        suffix, url = _page_suffix_and_url(identifier, int(job["leaf"]), args.scale, args.width)
        job["suffix"] = suffix
        job["url"] = url

    out_path = Path(args.out)
    if len(jobs) > 1 and out_path.suffix.lower() in IMAGE_EXTS and not out_path.is_dir():
        fail(
            f"--out {args.out} is a single image file. Pass a directory when fetching {len(jobs)} pages.",
            code=2,
        )

    try:
        fetched = _fetch_page_jobs(
            identifier,
            jobs,
            cache_root=cache_root,
            timeout=args.timeout,
            refresh=args.refresh,
        )
    except (RuntimeError, FileNotFoundError) as exc:
        fail(str(exc))

    written: list[dict] = []
    if len(jobs) == 1:
        job = jobs[0]
        content, page_cache_path, page_cached = fetched[0]
        if out_path.suffix.lower() in IMAGE_EXTS and not out_path.is_dir():
            dest = out_path
        else:
            out_path.mkdir(parents=True, exist_ok=True)
            dest = out_path / f"{identifier}_n{job['leaf']}_{job['suffix']}.jpg"
        if dest.resolve() != page_cache_path.resolve():
            atomic_write_bytes(dest, content)
        written.append(
            {
                "leaf": job["leaf"],
                "scandata_leaf": job["scandata_leaf"],
                "printed_page": job["printed_page"],
                "url": job["url"],
                "path": str(dest),
                "cache_path": str(page_cache_path),
                "bytes": len(content),
                "page_cached": page_cached,
            }
        )
    else:
        out_path.mkdir(parents=True, exist_ok=True)
        for job, (content, page_cache_path, page_cached) in zip(jobs, fetched, strict=True):
            dest = out_path / f"{identifier}_n{job['leaf']}_{job['suffix']}.jpg"
            if dest.resolve() != page_cache_path.resolve():
                atomic_write_bytes(dest, content)
            written.append(
                {
                    "leaf": job["leaf"],
                    "scandata_leaf": job["scandata_leaf"],
                    "printed_page": job["printed_page"],
                    "url": job["url"],
                    "path": str(dest),
                    "cache_path": str(page_cache_path),
                    "bytes": len(content),
                    "page_cached": page_cached,
                }
            )

    if len(written) == 1:
        row = written[0]
        elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
        payload = {
            "identifier": identifier,
            "leaf": row["leaf"],
            "scandata_leaf": row["scandata_leaf"],
            "printed_page": row["printed_page"],
            "url": row["url"],
            "path": row["path"],
            "cache_path": row["cache_path"],
            "bytes": row["bytes"],
            "index_cached": index_cached,
            "page_cached": row["page_cached"],
            "elapsed_ms": elapsed_ms,
        }
        page_hit = row["page_cached"] if index_cached is None else bool(row["page_cached"] and index_cached)
        if args.as_json:
            print(json.dumps(json_with_cache_hit(payload, page_hit), indent=2))
        else:
            extra = (
                f" [p.{row['printed_page']} -> n{row['leaf']}]"
                if row["printed_page"] is not None
                else f" [n{row['leaf']}]"
            )
            status = "cache-hit" if row["page_cached"] else "fetched"
            print(f"{row['path']} ({row['bytes']} bytes){extra} ({status})")
        return 0

    cache_hit = all(row["page_cached"] for row in written) and index_cached is not False
    pages_payload = [
        {
            "leaf": row["leaf"],
            "scandata_leaf": row["scandata_leaf"],
            "printed_page": row["printed_page"],
            "url": row["url"],
            "path": row["path"],
            "bytes": row["bytes"],
            "page_cached": row["page_cached"],
        }
        for row in written
    ]
    payload = {"identifier": identifier, "count": len(pages_payload), "pages": pages_payload}
    if args.as_json:
        print(json.dumps(json_with_cache_hit(payload, cache_hit), indent=2))
    else:
        for row in written:
            extra = (
                f" [p.{row['printed_page']} -> n{row['leaf']}]"
                if row["printed_page"] is not None
                else f" [n{row['leaf']}]"
            )
            status = "cache-hit" if row["page_cached"] else "fetched"
            print(f"{row['path']} ({row['bytes']} bytes){extra} ({status})")
    return 0


def cmd_url(args: argparse.Namespace) -> int:
    full = args.query
    if args.mediatype:
        full = f"{args.query} AND mediatype:({args.mediatype})"
    print(f"{ADVANCED_SEARCH}?q={quote(full)}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="archive-org",
        description="Search, inspect, grep cached OCR, and download pages from Internet Archive.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_search = sub.add_parser("search", help="Search items with a Lucene query.")
    p_search.add_argument("query")
    p_search.add_argument("--mediatype", default=None, help="e.g. texts, movies, audio, software, collection.")
    p_search.add_argument("--rows", type=int, default=10, help="Results per page (default: 10).")
    p_search.add_argument("--page", type=int, default=1, help="Results page (default: 1).")
    p_search.add_argument("--sort", dest="sorts", action="append", default=[], help="Repeatable, e.g. --sort 'downloads desc'.")
    p_search.add_argument("--field", dest="fields", action="append", default=[], help="Repeatable metadata field.")
    p_search.add_argument("--cache-ttl-hours", type=float, default=None, help="Query cache TTL in hours (default: 168 or KINLOOM_IA_QUERY_TTL_HOURS).")
    p_search.add_argument("--refresh", action="store_true", help="Bypass local cache and fetch fresh results.")
    p_search.add_argument("--json", dest="as_json", action="store_true", help="Full JSON output.")
    p_search.set_defaults(func=cmd_search)

    p_get = sub.add_parser("get", help="Read an item's metadata and file list by identifier.")
    p_get.add_argument("identifier")
    p_get.add_argument("--json", dest="as_json", action="store_true", help="Full JSON output.")
    p_get.add_argument("--files", action="store_true", help="List the item's files.")
    p_get.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="HTTP timeout seconds on cache miss (default: 25).")
    p_get.add_argument("--refresh", action="store_true", help="Bypass local metadata cache and fetch fresh metadata.")
    p_get.set_defaults(func=cmd_get)

    p_dl = sub.add_parser("download", help="Download files of an item, or list them with no FILE given.")
    p_dl.add_argument("identifier")
    p_dl.add_argument("files", nargs="*")
    p_dl.add_argument(
        "--out", "-o", "--out-dir", "--output", dest="out", default=".",
        help="Directory to save files into (default: .).",
    )
    p_dl.add_argument("--list", dest="list_only", action="store_true", help="Only list files, do not download.")
    p_dl.add_argument("--timeout", type=float, default=DOWNLOAD_TIMEOUT, help="HTTP timeout seconds on cache miss (default: 60).")
    p_dl.add_argument("--refresh", action="store_true", help="Bypass local cache and re-download metadata and files.")
    p_dl.set_defaults(func=cmd_download)

    p_ft = sub.add_parser("fulltext", help="Search OCR full text across digitized books and periodicals.")
    p_ft.add_argument("query")
    p_ft.add_argument("--rows", type=int, default=10, help="Hits per page (default: 10).")
    p_ft.add_argument("--page", type=int, default=1, help="Results page, 1-based (default: 1).")
    p_ft.add_argument("--cache-ttl-hours", type=float, default=None, help="Query cache TTL in hours (default: 168 or KINLOOM_IA_QUERY_TTL_HOURS).")
    p_ft.add_argument("--refresh", action="store_true", help="Bypass local cache and fetch fresh results.")
    p_ft.add_argument("--json", dest="as_json", action="store_true", help="Full JSON output.")
    p_ft.set_defaults(func=cmd_fulltext)

    p_grep = sub.add_parser("grep", help="Search cached full-text OCR inside one or more items with exact page mapping.")
    p_grep.add_argument("identifiers", nargs="+", help="One or more Internet Archive item identifiers.")
    p_grep.add_argument(
        "--pattern", "-e", dest="patterns", action="append", required=True,
        help="Regular expression pattern (searched line by line; repeatable).",
    )
    p_grep.add_argument("--context", "-C", type=int, default=240, help="Context characters per hit snippet (default: 240).")
    p_grep.add_argument("--limit", "-m", type=int, default=25, help="Maximum hits returned (default: 25).")
    p_grep.add_argument("-i", "--ignore-case", action="store_true", help="Case-insensitive regex matching.")
    p_grep.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="HTTP timeout seconds on cache miss (default: 25).")
    p_grep.add_argument("--refresh", action="store_true", help="Bypass local cache and re-fetch metadata, scandata, and OCR text.")
    p_grep.add_argument("--json", dest="as_json", action="store_true", help="Structured JSON output.")
    p_grep.set_defaults(func=cmd_grep)

    p_page = sub.add_parser("page", help="Download one or more rendered page JPEGs by printed page number or BookReader leaf.")
    p_page.add_argument("identifier")
    p_page.add_argument("leaf_pos", nargs="?", type=int, default=None, help="Legacy positional BookReader leaf index.")
    p_page.add_argument("--printed-page", default=None, help="Printed page label resolved via cached page_index.json.")
    p_page.add_argument("--printed-pages", default=None, help="Comma-separated printed labels and inclusive integer ranges, e.g. 674,707 or 670-674 (max 25).")
    p_page.add_argument("--leaf", type=int, default=None, help="BookReader leaf index (n<LEAF>).")
    p_page.add_argument("--leaves", default=None, help="Comma-separated BookReader leaves and inclusive ranges, e.g. 120-123,130 (max 25).")
    p_page.add_argument("--scale", type=int, default=None, help="BookReader scale factor (e.g. 1=full, 2=half, 4=quarter).")
    p_page.add_argument("--width", type=int, default=None, help="Rendered JPEG width in pixels (default 2400 when --scale is omitted).")
    p_page.add_argument(
        "--out", "-o", "--out-dir", "--output", dest="out", default=".",
        help="Output file path (.jpg) or directory (default: .).",
    )
    p_page.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="HTTP timeout seconds (default: 25).")
    p_page.add_argument("--refresh", action="store_true", help="Bypass local cache and re-fetch index and page JPEG.")
    p_page.add_argument("--json", dest="as_json", action="store_true", help="Structured JSON output.")
    p_page.set_defaults(func=cmd_page)

    p_text = sub.add_parser("text", help="Print cached OCR text for a printed page, leaf, or printed-page range (no JPEG download).")
    p_text.add_argument("identifier")
    p_text.add_argument("--printed-page", default=None, help="Printed page label resolved via cached page_index.json.")
    p_text.add_argument("--leaf", type=int, default=None, help="BookReader leaf index (n<LEAF>).")
    p_text.add_argument("--pages", default=None, help="Inclusive printed-page range, e.g. 12-14.")
    p_text.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="HTTP timeout seconds on cache miss (default: 25).")
    p_text.add_argument("--refresh", action="store_true", help="Bypass local cache and re-fetch metadata, scandata, and OCR text.")
    p_text.add_argument("--json", dest="as_json", action="store_true", help="Structured JSON output.")
    p_text.set_defaults(func=cmd_text)

    p_lookup = sub.add_parser("lookup", help="Resolve printed page <-> BookReader leaf <-> scandata leaf from cached page_index.json.")
    p_lookup.add_argument("identifier")
    p_lookup.add_argument("--printed-page", default=None, help="Printed page label.")
    p_lookup.add_argument("--leaf", type=int, default=None, help="BookReader leaf index (n<LEAF>).")
    p_lookup.add_argument("--scandata-leaf", type=int, default=None, help="Raw scandata.xml leafNum.")
    p_lookup.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="HTTP timeout seconds on cache miss (default: 25).")
    p_lookup.add_argument("--refresh", action="store_true", help="Bypass local cache and re-fetch metadata and scandata.")
    p_lookup.add_argument("--json", dest="as_json", action="store_true", help="Structured JSON output.")
    p_lookup.set_defaults(func=cmd_lookup)

    p_url = sub.add_parser("url", help="Print the website advanced-search URL for a query.")
    p_url.add_argument("query")
    p_url.add_argument("--mediatype", default=None)
    p_url.set_defaults(func=cmd_url)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except BrokenPipeError:
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
            os.close(devnull)
        except Exception:
            pass
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
