def resolve_database(name: str) -> str:
    """Map a typed database name to a registry key, or raise a helpful error."""
    key = re.sub(r"[\s_]+", "-", name.strip().lower())
    if key in DATABASES or key in ORDER_ONLY or key == "monmouth":
        return key
    if key in DATABASE_ALIASES:
        return DATABASE_ALIASES[key]
    known = [*DATABASES, *ORDER_ONLY, *DATABASE_ALIASES]
    close = difflib.get_close_matches(key, known, n=3, cutoff=0.6)
    hint = f" Did you mean: {', '.join(DATABASE_ALIASES.get(c, c) for c in close)}?" if close else ""
    raise click.UsageError(
        f"unknown database {name!r}.{hint} Valid: {', '.join(DATABASES)}. "
        "Run `nj-archives databases` for the live list."
    )


MONMOUTH_TOWNS = ["Atlantic", "Freehold", "Holmdel", "Howell", "Marlboro",
                  "Middletown", "Ocean", "Shrewsbury", "Upper Freehold", "Wall"]
