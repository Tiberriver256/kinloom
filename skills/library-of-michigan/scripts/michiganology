#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
# ]
# ///
"""Search Michiganology, the Archives of Michigan digital collections
(Preservica Universal Access), from the command line.

Simple search is a stable GET: https://michigan.access.preservica.com/?s=<query>
Results are server-rendered, so plain HTTP works, no browser and no key.
Transport note: Preservica's front door 403s Python httpx requests (TLS
fingerprint) while curl succeeds with any User-Agent, so this CLI shells out
to curl for the fetch. curl must be installed; it is on any normal Unix box.
Verified live 2026-11-24: simple search returns server-rendered HTML results.
"""

from __future__ import annotations

import hashlib
import html as htmlmod
import json
import math
import os
import re
import shutil
import subprocess
import tempfile
import time
from contextlib import contextmanager
from html.parser import HTMLParser
from pathlib import Path
from typing import Any, Callable, Iterator
from urllib.parse import quote_plus, unquote

import click

DEFAULT_CACHE_TTL_HOURS = 168.0
CACHE_SCHEMA = 1


def cache_dir() -> Path:
    override = os.environ.get("KINLOOM_MICHIGANOLOGY_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-michiganology"


def resolve_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).")
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_MICHIGANOLOGY_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(
                f"Invalid KINLOOM_MICHIGANOLOGY_CACHE_TTL_HOURS value: {raw!r}.") from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_MICHIGANOLOGY_CACHE_TTL_HOURS value: {raw!r} (must be >= 0).")
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive lock (POSIX flock); no-op where fcntl is missing."""
    try:
        import fcntl
    except ImportError:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def atomic_write_bytes(dest: Path, data: bytes) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def atomic_write_json(dest: Path, payload: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def cache_key(kind: str, payload: dict) -> str:
    canonical = json.dumps([kind, payload], sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_cache(path: Path, ttl_hours: float) -> dict | None:
    if not path.is_file():
        return None
    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    if not isinstance(fetched, (int, float)):
        return None
    if ttl_hours <= 0 or (time.time() - fetched) > ttl_hours * 3600:
        return None
    result = entry.get("result")
    return result if isinstance(result, dict) else None


def cached_call(kind: str, payload: dict, fetch: Callable[[], dict], *,
                refresh: bool, ttl_hours: float,
                cacheable: Callable[[dict], bool] = lambda _r: True) -> tuple[dict, bool]:
    """Return (result, cache_hit). Concurrent callers of one query serialize
    on a per-key flock, so the second caller reads the first caller's file.
    Exceptions from fetch propagate and write nothing; results rejected by
    `cacheable` (doubtful empties) are returned but not stored."""
    key = cache_key(kind, payload)
    root = cache_dir()
    path = root / f"{key}.json"
    if not refresh:
        hit = read_cache(path, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(root / f"{key}.lock"):
        if not refresh:
            hit = read_cache(path, ttl_hours)
            if hit is not None:
                return hit, True
        result = fetch()
        if cacheable(result):
            atomic_write_json(path, {"schema": CACHE_SCHEMA, "fetched_at": time.time(),
                                     "kind": kind, "query": payload, "result": result})
        return result, False


def cache_options(func: Callable) -> Callable:
    func = click.option("--cache-ttl-hours", type=float, default=None,
                        help="Cache TTL in hours (default 168, env KINLOOM_MICHIGANOLOGY_CACHE_TTL_HOURS; 0 disables reads).")(func)
    func = click.option("--refresh", is_flag=True,
                        help="Bypass the disk cache for this request (the fresh result is still cached).")(func)
    return func

BASE = "https://michigan.access.preservica.com"
# Preservica 403s python-httpx's default header set. Plain curl-style headers
# (short UA, Accept */*) return 200 consistently.
USER_AGENT = "Mozilla/5.0"

COLLECTIONS = [
    ("Death Certificates, 1897-1952", BASE + "/death-certificates-1897-1952/"),
    ("Michigan State Census, 1827-1894", BASE + "/michigan-state-census/"),
    ("Naturalization Records", BASE + "/naturalization-records/"),
    ("World War I, Service Cards", BASE + "/world-war-i-service-cards/"),
    ("Surveyor Field Notebooks, 1815-1918", BASE + "/surveyor-field-notebooks/"),
    ("Surveyor Maps, 1816-1860", BASE + "/surveyor-maps/"),
    ("General Photograph Collection, ca. 1860-1990", BASE + "/general-photograph-collection/"),
    ("Archives of Michigan Map Collection, ca. 1810-1970", BASE + "/archives-of-michigan-map-collection/"),
    ("Corporation Annual Reports, 1997-2006", BASE + "/corporation-annual-reports/"),
]


class ResultParser(HTMLParser):
    """Collect result-item blocks: first link href plus its text."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.depth = 0
        self.results: list[dict] = []
        self.current: dict | None = None
        self.in_link = False
        self.link_text = ""

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        classes = attrs.get("class", "")
        if tag == "div" and "result-item" in classes and self.depth == 0:
            self.depth = 1
            self.current = {"title": "", "url": ""}
            return
        if self.depth > 0:
            if tag == "div":
                self.depth += 1
            elif tag == "a" and not self.current["url"]:
                href = attrs.get("href", "")
                if href:
                    self.current["url"] = href
                    self.in_link = True
                    self.link_text = ""

    def handle_endtag(self, tag):
        if self.depth > 0 and tag == "div":
            self.depth -= 1
            if self.depth == 0 and self.current:
                self.current["title"] = " ".join(self.link_text.split()) or "(no title)"
                if self.current["url"]:
                    self.results.append(self.current)
                self.current = None
        if tag == "a" and self.in_link:
            self.in_link = False

    def handle_data(self, data):
        if self.in_link:
            self.link_text += data


class ItemMetadataParser(HTMLParser):
    """Parse Preservica item page title, Item Data fields, and download link."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.in_h1 = False
        self.title = ""
        self.in_key = False
        self.in_val = False
        self.cur_key = ""
        self.cur_val = ""
        self.fields: list[tuple[str, str]] = []
        self.download_url: str | None = None

    def handle_starttag(self, tag, attrs):
        attr_map = dict(attrs)
        classes = attr_map.get("class", "")
        if tag == "h1" and not self.title:
            self.in_h1 = True
        elif tag == "span" and "metadata-title" in classes:
            self.in_key = True
            self.cur_key = ""
        elif tag == "span" and "metadata-content" in classes:
            self.in_val = True
            self.cur_val = ""
        elif tag == "a":
            href = attr_map.get("href", "")
            if "/download/file/" in href and not self.download_url:
                self.download_url = href

    def handle_endtag(self, tag):
        if tag == "h1" and self.in_h1:
            self.in_h1 = False
        elif tag == "span" and self.in_key:
            self.in_key = False
        elif tag == "span" and self.in_val:
            self.in_val = False
            key = " ".join(self.cur_key.split()).strip(":")
            val = " ".join(self.cur_val.split())
            if key:
                self.fields.append((key, val))

    def handle_data(self, data):
        if self.in_h1:
            self.title += data
        elif self.in_key:
            self.cur_key += data
        elif self.in_val:
            self.cur_val += data


def _require_curl() -> str:
    curl = shutil.which("curl")
    if not curl:
        raise click.ClickException("curl is required but was not found on PATH.")
    return curl


_STATUS_MARKER = "\n__KINLOOM_HTTP_STATUS__:"


def _curl_get_text(url: str) -> str:
    """GET a page via curl; raise ClickException on transport or non-200 status."""
    curl = _require_curl()
    try:
        proc = subprocess.run(
            [curl, "-sSL", "-A", USER_AGENT, "--max-time", "60",
             "-w", _STATUS_MARKER + "%{http_code}", url],
            capture_output=True,
            text=True,
            timeout=70,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise click.ClickException(f"Michiganology request failed: {exc}") from exc
    if proc.returncode != 0:
        raise click.ClickException(
            f"Michiganology request failed (curl exit {proc.returncode}): "
            f"{proc.stderr.strip()[:300]}"
        )
    body, sep, status = proc.stdout.rpartition(_STATUS_MARKER)
    if not sep:
        raise click.ClickException("Michiganology request failed: no HTTP status from curl.")
    status = status.strip()
    if status != "200":
        raise click.ClickException(f"Michiganology returned HTTP {status} for {url}")
    return body


def _resolve_item_ref(url_or_id: str) -> tuple[str, str]:
    """Return (item_id, item_page_url) from a Preservica URL or IO_/SO_ identifier."""
    raw = url_or_id.strip()
    match = re.search(r"((?:IO|SO)_[A-Za-z0-9-]+)", raw)
    if match:
        item_id = match.group(1)
        if raw.startswith("http://") or raw.startswith("https://"):
            return item_id, raw
        return item_id, f"{BASE}/uncategorized/{item_id}/"
    if raw.startswith("http://") or raw.startswith("https://"):
        return raw.rstrip("/").rsplit("/", 1)[-1], raw
    raise click.UsageError(
        "Pass a Michiganology item URL or a Preservica ID starting with IO_ or SO_."
    )


DOWNLOAD_FILE_EXTS = {".jpg", ".jpeg", ".png", ".tif", ".tiff", ".pdf"}


def _content_type_from_headers(headers_text: str) -> str:
    matches = re.findall(r"(?im)^content-type:\s*([^\r\n]+)", headers_text)
    return matches[-1].strip() if matches else ""


def _is_html_payload(content_type: str, body: bytes) -> bool:
    media = content_type.split(";", 1)[0].strip().lower()
    if media in {"text/html", "application/xhtml+xml"}:
        return True
    sniff = body.lstrip()[:256].lower()
    return sniff.startswith((b"<!doctype", b"<html", b"<head"))


def _filename_from_headers(headers_text: str, fallback: str) -> str:
    match_star = re.search(r"filename\*\s*=\s*UTF-8''([^\r\n;]+)", headers_text, re.I)
    if match_star:
        candidate = Path(unquote(match_star.group(1).strip().strip('"'))).name
        if candidate:
            return candidate
    match_plain = re.search(r'filename\s*=\s*"?([^"\r\n;]+)"?', headers_text, re.I)
    if match_plain:
        candidate = Path(match_plain.group(1).strip()).name
        if candidate:
            return candidate
    return fallback


def fetch_search(query: str) -> str:
    return _curl_get_text(f"{BASE}/?s={quote_plus(query)}")


def total_results(page: str) -> int | None:
    match = re.search(r"([\d,]+)\s+total results", page)
    return int(match.group(1).replace(",", "")) if match else None


def search_page(query: str) -> dict:
    """Fetch + parse the first search results page into a JSON-able dict."""
    page = fetch_search(query)
    parser = ResultParser()
    parser.feed(page)
    return {"query": query, "total": total_results(page), "results": parser.results}


def _file_cache_paths(item_id: str) -> tuple[Path, Path, Path]:
    root = cache_dir() / "files" / item_id
    return root / "body", root / "meta.json", root / ".lock"


def _read_file_cache(item_id: str, ttl_hours: float) -> dict[str, Any] | None:
    if ttl_hours <= 0:
        return None
    body_path, meta_path, _lock = _file_cache_paths(item_id)
    if not body_path.is_file() or not meta_path.is_file():
        return None
    try:
        size = body_path.stat().st_size
    except OSError:
        return None
    if size <= 0:
        return None
    try:
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(meta, dict) or meta.get("schema") != CACHE_SCHEMA:
        return None
    fetched = meta.get("fetched_at")
    filename = meta.get("filename")
    content_type = meta.get("content_type")
    if not isinstance(fetched, (int, float)) or not isinstance(filename, str) or not filename:
        return None
    if not isinstance(content_type, str) or not content_type:
        return None
    if meta.get("bytes") != size:
        return None
    if (time.time() - float(fetched)) > ttl_hours * 3600:
        return None
    try:
        body = body_path.read_bytes()
    except OSError:
        return None
    if not body or _is_html_payload(content_type, body):
        return None
    return {"body": body, "filename": filename, "content_type": content_type}


def _fetch_download_bytes(item_id: str, item_url: str) -> dict[str, Any]:
    """Download one IO_ file. Failures raise and leave the file cache untouched."""
    download_url = f"{BASE}/download/file/{item_id}"
    curl = _require_curl()
    with tempfile.TemporaryDirectory() as tmp_dir:
        hdr_path = Path(tmp_dir) / "headers.txt"
        body_path = Path(tmp_dir) / "body.bin"
        try:
            proc = subprocess.run(
                [
                    curl, "-sSL", "-A", USER_AGENT, "--max-time", "120",
                    "-D", str(hdr_path), "-o", str(body_path),
                    "-w", "%{http_code}", download_url,
                ],
                capture_output=True,
                text=True,
                timeout=130,
            )
        except (subprocess.SubprocessError, OSError) as exc:
            raise click.ClickException(f"Michiganology download failed: {exc}") from exc
        if proc.returncode != 0:
            raise click.ClickException(
                f"Michiganology download failed (curl exit {proc.returncode}): "
                f"{proc.stderr.strip()[:300]}"
            )
        status = proc.stdout.strip()
        if status != "200":
            raise click.ClickException(
                f"Michiganology download returned HTTP {status} for {download_url} (source page: {item_url})"
            )
        headers_text = hdr_path.read_text(encoding="utf-8", errors="replace") if hdr_path.is_file() else ""
        body = body_path.read_bytes() if body_path.is_file() else b""
        content_type = _content_type_from_headers(headers_text) or "application/octet-stream"
        filename = _filename_from_headers(headers_text, f"{item_id}.bin")
        if not body:
            raise click.ClickException(
                f"Michiganology download returned an empty file for {item_id}. The response was not cached."
            )
        if _is_html_payload(content_type, body):
            raise click.ClickException(
                f"Michiganology download returned an HTML page for {item_id}, not a file. "
                "The response was not cached."
            )
        return {"body": body, "filename": filename, "content_type": content_type}


def cached_download(item_id: str, item_url: str, *, refresh: bool, ttl_hours: float) -> tuple[dict[str, Any], bool]:
    """Return ({body, filename, content_type}, cache_hit) for one IO_ file.

    Callers of the same item share one flock. A crash before the atomic
    replace leaves the previous good file in place.
    """
    body_path, meta_path, lock_path = _file_cache_paths(item_id)
    if not refresh:
        hit = _read_file_cache(item_id, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(lock_path):
        if not refresh:
            hit = _read_file_cache(item_id, ttl_hours)
            if hit is not None:
                return hit, True
        fetched = _fetch_download_bytes(item_id, item_url)
        atomic_write_bytes(body_path, fetched["body"])
        atomic_write_json(meta_path, {
            "schema": CACHE_SCHEMA,
            "fetched_at": time.time(),
            "filename": fetched["filename"],
            "content_type": fetched["content_type"],
            "bytes": len(fetched["body"]),
        })
        return fetched, False


def _search_cacheable(result: dict) -> bool:
    # Cache hits; cache an empty result only when the page was clearly a real
    # search page reporting a total (e.g. "0 total results").
    return bool(result.get("results")) or result.get("total") is not None


def item_details(item_id: str, item_url: str) -> dict:
    """Fetch + parse an item page into a JSON-able dict."""
    page = _curl_get_text(item_url)
    parser = ItemMetadataParser()
    parser.feed(page)
    title = " ".join(parser.title.split())
    download_url = parser.download_url
    if not download_url and item_id.startswith("IO_"):
        download_url = f"{BASE}/download/file/{item_id}"
    return {
        "id": item_id,
        "title": title or item_id,
        "url": item_url,
        "download_url": download_url,
        "fields": [[k, v] for k, v in parser.fields],
        "parsed": bool(title or parser.fields),
    }


@click.group()
def cli() -> None:
    """Search Michiganology (Archives of Michigan digital collections)."""


@cli.command()
@click.argument("query")
@click.option("--limit", default=10, show_default=True, help="Max results to show (first page only).")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def search(query: str, limit: int, as_json: bool, refresh: bool, cache_ttl_hours: float | None) -> None:
    """Search all Michiganology collections, e.g. michiganology search Lincoln."""
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, hit = cached_call("search", {"query": query}, lambda: search_page(query),
                            refresh=refresh, ttl_hours=ttl, cacheable=_search_cacheable)
    total = data.get("total")
    results = list(data.get("results") or [])[:limit]
    if as_json:
        click.echo(json.dumps({"query": query, "total": total, "results": results,
                               "cache_hit": hit}, indent=2))
        return
    marker = " [cache]" if hit else ""
    click.echo(f"Query: {query}  |  Total results: {total if total is not None else 'unknown'}{marker}")
    if not results:
        click.echo("No results on the first page.")
        return
    for item in results:
        click.echo(f"- {item['title']}\n  {item['url']}")
    click.echo(f"({len(results)} of {total} shown; first page only)")


@cli.command()
@click.argument("url_or_id")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def get(url_or_id: str, as_json: bool, refresh: bool, cache_ttl_hours: float | None) -> None:
    """Inspect a Michiganology item page (Item Data fields and file download URL)."""
    item_id, item_url = _resolve_item_ref(url_or_id)
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, hit = cached_call("get", {"id": item_id, "url": item_url},
                            lambda: item_details(item_id, item_url), refresh=refresh,
                            ttl_hours=ttl, cacheable=lambda r: bool(r.get("parsed")))
    title = data["title"]
    download_url = data.get("download_url")
    fields = [(k, v) for k, v in data.get("fields") or []]
    metadata: dict[str, str | list[str]] = {}
    for key, val in fields:
        if key in metadata:
            prev = metadata[key]
            metadata[key] = [*prev, val] if isinstance(prev, list) else [prev, val]
        else:
            metadata[key] = val
    payload = {
        "id": item_id,
        "title": title,
        "url": item_url,
        "download_url": download_url,
        "metadata": metadata,
        "cache_hit": hit,
    }
    if as_json:
        click.echo(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    click.echo(f"Item {item_id}: {title}{' [cache]' if hit else ''}")
    click.echo(f"  URL: {item_url}")
    if download_url:
        click.echo(f"  Download: {download_url}")
    for key, val in fields:
        click.echo(f"  {key}: {val}")


def _download_dest(out: str, filename: str | None, resolved_name: str) -> Path:
    out_path = Path(out)
    if filename is None and out_path.suffix.lower() in DOWNLOAD_FILE_EXTS:
        out_path.parent.mkdir(parents=True, exist_ok=True)
        return out_path
    out_path.mkdir(parents=True, exist_ok=True)
    return out_path / Path(filename or resolved_name).name


@cli.command()
@click.argument("url_or_id")
@click.option("--out", "-o", default=".", show_default=True,
              help="Output directory, or a .jpg/.jpeg/.png/.tif/.tiff/.pdf file path when --filename is omitted.")
@click.option("--filename", default=None, help="Override output filename (default: from Content-Disposition).")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def download(url_or_id: str, out: str, filename: str | None, as_json: bool,
             refresh: bool, cache_ttl_hours: float | None) -> None:
    """Download the full-resolution file for a Michiganology IO_ item."""
    item_id, item_url = _resolve_item_ref(url_or_id)
    if not item_id.startswith("IO_"):
        raise click.ClickException(
            f"{item_id} is a folder/collection object (SO_); pass an IO_ item URL or ID to download."
        )
    ttl = resolve_ttl_hours(cache_ttl_hours)
    fetched, hit = cached_download(item_id, item_url, refresh=refresh, ttl_hours=ttl)
    body = fetched["body"]
    resolved_name = fetched["filename"]
    content_type = fetched["content_type"]
    dest = _download_dest(out, filename, resolved_name)
    dest.write_bytes(body)
    payload = {
        "item_id": item_id,
        "path": str(dest),
        "bytes": len(body),
        "filename": resolved_name,
        "content_type": content_type,
        "cache_hit": hit,
    }
    if as_json:
        click.echo(json.dumps(payload, indent=2))
        return
    click.echo(f"{dest} ({len(body)} bytes)")


@cli.command()
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
def collections(as_json: bool) -> None:
    """List the Michiganology digital collections (verified 2026-11-24)."""
    if as_json:
        click.echo(json.dumps(
            [{"name": name, "url": url} for name, url in COLLECTIONS], indent=2
        ))
        return
    for name, url in COLLECTIONS:
        click.echo(f"- {name}\n  {url}")


@cli.command()
@click.argument("query")
def url(query: str) -> None:
    """Print the shareable Michiganology search URL for a query."""
    click.echo(f"{BASE}/?s={quote_plus(query)}")


if __name__ == "__main__":
    cli()
