#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
# ]
# ///
"""Search Library of Congress Chronicling America historic newspapers.

Uses the public loc.gov JSON API (no key, no account). The retired
chroniclingamerica.loc.gov search API now 308-redirects away; do not use it
or third-party docs that describe it.

loc.gov collection searches are slow on the server side: measured
2026-11-25, connect + TLS took < 0.1 s but time-to-first-byte was 19-43 s
for every search (with or without q, dates, state, dl, at). The default
timeout budget is therefore 120 s, and every successful search is cached on
disk so a repeat never hits loc.gov again.
"""

from __future__ import annotations

from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
import hashlib
import json
import math
import os
import random
import re
import shutil
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator
from urllib.parse import parse_qs, urlencode, urlparse, urlunparse

import click
import httpx

COLLECTION_BASE = "https://www.loc.gov/collections/chronicling-america/"
USER_AGENT = "kinloom/1.0 (genealogy research; +https://github.com/Tiberriver256/kinloom)"
HEADERS = {
    "User-Agent": USER_AGENT,
    "Accept": "application/json",
}
# tile.loc.gov (storage-services PDFs) rejects hotlinking: it requires a
# loc.gov Referer. Send one for all file downloads; harmless elsewhere.
DOWNLOAD_HEADERS = {
    "User-Agent": USER_AGENT,
    "Referer": "https://www.loc.gov/",
}
# Measured 2026-11-25: loc.gov search TTFB is 19-43 s. An 8 s budget made
# 80%+ of searches fail. One probe under 6 parallel requests took 70 s,
# so 120 s covers the observed tail with headroom.
DEFAULT_TIMEOUT = 120.0
DOWNLOAD_TIMEOUT = 60.0
CONNECT_TIMEOUT = 15.0
SEARCH_ATTEMPT_READ_CAP = 65.0
MAX_ATTEMPTS = 4
RETRYABLE_STATUS_CODES = {429, 500, 502, 503, 504, 520, 522, 524}
MAX_RETRY_AFTER_S = 30.0
COLLECTION_START_YEAR = "1736"
COLLECTION_END_YEAR = "1963"
DEFAULT_CACHE_TTL_HOURS = 168.0
CACHE_SCHEMA = 1
_HTML_ERROR_PREFIXES = (b"<!doctype html", b"<html", b"<head", b"<body", b"<title")
_JPEG_MAGIC = b"\xff\xd8\xff"
_PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
_JP2_MAGICS = (b"\x00\x00\x00\x0cjP", b"\xff\x4f\xff\x51")

US_STATES = {
    "AL": "alabama", "AK": "alaska", "AZ": "arizona", "AR": "arkansas",
    "CA": "california", "CO": "colorado", "CT": "connecticut", "DE": "delaware",
    "DC": "district of columbia", "FL": "florida", "GA": "georgia", "HI": "hawaii",
    "ID": "idaho", "IL": "illinois", "IN": "indiana", "IA": "iowa", "KS": "kansas",
    "KY": "kentucky", "LA": "louisiana", "ME": "maine", "MD": "maryland",
    "MA": "massachusetts", "MI": "michigan", "MN": "minnesota", "MS": "mississippi",
    "MO": "missouri", "MT": "montana", "NE": "nebraska", "NV": "nevada",
    "NH": "new hampshire", "NJ": "new jersey", "NM": "new mexico", "NY": "new york",
    "NC": "north carolina", "ND": "north dakota", "OH": "ohio", "OK": "oklahoma",
    "OR": "oregon", "PA": "pennsylvania", "PR": "puerto rico", "RI": "rhode island",
    "SC": "south carolina", "SD": "south dakota", "TN": "tennessee", "TX": "texas",
    "UT": "utah", "VT": "vermont", "VA": "virginia", "VI": "virgin islands",
    "WA": "washington", "WV": "west virginia", "WI": "wisconsin", "WY": "wyoming",
}


# --- disk cache ---------------------------------------------------------------

def cache_dir() -> Path:
    override = os.environ.get("KINLOOM_CHRONAM_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-chronam"


def resolve_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).")
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_CHRONAM_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(f"Invalid KINLOOM_CHRONAM_CACHE_TTL_HOURS value: {raw!r}.") from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_CHRONAM_CACHE_TTL_HOURS value: {raw!r} (must be >= 0).")
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive lock (POSIX flock); no-op where fcntl is missing."""
    try:
        import fcntl
    except ImportError:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def atomic_write_json(dest: Path, payload: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def cache_key(url: str, params: list[tuple[str, str]] | None) -> str:
    canonical = json.dumps([url, sorted(params or [])], separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_cache(path: Path, ttl_hours: float) -> dict | None:
    if not path.is_file():
        return None
    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    if not isinstance(fetched, (int, float)):
        return None
    if ttl_hours <= 0 or (time.time() - fetched) > ttl_hours * 3600:
        return None
    data = entry.get("data")
    return data if isinstance(data, dict) else None


def atomic_write_bytes(dest: Path, data: bytes) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def atomic_copy_file(src: Path, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        shutil.copyfile(src, tmp)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def validate_loc_url(url: str) -> str:
    """Allow only HTTPS URLs on loc.gov or *.loc.gov with no credentials."""
    text = (url or "").strip()
    if not text or "\x00" in text or any(ord(ch) < 32 for ch in text):
        raise click.ClickException(f"Invalid URL: {url!r}")
    parsed = urlparse(text)
    host = (parsed.hostname or "").lower()
    if (
        parsed.scheme != "https"
        or not host
        or parsed.port not in (None, 443)
        or parsed.username
        or parsed.password
    ):
        raise click.ClickException(f"Refusing to access non-HTTPS or disallowed URL: {text}")
    if host != "loc.gov" and not host.endswith(".loc.gov"):
        raise click.ClickException(f"Refusing to access non-loc.gov host {host!r}: {text}")
    return text


def _detect_invalid_download(head: bytes, content_type: str, *, kind: str) -> str | None:
    """Refuse HTML error pages and corrupt payloads for newspaper assets."""
    ct_lower = (content_type or "").lower()
    if "text/html" in ct_lower or "application/xhtml" in ct_lower:
        return f"HTML error page ({content_type})"
    sample = head[:512].lstrip(b"\xef\xbb\xbf \t\r\n").lower()
    if any(sample.startswith(prefix) for prefix in _HTML_ERROR_PREFIXES):
        return "HTML error page"
    if kind == "pdf" and not head.startswith(b"%PDF-"):
        return "non-PDF payload"
    if kind == "image" and not (head.startswith(_JPEG_MAGIC) or head.startswith(_PNG_MAGIC)):
        return "non-image payload"
    if kind == "jp2" and not any(head.startswith(magic) for magic in _JP2_MAGICS):
        return "non-JP2 payload"
    return None


def _validate_download_file(path: Path, *, url: str, content_type: str, kind: str) -> int:
    try:
        nbytes = path.stat().st_size
    except OSError as exc:
        raise click.ClickException(f"Failed reading downloaded file for {url}: {exc}") from exc
    if nbytes <= 0:
        raise click.ClickException(f"Download was empty: {url}")
    with path.open("rb") as fh:
        head = fh.read(512)
    reason = _detect_invalid_download(head, content_type, kind=kind)
    if reason is not None:
        raise click.ClickException(f"Refusing {reason} when downloading {url}")
    return nbytes


class _IncompleteDownloadError(RuntimeError):
    """Raised when a streamed download ends before Content-Length bytes arrive."""


def resolve_safe_child(root: Path, filename: str) -> Path:
    """Resolve one filename strictly inside root."""
    if (
        not filename
        or "\x00" in filename
        or "/" in filename
        or "\\" in filename
        or ":" in filename
        or filename in (".", "..")
        or ".." in filename
    ):
        raise click.ClickException(f"Unsafe filename: {filename!r}")
    root_resolved = root.resolve()
    dest = (root_resolved / filename).resolve()
    if dest == root_resolved or not dest.is_relative_to(root_resolved):
        raise click.ClickException(f"Unsafe path escaping {root}: {filename!r}")
    return dest


def safe_output_filename(raw: str) -> str:
    """Turn an output name into one path segment. Reject traversal."""
    candidate = (raw or "").replace("\\", "/")
    base = candidate.rsplit("/", 1)[-1].strip().replace("..", "_")
    base = re.sub(r"[^A-Za-z0-9._-]+", "_", base).strip("._")
    if not base or base in {".", ".."} or ".." in base or "/" in base or "\\" in base:
        base = "page.bin"
    return base


def _file_cache_paths(url: str) -> tuple[Path, Path, Path]:
    key = hashlib.sha256(url.encode("utf-8")).hexdigest()
    root = cache_dir() / "files"
    return (
        resolve_safe_child(root, f"{key}.bin"),
        resolve_safe_child(root, f"{key}.json"),
        resolve_safe_child(root, f"{key}.lock"),
    )


def _read_cached_file_meta(
    bin_path: Path,
    meta_path: Path,
    ttl_hours: float,
    *,
    kind: str = "bin",
    url: str = "",
) -> dict[str, Any] | None:
    if ttl_hours <= 0 or not bin_path.is_file():
        return None
    try:
        entry = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    nbytes = entry.get("nbytes")
    if not isinstance(fetched, (int, float)) or not isinstance(nbytes, int) or nbytes <= 0:
        return None
    if (time.time() - fetched) > ttl_hours * 3600:
        return None
    content_type = str(entry.get("content_type") or "")
    try:
        actual = _validate_download_file(
            bin_path, url=url or str(entry.get("url") or ""), content_type=content_type, kind=kind
        )
    except click.ClickException:
        return None
    if actual != nbytes:
        return None
    return {"nbytes": actual, "content_type": content_type}


def _read_cached_file(bin_path: Path, meta_path: Path, ttl_hours: float) -> bytes | None:
    meta = _read_cached_file_meta(bin_path, meta_path, ttl_hours)
    if meta is None:
        return None
    try:
        return bin_path.read_bytes()
    except OSError:
        return None


def _new_http_client(*, headers: dict[str, str], timeout: float) -> httpx.Client:
    effective = max(1.0, float(timeout))
    return httpx.Client(
        headers=headers,
        timeout=httpx.Timeout(
            connect=min(CONNECT_TIMEOUT, effective),
            read=effective,
            write=min(30.0, effective),
            pool=min(15.0, effective),
        ),
        follow_redirects=True,
    )


def _stream_download_to_path(
    url: str,
    dest_path: Path,
    *,
    timeout: float,
    kind: str = "bin",
    client: httpx.Client | None = None,
) -> dict[str, Any]:
    validated_url = validate_loc_url(url)
    dest_path.parent.mkdir(parents=True, exist_ok=True)
    deadline = time.monotonic() + max(1.0, float(timeout))
    last_exc: Exception | None = None

    def _run(http_client: httpx.Client) -> dict[str, Any]:
        nonlocal last_exc
        for attempt in range(MAX_ATTEMPTS):
            remaining = deadline - time.monotonic()
            if remaining <= 0.25:
                break
            tmp = dest_path.with_name(f".{dest_path.name}.{os.getpid()}.{time.time_ns()}.tmp")
            attempt_timeout = httpx.Timeout(
                connect=min(CONNECT_TIMEOUT, remaining),
                read=remaining,
                write=min(30.0, remaining),
                pool=min(15.0, remaining),
            )
            try:
                with http_client.stream(
                    "GET", validated_url, headers=DOWNLOAD_HEADERS, timeout=attempt_timeout
                ) as resp:
                    if resp.url is not None:
                        validate_loc_url(str(resp.url))
                    if resp.status_code in RETRYABLE_STATUS_CODES:
                        last_exc = httpx.HTTPStatusError(
                            f"HTTP {resp.status_code}", request=resp.request, response=resp
                        )
                        wait = _retry_delay_seconds(attempt, resp)
                        tmp.unlink(missing_ok=True)
                        if attempt + 1 < MAX_ATTEMPTS and (deadline - time.monotonic()) >= wait + 1.0:
                            time.sleep(wait)
                            continue
                        kind_err = "rate limited" if resp.status_code == 429 else "transient service error"
                        raise click.ClickException(
                            f"Failed downloading {validated_url}: HTTP {resp.status_code} ({kind_err})."
                        )
                    resp.raise_for_status()
                    content_type = resp.headers.get("content-type", "").split(";", 1)[0].strip()
                    content_encoding = resp.headers.get("content-encoding", "").strip().lower()
                    raw_len = resp.headers.get("content-length", "").strip()
                    expected_len: int | None = None
                    if raw_len and (not content_encoding or content_encoding == "identity"):
                        try:
                            parsed_len = int(raw_len)
                            if parsed_len > 0:
                                expected_len = parsed_len
                        except ValueError:
                            expected_len = None
                    written = 0
                    with tmp.open("wb") as fh:
                        for chunk in resp.iter_bytes():
                            if chunk:
                                fh.write(chunk)
                                written += len(chunk)
                if expected_len is not None and written < expected_len:
                    raise _IncompleteDownloadError(
                        f"Incomplete download ({written} of {expected_len} bytes)"
                    )
                nbytes = _validate_download_file(
                    tmp, url=validated_url, content_type=content_type, kind=kind
                )
                os.replace(tmp, dest_path)
                return {"nbytes": nbytes, "content_type": content_type}
            except click.ClickException:
                tmp.unlink(missing_ok=True)
                raise
            except httpx.HTTPStatusError as exc:
                tmp.unlink(missing_ok=True)
                raise click.ClickException(
                    f"Failed downloading {validated_url}: HTTP {exc.response.status_code}"
                ) from exc
            except (httpx.TimeoutException, httpx.TransportError, _IncompleteDownloadError) as exc:
                tmp.unlink(missing_ok=True)
                last_exc = exc
                wait = _retry_delay_seconds(attempt, None)
                if attempt + 1 < MAX_ATTEMPTS and (deadline - time.monotonic()) >= wait + 1.0:
                    time.sleep(wait)
                    continue
                raise click.ClickException(f"Failed downloading {validated_url}: {exc}") from exc
            except Exception:
                tmp.unlink(missing_ok=True)
                raise

        raise click.ClickException(
            f"Failed downloading {validated_url} after {timeout:.1f}s: {last_exc}"
        )

    if client is not None:
        return _run(client)
    with _new_http_client(headers=DOWNLOAD_HEADERS, timeout=timeout) as managed_client:
        return _run(managed_client)


def _download_bytes(
    url: str,
    *,
    timeout: float,
    kind: str = "bin",
    client: httpx.Client | None = None,
) -> bytes:
    validated_url = validate_loc_url(url)
    bin_dir = cache_dir() / "files"
    bin_dir.mkdir(parents=True, exist_ok=True)
    tmp_target = bin_dir / f".dl.{os.getpid()}.{time.time_ns()}.bin"
    try:
        _stream_download_to_path(
            validated_url, tmp_target, timeout=timeout, kind=kind, client=client
        )
        return tmp_target.read_bytes()
    finally:
        tmp_target.unlink(missing_ok=True)


_DEFAULT_DOWNLOAD_BYTES = _download_bytes


def cached_download_file(
    url: str,
    *,
    timeout: float,
    refresh: bool,
    ttl_hours: float,
    kind: str = "bin",
    client: httpx.Client | None = None,
) -> tuple[Path, int, str, bool]:
    """Ensure url is cached on disk and return (cache_path, nbytes, content_type, cache_hit)."""
    validated_url = validate_loc_url(url)
    bin_path, meta_path, lock_path = _file_cache_paths(validated_url)
    if not refresh:
        hit = _read_cached_file_meta(bin_path, meta_path, ttl_hours, kind=kind, url=validated_url)
        if hit is not None:
            return bin_path, int(hit["nbytes"]), str(hit["content_type"]), True
    with file_lock(lock_path):
        if not refresh:
            hit = _read_cached_file_meta(bin_path, meta_path, ttl_hours, kind=kind, url=validated_url)
            if hit is not None:
                return bin_path, int(hit["nbytes"]), str(hit["content_type"]), True
        if _download_bytes is _DEFAULT_DOWNLOAD_BYTES:
            info = _stream_download_to_path(
                validated_url, bin_path, timeout=timeout, kind=kind, client=client
            )
            nbytes = int(info["nbytes"])
            content_type = str(info["content_type"])
        else:
            data = _download_bytes(validated_url, timeout=timeout)
            if not data:
                raise click.ClickException(f"Download was empty: {validated_url}")
            reason = _detect_invalid_download(data[:512], "", kind=kind)
            if reason is not None:
                raise click.ClickException(f"Refusing {reason} when downloading {validated_url}")
            atomic_write_bytes(bin_path, data)
            nbytes = len(data)
            content_type = ""
        atomic_write_json(
            meta_path,
            {
                "schema": CACHE_SCHEMA,
                "fetched_at": time.time(),
                "url": validated_url,
                "nbytes": nbytes,
                "content_type": content_type,
            },
        )
        return bin_path, nbytes, content_type, False


def cached_download_bytes(
    url: str,
    *,
    timeout: float,
    refresh: bool,
    ttl_hours: float,
    kind: str = "bin",
    client: httpx.Client | None = None,
) -> tuple[bytes, bool]:
    """Return (bytes, cache_hit). A hit copies from disk and makes no HTTP request."""
    bin_path, _nbytes, _ct, cache_hit = cached_download_file(
        url, timeout=timeout, refresh=refresh, ttl_hours=ttl_hours, kind=kind, client=client
    )
    return bin_path.read_bytes(), cache_hit


def cached_get_json(
    url: str,
    params: list[tuple[str, str]] | None,
    *,
    timeout: float,
    refresh: bool,
    ttl_hours: float,
    cacheable=lambda data: True,
    client: httpx.Client | None = None,
) -> tuple[dict, bool]:
    """Return (data, cache_hit). Concurrent callers of one query serialize on
    a per-key flock, so the second caller reads the first caller's result."""
    key = cache_key(url, params)
    root = cache_dir()
    path = root / f"{key}.json"
    if not refresh:
        hit = read_cache(path, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(root / f"{key}.lock"):
        if not refresh:
            hit = read_cache(path, ttl_hours)
            if hit is not None:
                return hit, True
        if client is not None:
            data = _get_json(url, params=params, timeout=timeout, client=client)
        else:
            data = _get_json(url, params=params, timeout=timeout)
        if cacheable(data):
            atomic_write_json(path, {"schema": CACHE_SCHEMA, "fetched_at": time.time(),
                                     "url": url, "params": params or [], "data": data})
        return data, False


# --- HTTP -----------------------------------------------------------------------

def _retry_after_seconds(resp: httpx.Response) -> float | None:
    raw = resp.headers.get("retry-after", "").strip()
    if not raw:
        return None
    try:
        parsed = float(raw)
        if math.isfinite(parsed):
            return max(0.0, min(parsed, MAX_RETRY_AFTER_S))
    except ValueError:
        try:
            dt = parsedate_to_datetime(raw)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            delta = (dt - datetime.now(timezone.utc)).total_seconds()
            if math.isfinite(delta):
                return max(0.0, min(delta, MAX_RETRY_AFTER_S))
        except (TypeError, ValueError, OverflowError):
            pass
    return None


def _retry_delay_seconds(attempt: int, resp: httpx.Response | None) -> float:
    """Compute jittered exponential backoff or honored Retry-After delay."""
    if resp is not None and resp.status_code in (429, 503):
        retry_after = _retry_after_seconds(resp)
        if retry_after is not None:
            return retry_after
    jitter = random.uniform(0.75, 1.25)
    return min(MAX_RETRY_AFTER_S, 0.5 * (2 ** attempt) * jitter)


def _get_json(
    url: str,
    params: dict | list[tuple[str, str]] | None = None,
    *,
    timeout: float = DEFAULT_TIMEOUT,
    client: httpx.Client | None = None,
) -> dict:
    validate_loc_url(url)
    deadline = time.monotonic() + max(0.5, float(timeout))
    split_read_timeout = timeout >= 90.0
    last_exc: Exception | None = None

    def _run(http_client: httpx.Client) -> dict:
        nonlocal last_exc
        for attempt in range(MAX_ATTEMPTS):
            remaining = deadline - time.monotonic()
            if remaining <= 0.25:
                break
            read_budget = (
                min(remaining, SEARCH_ATTEMPT_READ_CAP)
                if split_read_timeout
                else remaining
            )
            attempt_timeout = httpx.Timeout(
                connect=min(CONNECT_TIMEOUT, remaining),
                read=read_budget,
                write=min(30.0, remaining),
                pool=min(15.0, remaining),
            )
            try:
                resp = http_client.get(url, params=params, timeout=attempt_timeout)
            except httpx.ConnectTimeout as exc:
                last_exc = exc
                wait = _retry_delay_seconds(attempt, None)
                if attempt + 1 < MAX_ATTEMPTS and (deadline - time.monotonic()) >= wait + 2.0:
                    time.sleep(wait)
                    continue
                raise click.ClickException(
                    f"loc.gov request timed out after {timeout:.1f}s ({exc}). "
                    "loc.gov searches normally take 20-45 s; increase --timeout, "
                    "narrow with --state, --dates, or --lccn, "
                    "or open the browser URL from `chronam url`."
                ) from exc
            except httpx.TimeoutException as exc:
                last_exc = exc
                wait = _retry_delay_seconds(attempt, None)
                if (
                    split_read_timeout
                    and attempt + 1 < MAX_ATTEMPTS
                    and (deadline - time.monotonic()) >= wait + 5.0
                ):
                    time.sleep(wait)
                    continue
                raise click.ClickException(
                    f"loc.gov request timed out after {timeout:.1f}s ({exc}). "
                    "loc.gov searches normally take 20-45 s; increase --timeout, "
                    "narrow with --state, --dates, or --lccn, "
                    "or open the browser URL from `chronam url`."
                ) from exc
            except httpx.TransportError as exc:
                last_exc = exc
                wait = _retry_delay_seconds(attempt, None)
                if attempt + 1 < MAX_ATTEMPTS and (deadline - time.monotonic()) >= wait + 2.0:
                    time.sleep(wait)
                    continue
                raise click.ClickException(
                    f"loc.gov connection error: {exc}. "
                    "Retry once or narrow with --state/--dates/--lccn."
                ) from exc
            except httpx.HTTPError as exc:
                raise click.ClickException(f"loc.gov request failed: {exc}") from exc

            if resp.status_code in RETRYABLE_STATUS_CODES:
                last_exc = httpx.HTTPStatusError(
                    f"HTTP {resp.status_code}", request=resp.request, response=resp
                )
                wait = _retry_delay_seconds(attempt, resp)
                if attempt + 1 < MAX_ATTEMPTS and (deadline - time.monotonic()) >= wait + 2.0:
                    time.sleep(wait)
                    continue
                kind = "rate limited" if resp.status_code == 429 else "transient service error"
                raise click.ClickException(
                    f"loc.gov returned HTTP {resp.status_code} ({kind}). "
                    "Wait and retry, narrow with --state/--dates/--lccn, or open `chronam url` in a browser."
                )

            try:
                resp.raise_for_status()
            except httpx.HTTPStatusError as exc:
                raise click.ClickException(
                    f"loc.gov returned HTTP {resp.status_code} for {resp.request.url}"
                ) from exc

            try:
                return resp.json()
            except ValueError as exc:
                raise click.ClickException(
                    f"loc.gov returned non-JSON response (HTTP {resp.status_code}, "
                    f"content-type={resp.headers.get('content-type', 'unknown')})."
                ) from exc

        raise click.ClickException(
            f"loc.gov request failed after {timeout:.1f}s: {last_exc}"
        )

    if client is not None:
        return _run(client)
    with _new_http_client(headers=HEADERS, timeout=timeout) as managed_client:
        return _run(managed_client)


# --- query building ----------------------------------------------------------

def _resolve_query(words: tuple[str, ...], terms_opt: str | None) -> str:
    query = " ".join(w for w in words if w).strip() or (terms_opt or "").strip()
    if not query:
        raise click.UsageError("Provide QUERY words as positional arguments or via --terms/--query.")
    return query


def _resolve_dates(dates: str | None, date_from: str | None, date_to: str | None) -> str | None:
    if dates:
        cleaned = dates.strip().replace("-", "/")
        if re.fullmatch(r"\d{4}", cleaned):
            return f"{cleaned}/{cleaned}"
        if not re.fullmatch(r"\d{4}/\d{4}", cleaned):
            raise click.BadParameter(f"--dates {dates!r}: expected YYYY/YYYY (or YYYY).", param_hint="--dates")
        return cleaned
    if date_from or date_to:
        start = (date_from or COLLECTION_START_YEAR).strip()[:4]
        end = (date_to or COLLECTION_END_YEAR).strip()[:4]
        for label, year in (("start", start), ("end", end)):
            if not re.fullmatch(r"\d{4}", year):
                raise click.BadParameter(f"{label} year {year!r}: expected YYYY.")
        return f"{start}/{end}"
    return None


def normalize_state(state: str) -> str:
    cleaned = state.strip()
    return US_STATES.get(cleaned.upper(), cleaned).lower()


def build_search_params(query: str, *, dates: str | None, level: str, limit: int, page: int,
                        state: str | None, lccn: str | None) -> list[tuple[str, str]]:
    params: list[tuple[str, str]] = [
        ("q", query),
        ("fo", "json"),
        ("at", "search,results"),
        ("c", str(limit)),
        ("sp", str(page)),
    ]
    if level != "all":
        params.append(("dl", level))
    if dates:
        params.append(("dates", dates))
    if state:
        params.append(("fa", f"location_state:{normalize_state(state)}"))
    if lccn:
        params.append(("fa", f"number_lccn:{lccn.strip()}"))
    return params


def _first(value):
    if isinstance(value, list):
        return value[0] if value else None
    return value


def _compact_result(item: dict) -> dict:
    return {
        "title": _first(item.get("partof_title")) or item.get("title"),
        "date": item.get("date"),
        "state": _first(item.get("location_state")),
        "county": _first(item.get("location_county")),
        "city": _first(item.get("location_city")),
        "lccn": item.get("number_lccn"),
        "page": item.get("number_page"),
        "url": item.get("url"),
        "id": item.get("id"),
    }


def _print_search(data: dict, as_json: bool, cache_hit: bool) -> None:
    search = data.get("search") or {}
    hits = search.get("hits")
    results = data.get("results") or []
    if as_json:
        click.echo(json.dumps(
            {"hits": hits, "cache_hit": cache_hit, "results": [_compact_result(r) for r in results]},
            indent=2, ensure_ascii=False))
        return
    click.echo(f"hits: {hits} (showing {len(results)} on this page){' [cache]' if cache_hit else ''}")
    for item in results:
        c = _compact_result(item)
        click.echo(f"- {c['date']} | {c['title']} | {c['state']} | {c['url']}")


def _search_cacheable(data: dict) -> bool:
    # loc.gov sometimes answers a valid query with a transient 0-hit page
    # (measured 2026-11-25: "Abraham Lincoln" gave 0, then 25,392 on rerun).
    # Never cache an empty answer, so the next call asks loc.gov again.
    hits = (data.get("search") or {}).get("hits")
    return bool(hits) and bool(data.get("results"))


def _resource_url_json(resource_url: str) -> str:
    validated = validate_loc_url(resource_url)
    parsed = urlparse(validated)
    qs = parse_qs(parsed.query)
    qs.pop("q", None)
    qs["fo"] = ["json"]
    return urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))


def _extract_seq_from_url(resource_url: str, fallback: str = "1") -> str:
    parsed = urlparse(resource_url)
    values = parse_qs(parsed.query).get("sp")
    if values and values[0].strip():
        return values[0].strip()
    return fallback


def _iiif_jpeg_from_info(info_url: str, *, image_width: int | None) -> str | None:
    if not info_url or not info_url.endswith("/info.json"):
        return None
    base = info_url[: -len("/info.json")]
    size = f"{image_width}," if image_width is not None else "pct:50"
    return f"{base}/full/{size}/0/default.jpg"


def _resolve_page_assets(
    data: dict[str, Any], *, image_width: int | None = None
) -> dict[str, str | None]:
    """Resolve page-specific PDF, IIIF image, JP2, and ALTO XML URLs.

    Prefers the page-specific `page[]` array over issue-level `resources[0]`
    because loc.gov's `resources[0].image` stays pinned to page 1's 3.125%
    thumbnail even when requesting `sp=4`.
    """
    resources = (data.get("resources") or [{}])[0]
    if not isinstance(resources, dict):
        resources = {}
    page_entries = data.get("page") if isinstance(data.get("page"), list) else []

    pdf_url: str | None = None
    jp2_url: str | None = None
    xml_url: str | None = None
    iiif_image_url: str | None = None
    best_jpeg_url: str | None = None

    for entry in page_entries:
        if not isinstance(entry, dict):
            continue
        mime = str(entry.get("mimetype") or "").lower()
        entry_url = entry.get("url")
        info_url = entry.get("info")
        if mime == "application/pdf" and isinstance(entry_url, str) and not pdf_url:
            pdf_url = entry_url
        elif mime == "image/jp2" and isinstance(entry_url, str) and not jp2_url:
            jp2_url = entry_url
            if isinstance(info_url, str) and not iiif_image_url:
                iiif_image_url = _iiif_jpeg_from_info(info_url, image_width=image_width)
        elif mime == "text/xml" and isinstance(entry_url, str) and not xml_url:
            xml_url = entry_url
        elif mime == "image/jpeg" and isinstance(entry_url, str):
            best_jpeg_url = entry_url
        if isinstance(info_url, str) and not iiif_image_url:
            iiif_image_url = _iiif_jpeg_from_info(info_url, image_width=image_width)

    return {
        "pdf": pdf_url or resources.get("pdf"),
        "image": iiif_image_url or best_jpeg_url or resources.get("image"),
        "jp2": jp2_url,
        "text": resources.get("fulltext_file") or xml_url,
        "iiif_manifest_url": resources.get("iiif_manifest_url"),
    }


def _build_resource_url(lccn: str, date: str, edition: str, seq: str) -> str:
    return f"https://www.loc.gov/resource/{lccn}/{date}/ed-{edition}/?sp={seq}"


def _cache_options(f):
    f = click.option("--cache-ttl-hours", type=float, default=None,
                     help=f"Cache TTL in hours (default {DEFAULT_CACHE_TTL_HOURS:g}; "
                          "env KINLOOM_CHRONAM_CACHE_TTL_HOURS).")(f)
    f = click.option("--refresh", is_flag=True, help="Bypass the disk cache and re-query loc.gov.")(f)
    return f


def _query_options(f):
    for decorator in reversed([
        click.argument("query", nargs=-1),
        click.option("--terms", "--query", "-q", "terms_opt", default=None,
                     help="Alias for positional QUERY."),
        click.option("--dates", default=None, help="Date range YYYY/YYYY (or one year YYYY)."),
        click.option("--date-from", "--from-year", "--date1", "--year1", "--start", "date_from",
                     default=None, help="Start year YYYY (alternative to --dates)."),
        click.option("--date-to", "--to-year", "--date2", "--year2", "--end", "date_to",
                     default=None, help="End year YYYY (alternative to --dates)."),
        click.option("--level", default="page", type=click.Choice(["page", "issue", "title", "all"]),
                     show_default=True, help="Display level (dl=)."),
        click.option("--state", default=None,
                     help="State name or postal code (CA, NJ); sent as fa=location_state:<state>."),
        click.option("--lccn", default=None, help="Filter by newspaper LCCN via fa=number_lccn:<lccn>."),
    ]):
        f = decorator(f)
    return f


@click.group()
def cli() -> None:
    """Search Chronicling America historic newspapers (Library of Congress)."""


@cli.command()
@_query_options
@click.option("--limit", "--per-page", "--rows", "-n", default=10, show_default=True,
              help="Results per page (c=).")
@click.option("--page", "-p", default=1, show_default=True, help="Results page (sp=).")
@click.option("--timeout", default=DEFAULT_TIMEOUT, show_default=True, type=float,
              help="Request timeout budget in seconds (loc.gov search takes 20-45 s).")
@_cache_options
@click.option("--json", "as_json", is_flag=True, help="Emit JSON instead of compact text.")
def search(query, terms_opt, dates, date_from, date_to, level, state, lccn, limit, page,
           timeout, refresh, cache_ttl_hours, as_json):
    """Search newspaper pages for QUERY (full-text, e.g. a surname).

    Multi-word queries need no quotes: `chronam search Abraham Lincoln`.
    Results are cached on disk (~/.cache/kinloom-chronam, 168 h TTL).
    """
    resolved_query = _resolve_query(query, terms_opt)
    params = build_search_params(resolved_query, dates=_resolve_dates(dates, date_from, date_to),
                                 level=level, limit=limit, page=page, state=state, lccn=lccn)
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, cache_hit = cached_get_json(COLLECTION_BASE, params, timeout=timeout, refresh=refresh,
                                      ttl_hours=ttl, cacheable=_search_cacheable)
    results = data.get("results") or []
    hits = (data.get("search") or {}).get("hits")
    if hits and not results:
        click.echo(
            f"Warning: loc.gov reported {hits} total hits but returned 0 rows on page {page}. "
            "Check --page or retry once if loc.gov dropped facet results.",
            err=True,
        )
    elif not hits:
        click.echo(
            "Note: 0 hits. loc.gov sometimes returns a transient empty answer; empty results are "
            "never cached, so one rerun confirms a true zero.",
            err=True,
        )
    data["results"] = results
    _print_search(data, as_json, cache_hit)


def _run_get_page(
    resource_url: str | None,
    lccn: str | None,
    date: str | None,
    edition: str,
    seq: str,
    timeout: float,
    refresh: bool,
    cache_ttl_hours: float | None,
    as_json: bool,
) -> None:
    if resource_url is None:
        if not lccn or not date:
            raise click.UsageError("Give a resource URL or both --lccn and --date.")
        resource_url = _build_resource_url(lccn, date, edition, seq)
    data, hit = cached_get_json(_resource_url_json(resource_url), None, timeout=timeout,
                                refresh=refresh, ttl_hours=resolve_ttl_hours(cache_ttl_hours))
    if as_json:
        payload = {**data, "cache_hit": hit}
        click.echo(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    item = data.get("item") or {}
    resource = data.get("resource") or {}
    click.echo(f"title: {resource.get('title') or item.get('title')}{' [cache]' if hit else ''}")
    click.echo(f"date: {item.get('date')}")
    click.echo(f"lccn: {_first(item.get('number_lccn')) or item.get('lccn')}")
    click.echo(f"place: {_first(item.get('location_city'))}, {_first(item.get('location_state'))}")
    click.echo(f"url: {resource_url}")
    assets = _resolve_page_assets(data)
    for label, key in (
        ("pdf", "pdf"),
        ("image", "image"),
        ("jp2", "jp2"),
        ("fulltext_file", "text"),
        ("iiif_manifest_url", "iiif_manifest_url"),
    ):
        if assets.get(key):
            click.echo(f"{label}: {assets[key]}")


def _page_options(f):
    for decorator in reversed([
        click.argument("resource_url", required=False),
        click.option("--lccn", default=None, help="Newspaper LCCN, e.g. sn83045462."),
        click.option("--date", default=None, help="Issue date YYYY-MM-DD."),
        click.option("--edition", default="1", show_default=True),
        click.option("--seq", default="1", show_default=True, help="Page sequence within the issue (?sp=)."),
        click.option("--timeout", default=DEFAULT_TIMEOUT, show_default=True, type=float,
                     help="Request timeout budget in seconds."),
        _cache_options,
        click.option("--json", "as_json", is_flag=True, help="Emit the item JSON with boolean cache_hit."),
    ]):
        f = decorator(f)
    return f


@cli.command("get")
@_page_options
def get(resource_url, lccn, date, edition, seq, timeout, refresh, cache_ttl_hours, as_json):
    """Show metadata and download links for one newspaper page.

    Give a loc.gov resource URL, or build one with --lccn --date [--edition --seq].
    """
    _run_get_page(resource_url, lccn, date, edition, seq, timeout, refresh, cache_ttl_hours, as_json)


@cli.command("page")
@_page_options
def page_cmd(resource_url, lccn, date, edition, seq, timeout, refresh, cache_ttl_hours, as_json):
    """Alias for `get`: show metadata and download links for one newspaper page."""
    _run_get_page(resource_url, lccn, date, edition, seq, timeout, refresh, cache_ttl_hours, as_json)


@cli.command()
@click.argument("resource_url", required=False)
@click.option("--lccn", default=None)
@click.option("--date", default=None, help="Issue date YYYY-MM-DD.")
@click.option("--edition", default="1", show_default=True)
@click.option("--seq", default=None, help="Page sequence within the issue (defaults to ?sp= or 1).")
@click.option("--out", "--out-dir", "-o", "out", default=".", show_default=True, help="Output directory.")
@click.option("--pdf/--no-pdf", default=True, show_default=True, help="Download the page PDF (falls back to IIIF JPEG if no PDF exists).")
@click.option("--image/--no-image", default=False, show_default=True,
              help="Download the page IIIF JPEG image.")
@click.option("--image-width", default=None, type=click.IntRange(100, 10000),
              help="IIIF JPEG pixel width (100..10000); defaults to pct:50 when resolved from IIIF info.")
@click.option("--jp2/--no-jp2", default=False, show_default=True,
              help="Download the archival JP2 scan when listed on the page.")
@click.option("--text/--no-text", default=False, show_default=True,
              help="Download the ALTO XML word-coordinates file (OCR full text).")
@click.option("--timeout", default=DOWNLOAD_TIMEOUT, show_default=True, type=float,
              help="Download timeout in seconds.")
@_cache_options
@click.option("--json", "as_json", is_flag=True, help="Emit structured JSON including boolean cache_hit.")
def download(resource_url, lccn, date, edition, seq, out, pdf, image, image_width, jp2, text,
             timeout, refresh, cache_ttl_hours, as_json):
    """Download a newspaper page (PDF, IIIF image, JP2, OCR) plus metadata.json."""
    if resource_url is None:
        if not lccn or not date:
            raise click.UsageError("Give a resource URL or both --lccn and --date.")
        resolved_seq = seq or "1"
        resource_url = _build_resource_url(lccn, date, edition, resolved_seq)
    else:
        resolved_seq = seq or _extract_seq_from_url(resource_url, fallback="1")
    ttl = resolve_ttl_hours(cache_ttl_hours)
    resource_json_url = _resource_url_json(resource_url)
    outdir = Path(out)
    if ".." in outdir.parts and not outdir.is_absolute():
        raise click.ClickException(f"Unsafe output directory containing '..': {outdir}")
    outdir.mkdir(parents=True, exist_ok=True)

    with _new_http_client(headers=HEADERS, timeout=timeout) as shared_client:
        data, meta_hit = cached_get_json(
            resource_json_url,
            None,
            timeout=timeout,
            refresh=refresh,
            ttl_hours=ttl,
            client=shared_client,
        )
        item = data.get("item") or {}
        stem = safe_output_filename(
            f"{_first(item.get('number_lccn')) or 'loc'}_{item.get('date') or 'nodate'}_sp{resolved_seq}"
        )
        assets = _resolve_page_assets(data, image_width=image_width)
        jobs: list[tuple[str, str, str]] = []
        if pdf and assets.get("pdf"):
            jobs.append(("pdf", str(assets["pdf"]), f"{stem}.pdf"))
        elif pdf and not image and assets.get("image"):
            jobs.append(("image", str(assets["image"]), f"{stem}.jpg"))
        if image and assets.get("image"):
            jobs.append(("image", str(assets["image"]), f"{stem}.jpg"))
        if jp2 and assets.get("jp2"):
            jobs.append(("jp2", str(assets["jp2"]), f"{stem}.jp2"))
        if text and assets.get("text"):
            jobs.append(("text", str(assets["text"]), f"{stem}.alto.xml"))
        if not jobs:
            click.echo("No downloadable resources found for this page.", err=True)
            sys.exit(1)

        downloaded_files: list[dict[str, Any]] = []
        total_bytes = 0
        for kind, url, filename in jobs:
            safe_name = safe_output_filename(filename)
            dest = resolve_safe_child(outdir, safe_name)
            cache_path, nbytes, content_type, file_hit = cached_download_file(
                url,
                timeout=timeout,
                refresh=refresh,
                ttl_hours=ttl,
                kind=kind,
                client=shared_client,
            )
            atomic_copy_file(cache_path, dest)
            total_bytes += nbytes
            downloaded_files.append(
                {
                    "kind": kind,
                    "url": url,
                    "path": str(dest),
                    "bytes": nbytes,
                    "content_type": content_type,
                    "cache_hit": file_hit,
                }
            )
            if not as_json:
                marker = " [cache]" if file_hit else ""
                click.echo(f"{kind}: {dest} ({nbytes} bytes){marker}")

    meta_name = safe_output_filename(f"{stem}.metadata.json")
    meta_path = resolve_safe_child(outdir, meta_name)
    atomic_write_bytes(
        meta_path,
        json.dumps(
            {"resource_url": resource_url, "item": item, "resources": data.get("resources")},
            indent=2,
            ensure_ascii=False,
        ).encode("utf-8"),
    )
    if as_json:
        all_hit = bool(meta_hit and downloaded_files and all(f["cache_hit"] for f in downloaded_files))
        click.echo(
            json.dumps(
                {
                    "resource_url": resource_url,
                    "out_dir": str(outdir),
                    "metadata_path": str(meta_path),
                    "metadata_cache_hit": meta_hit,
                    "bytes": total_bytes,
                    "cache_hit": all_hit,
                    "files": downloaded_files,
                },
                indent=2,
                ensure_ascii=False,
            )
        )
        return
    click.echo(f"metadata: {meta_path}")


@cli.command()
@_query_options
def url(query, terms_opt, dates, date_from, date_to, level, state, lccn):
    """Print the loc.gov website search URL for QUERY (open in a browser)."""
    resolved_query = _resolve_query(query, terms_opt)
    params = build_search_params(resolved_query, dates=_resolve_dates(dates, date_from, date_to),
                                 level=level, limit=10, page=1, state=state, lccn=lccn)
    browser = [(k, v) for k, v in params if k not in ("fo", "at", "c", "sp")]
    click.echo(COLLECTION_BASE + "?" + urlencode(browser))


if __name__ == "__main__":
    cli()
