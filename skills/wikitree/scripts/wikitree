#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
# ]
# ///
"""Compact CLI for the public WikiTree API (https://api.wikitree.com/api.php).

Read-only. No account or API key is needed for public profiles; every call
sends an appId (WikiTree rate-limits calls without one). See
skills/wikitree/SKILL.md for the API reference and rules.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Callable, Iterator

import click
import httpx

DEFAULT_CACHE_TTL_HOURS = 168.0
CACHE_SCHEMA = 1

API_BASE = "https://api.wikitree.com/api.php"
DEFAULT_APP_ID = "Kinloom"
DEFAULT_FIELDS = "Id,Name,FirstName,LastNameAtBirth,BirthDate,DeathDate,BirthLocation"


def cache_dir() -> Path:
    override = os.environ.get("KINLOOM_WIKITREE_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-wikitree"


def resolve_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).")
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_WIKITREE_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(f"Invalid KINLOOM_WIKITREE_CACHE_TTL_HOURS value: {raw!r}.") from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_WIKITREE_CACHE_TTL_HOURS value: {raw!r} (must be >= 0)."
            )
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive lock (POSIX flock); no-op where fcntl is missing."""
    try:
        import fcntl
    except ImportError:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def atomic_write_json(dest: Path, payload: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def cache_key(kind: str, payload: dict) -> str:
    canonical = json.dumps([kind, payload], sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_cache(path: Path, ttl_hours: float) -> dict | None:
    if not path.is_file():
        return None
    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    if not isinstance(fetched, (int, float)):
        return None
    if ttl_hours <= 0 or (time.time() - fetched) > ttl_hours * 3600:
        return None
    result = entry.get("result")
    return result if isinstance(result, dict) else None


def cached_call(
    kind: str,
    payload: dict,
    fetch: Callable[[], dict],
    *,
    refresh: bool,
    ttl_hours: float,
    cacheable: Callable[[dict], bool] = lambda _r: True,
) -> tuple[dict, bool]:
    """Return (result, cache_hit) with per-key flock and atomic JSON writes."""
    key = cache_key(kind, payload)
    root = cache_dir()
    path = root / f"{key}.json"
    if not refresh:
        hit = read_cache(path, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(root / f"{key}.lock"):
        if not refresh:
            hit = read_cache(path, ttl_hours)
            if hit is not None:
                return hit, True
        result = fetch()
        if cacheable(result):
            atomic_write_json(
                path,
                {
                    "schema": CACHE_SCHEMA,
                    "fetched_at": time.time(),
                    "kind": kind,
                    "query": payload,
                    "result": result,
                },
            )
        return result, False


def cache_options(func: Callable) -> Callable:
    func = click.option(
        "--cache-ttl-hours",
        type=float,
        default=None,
        help="Cache TTL in hours (default 168, env KINLOOM_WIKITREE_CACHE_TTL_HOURS; 0 disables reads).",
    )(func)
    func = click.option(
        "--refresh",
        is_flag=True,
        help="Bypass the disk cache for this request (the fresh result is still cached).",
    )(func)
    return func


def _app_id() -> str:
    return os.environ.get("WIKITREE_APP_ID", DEFAULT_APP_ID)


def _client() -> httpx.Client:
    return httpx.Client(timeout=30.0)


def api_call(params: dict) -> list:
    """One GET against the WikiTree API; returns the decoded JSON array."""
    full_params = {"appId": _app_id(), **params}
    try:
        with _client() as client:
            resp = client.get(API_BASE, params=full_params)
            resp.raise_for_status()
    except httpx.HTTPError as exc:
        raise click.ClickException(f"WikiTree API request failed: {exc}") from exc
    try:
        data = resp.json()
    except ValueError as exc:
        raise click.ClickException("WikiTree API returned non-JSON") from exc
    if not isinstance(data, list):
        raise click.ClickException(f"Unexpected API response: {data!r}")
    return data


def _cached_api(
    kind: str,
    params: dict,
    label: str,
    *,
    refresh: bool,
    ttl_hours: float,
    cacheable: Callable[[list], bool] = lambda d: bool(d),
) -> tuple[list, dict, bool]:
    def _fetch() -> dict:
        data = api_call(params)
        check_status(data, label)
        return {"data": data}

    wrapped, hit = cached_call(
        kind,
        params,
        _fetch,
        refresh=refresh,
        ttl_hours=ttl_hours,
        cacheable=lambda r: isinstance(r.get("data"), list) and cacheable(r["data"]),
    )
    data = wrapped["data"]
    first = check_status(data, label)
    return data, first, hit


def _json_with_cache_hit(data: list, hit: bool) -> list:
    if data and isinstance(data[0], dict):
        return [{**data[0], "cache_hit": hit}, *data[1:]]
    return data


def check_status(data: list, label: str) -> dict:
    """Raise on a non-zero status element; return the first element."""
    if not data:
        raise click.ClickException(f"{label}: empty response from WikiTree API")
    first = data[0]
    status = first.get("status", 0)
    if status != 0 and status != "":
        raise click.ClickException(f"{label}: {status}")
    return first


def show_person(person: dict) -> None:
    """One compact line per profile, with unknown dates shown as such."""
    name = person.get("Name") or person.get("Id", "?")
    first = person.get("FirstName", "")
    last = person.get("LastNameAtBirth") or person.get("LastNameCurrent", "")
    birth = person.get("BirthDate") or ""
    death = person.get("DeathDate") or ""
    birth = "" if birth in ("", "0000-00-00") else birth
    death = "" if death in ("", "0000-00-00") else death
    place = person.get("BirthLocation", "")
    dates = f"b. {birth}" if birth else "b. ?"
    if death:
        dates += f" d. {death}"
    line = f"{name}: {first} {last} ({dates})"
    if place:
        line += f", born {place}"
    click.echo(line.strip())


_WIKITREE_URL_RE = re.compile(
    r"^https?://(?:www\.)?wikitree\.com/wiki/([^/?#]+)(?:[?#].*)?$",
    re.IGNORECASE,
)


def _normalize_profile_key(raw: str) -> str:
    cleaned = raw.strip()
    match = _WIKITREE_URL_RE.fullmatch(cleaned)
    if match:
        return match.group(1)
    return cleaned


def _resolve_search_name(
    query_parts: tuple[str, ...],
    full_name: str | None,
    first_name: str | None,
    last_name: str | None,
) -> tuple[str | None, str | None]:
    pos_tokens = [tok for part in query_parts for tok in part.strip().split() if tok]
    name_tokens = [tok for tok in (full_name or "").strip().split() if tok]
    if pos_tokens and name_tokens:
        raise click.UsageError("Pass either positional name arguments or --name, not both.")
    tokens = name_tokens or pos_tokens
    if not tokens:
        return first_name, last_name
    if first_name and last_name:
        raise click.UsageError(
            "Pass either positional name / --name or --first/--last, not both."
        )
    if first_name and not last_name:
        return first_name, " ".join(tokens)
    if last_name and not first_name:
        return " ".join(tokens), last_name
    if len(tokens) == 1:
        return None, tokens[0]
    return " ".join(tokens[:-1]), tokens[-1]


@click.group(context_settings={"help_option_names": ["-h", "--help"]})
def cli() -> None:
    """Read public WikiTree profiles (search, person/get/show/profile, ancestors, bio)."""


@cli.command()
@click.argument("query_parts", nargs=-1, metavar="[NAME...]")
@click.option("--name", "full_name", default=None, help="Full name (split into first and last name).")
@click.option("--first", "--first-name", "--given", "--given-name", "first_name", default=None, help="First name.")
@click.option("--last", "--last-name", "--surname", "last_name", default=None, help="Last name.")
@click.option("--birth-date", "--birth-year", "--born", "birth_date", default=None, help="Birth date or year (YYYY or YYYY-MM-DD).")
@click.option("--death-date", "--death-year", "--died", "death_date", default=None, help="Death date or year (YYYY or YYYY-MM-DD).")
@click.option("--birth-location", "--birth-place", "--place", "birth_location", default=None, help="Birth location.")
@click.option("--death-location", "--death-place", "death_location", default=None, help="Death location.")
@click.option("--date-include", type=click.Choice(["both", "neither"]),
              default=None, help="'both' requires dates on matches.")
@click.option("-n", "--limit", "--rows", "limit", type=click.IntRange(1, 100), default=10,
              show_default=True, help="Results to return (1-100).")
@click.option("--start", "--offset", "start", type=int, default=None,
              help="0-based result offset for paging (default: 0).")
@click.option("--page", type=click.IntRange(min=1), default=None,
              help="1-based page number (alternative to --start/--offset).")
@click.option("--fields", default=DEFAULT_FIELDS, show_default=True,
              help="Comma-separated profile fields, or '*'.")
@click.option("--json", "as_json", is_flag=True, help="Print raw JSON.")
@cache_options
def search(query_parts, full_name, first_name, last_name, birth_date, death_date, birth_location,
           death_location, date_include, limit, start, page, fields, as_json,
           refresh, cache_ttl_hours):
    """Search person profiles, e.g. search --first Abraham --last Lincoln."""
    if start is not None and start < 0:
        raise click.BadParameter(f"Invalid --start/--offset value: {start!r} (must be >= 0).")
    if page is not None and start is not None:
        raise click.UsageError("Pass either --page or --start/--offset, not both.")
    resolved_start = start if start is not None else ((page - 1) * limit if page is not None else 0)
    first_name, last_name = _resolve_search_name(query_parts, full_name, first_name, last_name)
    if not any([first_name, last_name, birth_date, death_date,
                birth_location, death_location]):
        raise click.UsageError(
            "Provide a name or filter: e.g. `search Abraham Lincoln`, `search --first Abraham --last Lincoln`, "
            "or --birth-date/--death-date/--birth-location/--death-location."
        )
    params: dict = {"action": "searchPerson", "limit": limit, "start": resolved_start,
                    "fields": fields}
    if first_name:
        params["FirstName"] = first_name
    if last_name:
        params["LastName"] = last_name
    if birth_date:
        params["BirthDate"] = birth_date
    if death_date:
        params["DeathDate"] = death_date
    if birth_location:
        params["BirthLocation"] = birth_location
    if death_location:
        params["DeathLocation"] = death_location
    if date_include:
        params["dateInclude"] = date_include
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, first, hit = _cached_api(
        "search",
        params,
        "searchPerson",
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda d: bool(d) and isinstance(d[0], dict) and (
            isinstance(d[0].get("matches"), list) or isinstance(d[0].get("total"), int)
        ),
    )
    if as_json:
        click.echo(json.dumps(_json_with_cache_hit(data, hit), indent=2))
        return
    matches = first.get("matches", [])
    marker = " [cache]" if hit else ""
    click.echo(f"{first.get('total', len(matches))} match(es), showing {len(matches)}:{marker}")
    for match in matches:
        if "Name" in match or "FirstName" in match:
            show_person(match)
        else:
            # Sparse match (Id only): flag it so the caller follows up.
            click.echo(f"Id {match.get('Id')}: sparse match, run `person {match.get('Id')}` for details")


@cli.command()
@click.argument("key")
@click.option("--fields", default=DEFAULT_FIELDS, show_default=True,
              help="Comma-separated profile fields, or '*'.")
@click.option("--bio-format", type=click.Choice(["wiki", "html", "both"]),
              default=None, help="Include Bio in this format.")
@click.option("--resolve-redirect", is_flag=True,
              help="Follow merged-profile redirects.")
@click.option("--json", "as_json", is_flag=True, help="Print raw JSON.")
@cache_options
def person(key, fields, bio_format, resolve_redirect, as_json, refresh, cache_ttl_hours):
    """Fetch one person by WikiTree ID (e.g. <Surname>-<Number>), numeric Id, or URL (aliases: get, show, profile)."""
    key = _normalize_profile_key(key)
    params: dict = {"action": "getPerson", "key": key, "fields": fields}
    if bio_format:
        params["bioFormat"] = bio_format
        if "Bio" not in fields.split(",") and fields != "*":
            params["fields"] = fields + ",Bio"
    if resolve_redirect:
        params["resolveRedirect"] = 1
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, first, hit = _cached_api(
        "person",
        params,
        f"getPerson {key}",
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda d: bool(d) and isinstance(d[0], dict) and bool(
            d[0].get("person") or d[0].get("profile")
        ),
    )
    if as_json:
        click.echo(json.dumps(_json_with_cache_hit(data, hit), indent=2))
        return
    profile = first.get("person") or first.get("profile")
    if not profile:
        raise click.ClickException(f"getPerson {key}: no profile returned")
    if hit:
        name = profile.get("Name") or profile.get("Id", "?")
        first_n = profile.get("FirstName", "")
        last = profile.get("LastNameAtBirth") or profile.get("LastNameCurrent", "")
        birth = profile.get("BirthDate") or ""
        death = profile.get("DeathDate") or ""
        birth = "" if birth in ("", "0000-00-00") else birth
        death = "" if death in ("", "0000-00-00") else death
        place = profile.get("BirthLocation", "")
        dates = f"b. {birth}" if birth else "b. ?"
        if death:
            dates += f" d. {death}"
        line = f"{name}: {first_n} {last} ({dates})"
        if place:
            line += f", born {place}"
        click.echo(f"{line.strip()} [cache]")
    else:
        show_person(profile)
    if bio_format and profile.get("Bio"):
        click.echo(profile["Bio"])


cli.add_command(person, name="get")
cli.add_command(person, name="show")
cli.add_command(person, name="profile")


@cli.command()
@click.argument("key")
@click.option("--depth", type=click.IntRange(1, 10), default=4,
              show_default=True, help="Generations to follow (1-10).")
@click.option("--fields", default=DEFAULT_FIELDS, show_default=True,
              help="Comma-separated profile fields, or '*'.")
@click.option("--json", "as_json", is_flag=True, help="Print raw JSON.")
@cache_options
def ancestors(key, depth, fields, as_json, refresh, cache_ttl_hours):
    """Fetch ancestors of KEY, following father and mother.

    Uses getPeople with ancestors=N: the standalone getAncestors action
    is deprecated (the API returns an error telling callers to use
    getPeople instead). The people dict includes the subject profile
    itself, so it is excluded from the listing.
    """
    key = _normalize_profile_key(key)
    params = {"action": "getPeople", "keys": key, "ancestors": depth, "fields": fields}
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, first, hit = _cached_api(
        "ancestors",
        params,
        f"getPeople {key}",
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda d: bool(d) and isinstance(d[0], dict) and isinstance(d[0].get("people"), dict),
    )
    if as_json:
        click.echo(json.dumps(_json_with_cache_hit(data, hit), indent=2))
        return
    people = first.get("people", {})
    subject = (first.get("resultByKey") or {}).get(key, {})
    subject_id = str(subject.get("Id", ""))
    profiles = [p for pid, p in people.items() if pid != subject_id]
    profiles.sort(key=lambda p: (p.get("BirthDate") or "9999",
                                 p.get("Name") or ""))
    marker = " [cache]" if hit else ""
    click.echo(f"{len(profiles)} ancestor(s) within {depth} generation(s) of {key}:{marker}")
    for profile in profiles:
        show_person(profile)


@cli.command()
@click.argument("key")
@click.option("--format", "bio_format", type=click.Choice(["wiki", "html", "both"]),
              default="wiki", show_default=True, help="Biography format.")
@click.option("--json", "as_json", is_flag=True, help="Print raw JSON.")
@cache_options
def bio(key, bio_format, as_json, refresh, cache_ttl_hours):
    """Fetch the biography text of KEY (default wiki markup)."""
    key = _normalize_profile_key(key)
    params = {"action": "getBio", "key": key, "bioFormat": bio_format}
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, first, hit = _cached_api(
        "bio",
        params,
        f"getBio {key}",
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda d: bool(d) and isinstance(d[0], dict) and ("bio" in d[0]),
    )
    if as_json:
        click.echo(json.dumps(_json_with_cache_hit(data, hit), indent=2))
        return
    text = first.get("bio") or ""
    if not text:
        click.echo("(no biography text returned)" + (" [cache]" if hit else ""))
    else:
        click.echo(text)


if __name__ == "__main__":
    cli()
