#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
# ]
# ///
"""Search the Allen County Public Library Genealogy Center's free PERSI
(Periodical Source Index) from the command line.

PERSI is a citation index, not a full-text archive: a hit gives the article
title, periodical, year, and publisher, plus a free link when the issue is
online and copyright-clear. Use the citation to find the article through a
library, WorldCat, or the Genealogy Center's article copy service.

All three search modes are plain POST forms on genealogycenter.info, verified
live 2026-11-24. No account, key, or sign-in is required.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import sys
import time
from contextlib import contextmanager
from html.parser import HTMLParser
from pathlib import Path
from typing import Any, Callable, Iterator

import click
import httpx

DEFAULT_CACHE_TTL_HOURS = 168.0
CACHE_SCHEMA = 1

BASE = "https://www.genealogycenter.info"
SEARCH_PAGE = BASE + "/persi/"
SURNAME_URL = BASE + "/results_persisurname.php"
TITLE_URL = BASE + "/results_persiarttitle.php"
LOCATION_URL = BASE + "/results_persilocation.php"
USER_AGENT = "Mozilla/5.0"
RETRY_WAIT_S = 5.0
# The Genealogy Center's front door intermittently 412/429s python-httpx's
# default header set. Plain curl-style headers (short UA, Accept */*) plus
# a Referer return 200 consistently; fetch() also retries once on 412/429.

US_STATES = {
    "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "DC", "FL", "GA", "HI",
    "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN",
    "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH",
    "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA",
    "WV", "WI", "WY", "GEN",
}


def cache_dir() -> Path:
    override = os.environ.get("KINLOOM_PERSI_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-persi"


def resolve_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).")
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_PERSI_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(f"Invalid KINLOOM_PERSI_CACHE_TTL_HOURS value: {raw!r}.") from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_PERSI_CACHE_TTL_HOURS value: {raw!r} (must be >= 0)."
            )
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive lock (POSIX flock); no-op where fcntl is missing."""
    try:
        import fcntl
    except ImportError:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def atomic_write_json(dest: Path, payload: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def cache_key(kind: str, payload: dict) -> str:
    canonical = json.dumps([kind, payload], sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_cache(path: Path, ttl_hours: float) -> dict | None:
    if not path.is_file():
        return None
    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    if not isinstance(fetched, (int, float)):
        return None
    if ttl_hours <= 0 or (time.time() - fetched) > ttl_hours * 3600:
        return None
    result = entry.get("result")
    return result if isinstance(result, dict) else None


def cached_call(
    kind: str,
    payload: dict,
    fetch: Callable[[], dict],
    *,
    refresh: bool,
    ttl_hours: float,
    cacheable: Callable[[dict], bool] = lambda _r: True,
) -> tuple[dict, bool]:
    """Return (result, cache_hit) with per-key flock and atomic JSON writes."""
    key = cache_key(kind, payload)
    root = cache_dir()
    path = root / f"{key}.json"
    if not refresh:
        hit = read_cache(path, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(root / f"{key}.lock"):
        if not refresh:
            hit = read_cache(path, ttl_hours)
            if hit is not None:
                return hit, True
        result = fetch()
        if cacheable(result):
            atomic_write_json(
                path,
                {
                    "schema": CACHE_SCHEMA,
                    "fetched_at": time.time(),
                    "kind": kind,
                    "query": payload,
                    "result": result,
                },
            )
        return result, False


def cache_options(func: Callable) -> Callable:
    func = click.option(
        "--cache-ttl-hours",
        type=float,
        default=None,
        help="Cache TTL in hours (default 168, env KINLOOM_PERSI_CACHE_TTL_HOURS; 0 disables reads).",
    )(func)
    func = click.option(
        "--refresh",
        is_flag=True,
        help="Bypass the disk cache for this request (the fresh result is still cached).",
    )(func)
    return func


def _client(headers: dict[str, str]) -> httpx.Client:
    return httpx.Client(headers=headers, timeout=60.0, follow_redirects=True)


class TableParser(HTMLParser):
    """Collect rows of the first <table> whose cells look like PERSI results."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.in_table = False
        self.in_row = False
        self.in_cell = False
        self.current_row: list[str] = []
        self.current_cell = ""
        self.current_links: list[str] = []
        self.cell_links: list[list[str]] = []
        self.rows: list[dict] = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "table":
            self.in_table = True
        if not self.in_table:
            return
        if tag == "tr":
            self.in_row = True
            self.current_row = []
            self.cell_links = []
        elif tag in ("td", "th") and self.in_row:
            self.in_cell = True
            self.current_cell = ""
            self.current_links = []
        elif tag == "a" and self.in_cell:
            href = attrs.get("href", "")
            if href:
                self.current_links.append(href)

    def handle_endtag(self, tag):
        if tag == "table":
            self.in_table = False
        if not self.in_table and tag != "table":
            return
        if tag in ("td", "th") and self.in_cell:
            self.in_cell = False
            self.current_row.append(" ".join(self.current_cell.split()))
            self.cell_links.append(list(self.current_links))
        elif tag == "tr" and self.in_row:
            self.in_row = False
            if self.current_row:
                self.rows.append(
                    {"cells": self.current_row, "links": self.cell_links}
                )

    def handle_data(self, data):
        if self.in_cell:
            self.current_cell += data


def fetch(url: str, data: dict, referer: str) -> str:
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "*/*",
        "Accept-Encoding": "identity",
        "Referer": referer,
    }
    last_exc: Exception | None = None
    for attempt in (1, 2):
        try:
            with _client(headers) as client:
                resp = client.post(url, data=data)
                if resp.status_code in (412, 429) and attempt == 1:
                    if RETRY_WAIT_S > 0:
                        time.sleep(RETRY_WAIT_S)
                    continue
                resp.raise_for_status()
                return resp.text
        except httpx.HTTPError as exc:
            last_exc = exc
    raise click.ClickException(f"PERSI request failed: {last_exc}") from last_exc


def parse_articles(page: str) -> list[dict]:
    parser = TableParser()
    parser.feed(page)
    articles = []
    for row in parser.rows:
        cells = row["cells"]
        if len(cells) < 3:
            continue
        if cells[0].lower().startswith("article title"):
            continue
        free_links = [
            link
            for cell in row["links"]
            for link in cell
            if link.startswith("http")
        ]
        articles.append(
            {
                "title": cells[0],
                "periodical": cells[1] if len(cells) > 1 else "",
                "year": cells[2] if len(cells) > 2 else "",
                "publisher": cells[3] if len(cells) > 3 else "",
                "free_link": free_links[0] if free_links else None,
            }
        )
    return articles


def parse_categories(page: str) -> list[dict]:
    parser = TableParser()
    parser.feed(page)
    categories = []
    for row in parser.rows:
        cells = row["cells"]
        if len(cells) == 2 and cells[1].replace(",", "").isdigit():
            if cells[0].lower().startswith("category"):
                continue
            categories.append(
                {"category": cells[0], "articles": int(cells[1].replace(",", ""))}
            )
    return categories


def emit(items: list[dict], as_json: bool, limit: int, *, cache_hit: bool = False) -> None:
    items = items[:limit]
    if as_json:
        click.echo(json.dumps(items, indent=2))
        return
    marker = " [cache]" if cache_hit else ""
    if not items:
        click.echo(f"No results.{marker}")
        return
    for item in items:
        if "articles" in item:
            click.echo(f"{item['articles']:>6}  {item['category']}")
        else:
            line = (
                f"{item['title']} | {item['periodical']} | "
                f"{item['year']} | {item['publisher']}"
            )
            click.echo(line)
            if item.get("free_link"):
                click.echo(f"       free online: {item['free_link']}")
    click.echo(f"({len(items)} shown){marker}")


@click.group()
def cli() -> None:
    """Search ACPL's free PERSI (Periodical Source Index)."""


@cli.command()
@click.argument("surname")
@click.option("--limit", default=25, show_default=True, help="Max results to show.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def surname(
    surname: str,
    limit: int,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Search PERSI by surname, e.g. persi surname Lincoln."""
    ttl = resolve_ttl_hours(cache_ttl_hours)

    def _fetch() -> dict:
        page = fetch(
            SURNAME_URL,
            {"surname": surname, "sort": "title", "submit": "Search"},
            BASE + "/search_persisurname.php",
        )
        return {"articles": parse_articles(page)}

    data, hit = cached_call(
        "surname",
        {"surname": surname.strip().lower()},
        _fetch,
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda r: bool(r.get("articles")),
    )
    emit(data.get("articles") or [], as_json, limit, cache_hit=hit)


@cli.command()
@click.argument("keyword")
@click.option("--limit", default=25, show_default=True, help="Max results to show.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def title(
    keyword: str,
    limit: int,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Search PERSI by article-title keyword, e.g. persi title Lincoln."""
    ttl = resolve_ttl_hours(cache_ttl_hours)

    def _fetch() -> dict:
        page = fetch(
            TITLE_URL,
            {"keyword": keyword, "sort": "title", "submit": "Search"},
            BASE + "/search_persiarttitle.php",
        )
        return {"articles": parse_articles(page)}

    data, hit = cached_call(
        "title",
        {"keyword": keyword.strip().lower()},
        _fetch,
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda r: bool(r.get("articles")),
    )
    emit(data.get("articles") or [], as_json, limit, cache_hit=hit)


@cli.command()
@click.option("--state", required=True, help="Two-letter state code, e.g. MI. GEN for US general.")
@click.option("--county", default="", help="County name (optional; leave blank for statewide).")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
def location(
    state: str,
    county: str,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """List PERSI article counts by category for a state/county.

    Returns category counts, not articles: pick a category on the website
    to drill into its articles.
    """
    state = state.upper()
    if state not in US_STATES:
        raise click.ClickException(f"Unknown state code: {state}")
    ttl = resolve_ttl_hours(cache_ttl_hours)

    def _fetch() -> dict:
        page = fetch(
            LOCATION_URL,
            {
                "subloc": "USA",
                "cosearch": "USA",
                "usloc": state,
                "county": county,
                "submit": "Search",
            },
            BASE + "/search_persilocation.php",
        )
        return {"categories": parse_categories(page)}

    data, hit = cached_call(
        "location",
        {"state": state, "county": county.strip().lower()},
        _fetch,
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=lambda r: bool(r.get("categories")),
    )
    cats = data.get("categories") or []
    if not cats:
        click.echo(
            "No category counts returned. The county value may not match "
            "PERSI's list; try a blank county (statewide) or check the "
            "website form."
        )
        sys.exit(1)
    emit(cats, as_json, len(cats), cache_hit=hit)


@cli.command("search")
@click.argument("query", required=False, default=None)
@click.option("--surname", "surname_opt", default=None, help="Search by surname (alias for `persi surname`).")
@click.option("--title", "title_opt", default=None, help="Search by article-title keyword (alias for `persi title`).")
@click.option("--state", default=None, help="Two-letter state code for location counts (alias for `persi location`).")
@click.option("--county", default="", help="County name (used with --state).")
@click.option("--limit", default=25, show_default=True, help="Max results to show.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON.")
@cache_options
@click.pass_context
def search_cmd(
    ctx: click.Context,
    query: str | None,
    surname_opt: str | None,
    title_opt: str | None,
    state: str | None,
    county: str,
    limit: int,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Convenience router to `surname`, `title`, or `location` search."""
    if state and (query or surname_opt or title_opt):
        raise click.UsageError(
            "PERSI's surname and title forms do not accept a --state filter. "
            "Use `persi surname <SURNAME>`, `persi title <KEYWORD>`, or `persi location --state <ST>` separately."
        )
    if state:
        ctx.invoke(
            location,
            state=state,
            county=county,
            as_json=as_json,
            refresh=refresh,
            cache_ttl_hours=cache_ttl_hours,
        )
        return
    if title_opt:
        ctx.invoke(
            title,
            keyword=title_opt,
            limit=limit,
            as_json=as_json,
            refresh=refresh,
            cache_ttl_hours=cache_ttl_hours,
        )
        return
    target_surname = surname_opt or query
    if target_surname:
        ctx.invoke(
            surname,
            surname=target_surname,
            limit=limit,
            as_json=as_json,
            refresh=refresh,
            cache_ttl_hours=cache_ttl_hours,
        )
        return
    raise click.UsageError("Pass a surname, --title <KEYWORD>, or --state <ST>.")


@cli.command()
@click.argument("mode", type=click.Choice(["surname", "title", "location"]))
def url(mode: str) -> None:
    """Print the PERSI website search page for a mode (POST forms have no shareable result URL)."""
    pages = {
        "surname": BASE + "/search_persisurname.php",
        "title": BASE + "/search_persiarttitle.php",
        "location": BASE + "/search_persilocation.php",
    }
    click.echo(pages[mode])


if __name__ == "__main__":
    cli()
