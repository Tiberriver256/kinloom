#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
#   "pyyaml>=6.0",
# ]
# ///
"""narrative-audio: turn Kinloom narrative biographies into narrated MP3s.

Workflow (see ../SKILL.md):
  1. `list` / `extract`  read narratives from an archive's data/narratives.yaml (free)
  2. an agent writes a spoken script + IPA names file by hand (free; see
     ../references/script-rules.md)
  3. `check`             lint the script and names file (free)
  4. `synth`             Chirp 3: HD (default) or Gemini TTS -> MP3: story voice,
                         then "Editor's notes" in a second voice (paid API call)
  5. `transcribe`        optional verification transcript (paid API call)

Backends:
  - chirp3-hd (default): Google Cloud Text-to-Speech API (`texttospeech.googleapis.com`)
    using Chirp 3: HD voices (`en-US-Chirp3-HD-Charon` / `Kore`) and structured
    `customPronunciations` IPA dictionaries. Auth via `gcloud auth print-access-token`
    (with `--gcp-project` / `GOOGLE_CLOUD_PROJECT`) or `GOOGLE_CLOUD_TTS_API_KEY`.
  - gemini: Gemini TTS (`gemini-3.8-flash-tts`) via `GEMINI_API_KEY` / `GOOGLE_API_KEY`
    or `--key-file`, using inline `/IPA/` substitutions.

Requires ffmpeg on PATH.
"""

from __future__ import annotations

import base64
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import wave
from pathlib import Path

import click
import httpx
import yaml

API = "https://generativelanguage.googleapis.com/v1beta/models"
CLOUD_TTS_API = "https://texttospeech.googleapis.com/v1/text:synthesize"
DEFAULT_BACKEND = "chirp3-hd"
DEFAULT_LANGUAGE = "en-US"
DEFAULT_TTS_MODEL = "gemini-3.8-flash-tts"
DEFAULT_TEXT_MODEL = "gemini-4-hydrogen"
CHIRP_MAX_BYTES = 4500  # Cloud TTS synchronous limit is 5,000 bytes; leave headroom
NOTES_MARKER = "# EDITOR'S NOTES"

MONTHS = ("January|February|March|April|May|June|July|August|September|October|"
          "November|December")
_ORD = ("first second third fourth fifth sixth seventh eighth ninth tenth eleventh "
        "twelfth thirteenth fourteenth fifteenth sixteenth seventeenth eighteenth "
        "nineteenth twentieth").split()


# --------------------------------------------------------------------------- helpers

def ordinal(n: int) -> str:
    if n <= 20:
        return _ORD[n - 1]
    if n == 30:
        return "thirtieth"
    return ("twenty-" if n < 30 else "thirty-") + _ORD[n % 10 - 1]


def speak_dates(text: str) -> str:
    """'9 May 1766' / 'May 9, 1766' / '9 May' -> 'May ninth, 1766' / 'May ninth'."""
    text = re.sub(
        rf"\b(\d{{1,2}})(?:st|nd|rd|th)? ({MONTHS})(,? (\d{{4}}))?\b",
        lambda m: f"{m.group(2)} {ordinal(int(m.group(1)))}"
        + (f", {m.group(4)}" if m.group(4) else ""),
        text,
    )
    return re.sub(
        rf"\b({MONTHS}) (\d{{1,2}})(?:st|nd|rd|th)?\b",
        lambda m: f"{m.group(1)} {ordinal(int(m.group(2)))}",
        text,
    )


def apply_names(text: str, names: dict[str, str]) -> str:
    """Replace each name with its IPA string, longest keys first, whole words only."""
    for name, ipa in sorted(names.items(), key=lambda kv: -len(kv[0])):
        text = re.sub(rf"(?<![\w/]){re.escape(name)}(?![\w/])", ipa, text)
    return text


def build_chirp_pronunciations(text: str, names: dict[str, str]) -> list[dict[str, str]]:
    """Build Cloud TTS `customPronunciations` entries for names present in `text`."""
    entries: list[dict[str, str]] = []
    for phrase, ipa in sorted(names.items(), key=lambda kv: -len(kv[0])):
        if re.search(rf"(?<!\w){re.escape(phrase)}(?!\w)", text):
            cleaned_ipa = ipa.strip().strip("/")
            entries.append({
                "phrase": phrase,
                "phoneticEncoding": "PHONETIC_ENCODING_IPA",
                "pronunciation": cleaned_ipa,
            })
    return entries


def resolve_chirp_voice(voice: str, language_code: str) -> str:
    """Expand short voice names like 'Charon' to 'en-US-Chirp3-HD-Charon'."""
    if "-" in voice:
        return voice
    return f"{language_code}-Chirp3-HD-{voice}"


def split_to_byte_limit(text: str, max_bytes: int = CHIRP_MAX_BYTES) -> list[str]:
    """Split a long section on paragraph/sentence boundaries to stay under byte limits."""
    if len(text.encode("utf-8")) <= max_bytes:
        return [text]
    parts: list[str] = []
    current: list[str] = []
    current_bytes = 0
    for para in [p.strip() for p in text.split("\n\n") if p.strip()]:
        para_bytes = len(para.encode("utf-8"))
        if current and current_bytes + para_bytes + 2 > max_bytes:
            parts.append("\n\n".join(current))
            current = [para]
            current_bytes = para_bytes
        else:
            current.append(para)
            current_bytes += para_bytes + (2 if len(current) > 1 else 0)
    if current:
        parts.append("\n\n".join(current))
    return parts


def split_script(script: str) -> tuple[list[str], list[str]]:
    story, _, notes = script.partition(NOTES_MARKER)
    sections = [s.strip() for s in re.split(r"(?m)^(?=## )", story) if s.strip()]
    sections = [re.sub(r"^##\s*(.+)$", r"\1.", s, flags=re.M) for s in sections]
    note_items = [re.sub(r"^\s*[-*]\s*", "", n).strip()
                  for n in notes.strip().splitlines() if n.strip()]
    return sections, note_items


def api_key(key_file: str | None) -> str:
    if key_file:
        return Path(key_file).expanduser().read_text().strip()
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if not key:
        raise click.ClickException(
            "Set GEMINI_API_KEY (or GOOGLE_API_KEY), or pass --key-file.")
    return key


def cloud_tts_headers(gcp_project: str | None, key_file: str | None) -> dict[str, str]:
    """Resolve auth headers for Google Cloud Text-to-Speech API."""
    if key_file:
        return {"x-goog-api-key": Path(key_file).expanduser().read_text().strip()}
    if env_key := os.environ.get("GOOGLE_CLOUD_TTS_API_KEY"):
        return {"x-goog-api-key": env_key}
    token = os.environ.get("GOOGLE_CLOUD_ACCESS_TOKEN")
    if not token:
        if not shutil.which("gcloud"):
            raise click.ClickException(
                "gcloud not found on PATH; install gcloud or set GOOGLE_CLOUD_TTS_API_KEY / --key-file."
            )
        res = subprocess.run(
            ["gcloud", "auth", "print-access-token"],
            capture_output=True, text=True, check=False,
        )
        if res.returncode != 0 or not res.stdout.strip():
            raise click.ClickException(
                f"Failed to get gcloud access token: {res.stderr.strip() or 'run gcloud auth login'}"
            )
        token = res.stdout.strip()
    project = (
        gcp_project
        or os.environ.get("GOOGLE_CLOUD_PROJECT")
        or os.environ.get("GCP_PROJECT")
    )
    if not project and shutil.which("gcloud"):
        res = subprocess.run(
            ["gcloud", "config", "get-value", "project"],
            capture_output=True, text=True, check=False,
        )
        val = res.stdout.strip()
        if res.returncode == 0 and val and val != "(unset)":
            project = val
    headers = {"Authorization": f"Bearer {token}"}
    if project:
        headers["x-goog-user-project"] = project
    return headers


def generate(key: str, model: str, body: dict, retries: int = 3) -> dict:
    for attempt in range(retries + 1):
        r = httpx.post(f"{API}/{model}:generateContent", json=body,
                       headers={"x-goog-api-key": key}, timeout=600)
        if r.status_code in (429, 500, 502, 503, 504) and attempt < retries:
            time.sleep(5 * (attempt + 1))
            continue
        if r.status_code != 200:
            raise click.ClickException(f"{model}: HTTP {r.status_code}: {r.text[:800]}")
        return r.json()
    raise AssertionError("unreachable")


def synthesize_chirp(headers: dict[str, str], body: dict, retries: int = 3) -> dict:
    for attempt in range(retries + 1):
        r = httpx.post(CLOUD_TTS_API, json=body, headers=headers, timeout=180)
        if r.status_code in (429, 500, 502, 503, 504) and attempt < retries:
            time.sleep(5 * (attempt + 1))
            continue
        if r.status_code != 200:
            raise click.ClickException(f"cloud-tts: HTTP {r.status_code}: {r.text[:800]}")
        return r.json()
    raise AssertionError("unreachable")


def strip_wav_header(raw: bytes, default_rate: int = 24000) -> tuple[bytes, int]:
    """Strip RIFF/WAV header if present so joined PCM chunks have no click/burst."""
    if raw[:4] == b"RIFF":
        with wave.open(io.BytesIO(raw)) as w:
            return w.readframes(w.getnframes()), w.getframerate()
    return raw, default_rate


def load_narratives(path: str) -> list[dict]:
    data = yaml.safe_load(Path(path).read_text())
    return data if isinstance(data, list) else data.get("narratives", [])


# --------------------------------------------------------------------------- CLI

@click.group()
def cli() -> None:
    """Narrate Kinloom narrative biographies with Chirp 3: HD or Gemini TTS."""


@cli.command("list")
@click.argument("narratives_yaml", type=click.Path(exists=True))
@click.option("--kind", default="biography", show_default=True)
def list_cmd(narratives_yaml: str, kind: str) -> None:
    """List narratives (word count, id, title), shortest first."""
    rows = [(len((n.get("body_md") or "").split()), n["id"], n.get("title", ""))
            for n in load_narratives(narratives_yaml) if not kind or n.get("kind") == kind]
    for words, nid, title in sorted(rows):
        click.echo(f"{words:6d}  {nid}  {title}")


@cli.command()
@click.argument("narratives_yaml", type=click.Path(exists=True))
@click.argument("narrative_id")
def extract(narratives_yaml: str, narrative_id: str) -> None:
    """Print one narrative's slug, title and body_md (input for the script writer)."""
    n = next((n for n in load_narratives(narratives_yaml) if n["id"] == narrative_id), None)
    if not n:
        raise click.ClickException(f"no narrative with id {narrative_id}")
    click.echo(f"SLUG: {n.get('slug', narrative_id)}\nTITLE: {n.get('title', '')}\n")
    click.echo(n.get("body_md", ""))


@cli.command()
@click.argument("script", type=click.Path(exists=True))
@click.option("--names", type=click.Path(exists=True), help="IPA names JSON")
def check(script: str, names: str | None) -> None:
    """Lint a spoken script (and names file) before paying for synthesis."""
    text = Path(script).read_text()
    problems: list[str] = []
    patterns = {
        "day-before-month date (write 'May ninth, 1766')": rf"\b\d{{1,2}} ({MONTHS})\b",
        "numeric month-day date (write 'May ninth')": rf"\b({MONTHS}) \d{{1,2}}\b(?!\d)",
        "currency symbol (write '470 pounds')": r"[£$]",
        "s./d. money abbreviation": r"\b\d+[sd]\.",
        "citation remnant": r"\b(Lib\.|Vol\.|pp?\.\s*\d|DB \d|FHL|Book \d+)",
        "slash (write 'or')": r"\S/\S",
        "abbreviation to spell out": r"\b(ca\.|b\.|d\.|decd|Co\.|Jr\.|Sr\.|Capt\.)(?=\s|$)",
        "markdown emphasis or link": r"[*_`]|\]\(",
        "quotation mark": r"[\"“”]",
    }
    for i, line in enumerate(text.splitlines(), 1):
        for label, pat in patterns.items():
            if re.search(pat, line):
                problems.append(f"{script}:{i}: {label}: {line.strip()[:100]}")
    if NOTES_MARKER not in text:
        problems.append(f"no '{NOTES_MARKER}' section (fine only if there are no notes)")
    if names:
        mapping = json.loads(Path(names).read_text())
        for k, v in mapping.items():
            if not re.search(rf"(?<!\w){re.escape(k)}(?!\w)", text):
                problems.append(f"names: '{k}' does not appear in the script")
            if not (v.startswith("/") and v.endswith("/")):
                problems.append(f"names: '{k}' value is not /IPA/ in slashes: {v}")
    sections, notes = split_script(text)
    click.echo(f"{len(sections)} story sections, {len(notes)} notes, "
               f"{len(text.split())} words")
    for p in problems:
        click.echo(p)
    if problems:
        sys.exit(1)
    click.echo("ok")


@cli.command()
@click.argument("script", type=click.Path(exists=True))
@click.option("--names", type=click.Path(exists=True), help="IPA names JSON")
@click.option("-o", "--out", type=click.Path(), help="output .mp3 (default: next to script)")
@click.option(
    "--backend",
    type=click.Choice(["chirp3-hd", "gemini"], case_sensitive=False),
    default=DEFAULT_BACKEND,
    envvar="NARRATIVE_AUDIO_BACKEND",
    show_default=True,
    help="TTS engine: chirp3-hd (Google Cloud TTS) or gemini (Gemini TTS)",
)
@click.option(
    "--language-code",
    default=DEFAULT_LANGUAGE,
    envvar="NARRATIVE_AUDIO_LANGUAGE",
    show_default=True,
    help="BCP-47 language code for chirp3-hd voices",
)
@click.option(
    "--gcp-project",
    default=None,
    envvar="GOOGLE_CLOUD_PROJECT",
    help="GCP project ID for chirp3-hd billing quota header (defaults to gcloud config)",
)
@click.option("--model", default=DEFAULT_TTS_MODEL, show_default=True,
              help="Gemini TTS model (used when --backend gemini)")
@click.option("--voice", default="Charon", show_default=True, help="story voice")
@click.option("--notes-voice", default="Kore", show_default=True, help="editor's notes voice")
@click.option("--section-pause", default=0.8, show_default=True, type=float)
@click.option("--notes-pause", default=2.0, show_default=True, type=float)
@click.option("--bitrate", default="96k", show_default=True)
@click.option("--key-file", type=click.Path(), help="file containing the API key")
@click.option("--dry-run", is_flag=True, help="print the exact payload/text each request would send")
def synth(script, names, out, backend, language_code, gcp_project, model, voice, notes_voice,
          section_pause, notes_pause, bitrate, key_file, dry_run) -> None:
    """Synthesize SCRIPT to MP3 (story voice, then editor's notes voice)."""
    backend = backend.lower()
    raw_text = Path(script).read_text()
    names_map: dict[str, str] = json.loads(Path(names).read_text()) if names else {}

    # For Gemini TTS, substitute inline /IPA/ into text; for Chirp 3: HD, pass
    # structured customPronunciations so prose stays unmodified.
    prepared = apply_names(raw_text, names_map) if (backend == "gemini" and names_map) else raw_text
    prepared = speak_dates(prepared)
    sections, notes = split_script(prepared)

    # Build (text, voice, pause_before, is_notes) chunks
    chunks: list[tuple[str, str, float, bool]] = []
    for s in sections:
        sub_chunks = split_to_byte_limit(s) if backend == "chirp3-hd" else [s]
        for idx, sub in enumerate(sub_chunks):
            chunks.append((sub, voice, section_pause if idx == 0 else 0.4, False))
    if notes:
        notes_body = "Editor's notes.\n\n" + "\n\n".join(notes)
        sub_notes = split_to_byte_limit(notes_body) if backend == "chirp3-hd" else [notes_body]
        for idx, sub in enumerate(sub_notes):
            chunks.append((sub, notes_voice, notes_pause if idx == 0 else 0.4, True))

    if dry_run:
        for i, (t, v, _, is_notes) in enumerate(chunks, 1):
            label = resolve_chirp_voice(v, language_code) if backend == "chirp3-hd" else f"{model}:{v}"
            click.echo(f"===== request {i} [{backend} · {label}{' · notes' if is_notes else ''}] =====")
            click.echo(t)
            if backend == "chirp3-hd" and names_map:
                prons = build_chirp_pronunciations(t, names_map)
                if prons:
                    click.echo(f"  customPronunciations: {json.dumps(prons)}")
            click.echo("")
        return

    if not shutil.which("ffmpeg"):
        raise click.ClickException("ffmpeg not found on PATH")

    out_path = Path(out) if out else Path(script).with_suffix("").with_suffix(".mp3")
    pcm, rate, total_tokens, total_chars = b"", 24000, 0, 0
    notes_start_sec: float | None = None

    if backend == "chirp3-hd":
        headers = cloud_tts_headers(gcp_project, key_file)
        for i, (t, v, pause, is_notes) in enumerate(chunks, 1):
            resolved_voice = resolve_chirp_voice(v, language_code)
            payload: dict = {
                "input": {"text": t},
                "voice": {"languageCode": language_code, "name": resolved_voice},
                "audioConfig": {"audioEncoding": "LINEAR16", "sampleRateHertz": 24000},
            }
            if names_map:
                prons = build_chirp_pronunciations(t, names_map)
                if prons:
                    payload["input"]["customPronunciations"] = {"pronunciations": prons}
            resp = synthesize_chirp(headers, payload)
            raw, chunk_rate = strip_wav_header(base64.b64decode(resp["audioContent"]), default_rate=24000)
            rate = chunk_rate
            if pcm:
                pcm += b"\x00\x00" * int(rate * pause)
            if is_notes and notes_start_sec is None:
                notes_start_sec = len(pcm) / 2 / rate
            pcm += raw
            total_chars += len(t)
            click.echo(
                f"  section {i}/{len(chunks)} [{resolved_voice}]: {len(t.split())} words, "
                f"{len(raw) / 2 / rate:.1f}s, {len(t)} chars",
                err=True,
            )
    else:
        key = api_key(key_file)
        for i, (t, v, pause, is_notes) in enumerate(chunks, 1):
            # Send ONLY the words to speak. These TTS models read any style direction aloud,
            # and reject systemInstruction ("Developer instruction is not enabled").
            resp = generate(key, model, {
                "contents": [{"parts": [{"text": t}]}],
                "generationConfig": {
                    "responseModalities": ["AUDIO"],
                    "speechConfig": {"voiceConfig": {"prebuiltVoiceConfig": {"voiceName": v}}},
                },
            })
            part = resp["candidates"][0]["content"]["parts"][0]["inlineData"]
            raw = base64.b64decode(part["data"])
            if raw[:4] == b"RIFF":
                raw, rate = strip_wav_header(raw, default_rate=rate)
            elif m := re.search(r"rate=(\d+)", part.get("mimeType", "")):
                rate = int(m.group(1))
            if pcm:
                pcm += b"\x00\x00" * int(rate * pause)
            if is_notes and notes_start_sec is None:
                notes_start_sec = len(pcm) / 2 / rate
            pcm += raw
            tokens = resp.get("usageMetadata", {}).get("totalTokenCount", 0)
            total_tokens += tokens
            click.echo(
                f"  section {i}/{len(chunks)} [{v}]: {len(t.split())} words, "
                f"{len(raw) / 2 / rate:.1f}s, {tokens} tokens",
                err=True,
            )

    with tempfile.NamedTemporaryFile(suffix=".pcm") as tmp:
        tmp.write(pcm)
        tmp.flush()
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "s16le", "-ar", str(rate),
                        "-ac", "1", "-i", tmp.name, "-b:a", bitrate, str(out_path)], check=True)

    total_sec = len(pcm) / 2 / rate
    usage_str = f"{total_chars} chars" if backend == "chirp3-hd" else f"{total_tokens} tokens"
    click.echo(f"wrote {out_path} ({total_sec:.1f}s / {total_sec / 60:.1f} min, {backend}, {usage_str})")
    click.echo("\n# Kinloom narratives.yaml snippet:")
    click.echo("extensions:")
    click.echo("  narrative_audio:")
    click.echo(f"    file: media/{out_path.name}")
    click.echo(f"    duration_seconds: {round(total_sec)}")
    if notes_start_sec is not None:
        click.echo(f"    editor_notes_start_seconds: {round(notes_start_sec)}")
    click.echo(f"    story_voice: {voice}")
    click.echo(f"    notes_voice: {notes_voice}")


@cli.command()
@click.argument("audio", type=click.Path(exists=True))
@click.option("--model", default=DEFAULT_TEXT_MODEL, show_default=True)
@click.option("--key-file", type=click.Path())
@click.option("-o", "--out", type=click.Path(), help="output .md (default: next to audio)")
def transcribe(audio, model, key_file, out) -> None:
    """Verbatim, timestamped transcript that flags glitches (paid; for QA)."""
    key = api_key(key_file)
    mime = {".mp3": "audio/mpeg", ".wav": "audio/wav", ".ogg": "audio/ogg"}.get(
        Path(audio).suffix.lower(), "audio/mpeg")
    prompt = ("Transcribe this audio VERBATIM with [mm:ss] timestamps at the start of each "
              "sentence. Write exactly what is spoken, including mistakes, repetitions and "
              "mispronunciations (note them in [brackets]), and any non-speech sounds such as "
              "clicks, noise bursts, garbled audio, long silences, or abrupt cuts. If any "
              "phonetic symbols or slashes are read out literally, mark them [read IPA aloud]. "
              "Do not correct or clean up anything.")
    resp = generate(key, model, {"contents": [{"parts": [
        {"inlineData": {"mimeType": mime,
                        "data": base64.b64encode(Path(audio).read_bytes()).decode()}},
        {"text": prompt}]}]})
    text = "".join(p.get("text", "") for p in resp["candidates"][0]["content"]["parts"])
    out_path = Path(out) if out else Path(audio).with_suffix(".transcript.md")
    out_path.write_text(text)
    click.echo(text)
    click.echo(f"\nwrote {out_path}", err=True)


if __name__ == "__main__":
    cli()
