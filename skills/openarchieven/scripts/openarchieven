#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "click>=8.1",
#   "httpx>=0.27",
# ]
# ///
"""Search, inspect, and download Dutch and Belgian genealogical records via OpenArchieven.

Uses the public OpenArchieven 1.0 JSON API (https://api.openarch.nl/1.0/records/):
no API key or login is required for read access. Requests are spaced to respect
the 4 requests/second IP rate limit.
"""

from __future__ import annotations

import email.utils
import hashlib
import ipaddress
import json
import math
import os
import re
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Callable, Iterator
from urllib.parse import urlencode, urlparse

import click
import httpx

DEFAULT_CACHE_TTL_HOURS = 168.0
CACHE_SCHEMA = 1


def cache_dir() -> Path:
    override = os.environ.get("KINLOOM_OPENARCHIEVEN_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".cache" / "kinloom-openarchieven"


def resolve_ttl_hours(cli_ttl: float | None) -> float:
    if cli_ttl is not None:
        if not math.isfinite(cli_ttl) or cli_ttl < 0:
            raise click.BadParameter(f"Invalid --cache-ttl-hours value: {cli_ttl!r} (must be >= 0).")
        return float(cli_ttl)
    raw = os.environ.get("KINLOOM_OPENARCHIEVEN_CACHE_TTL_HOURS")
    if raw is not None and raw.strip():
        try:
            parsed = float(raw.strip())
        except ValueError as exc:
            raise click.BadParameter(f"Invalid KINLOOM_OPENARCHIEVEN_CACHE_TTL_HOURS value: {raw!r}.") from exc
        if not math.isfinite(parsed) or parsed < 0:
            raise click.BadParameter(
                f"Invalid KINLOOM_OPENARCHIEVEN_CACHE_TTL_HOURS value: {raw!r} (must be >= 0).")
        return parsed
    return DEFAULT_CACHE_TTL_HOURS


@contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    """Advisory exclusive lock (POSIX flock); no-op where fcntl is missing."""
    try:
        import fcntl
    except ImportError:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def atomic_write_json(dest: Path, payload: Any) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def atomic_write_bytes(dest: Path, data: bytes) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def cache_key(kind: str, payload: dict) -> str:
    canonical = json.dumps([kind, payload], sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_cache(path: Path, ttl_hours: float) -> dict | None:
    if not path.is_file():
        return None
    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    if not isinstance(fetched, (int, float)):
        return None
    if ttl_hours <= 0 or (time.time() - fetched) > ttl_hours * 3600:
        return None
    result = entry.get("result")
    return result if isinstance(result, dict) else None


def cached_call(kind: str, payload: dict, fetch: Callable[[], dict], *,
                refresh: bool, ttl_hours: float,
                cacheable: Callable[[dict], bool] = lambda _r: True) -> tuple[dict, bool]:
    """Return (result, cache_hit). Concurrent callers of one query serialize
    on a per-key flock, so the second caller reads the first caller's file.
    Failures raise out of fetch() and are never written; results rejected by
    `cacheable` are returned but not stored."""
    key = cache_key(kind, payload)
    root = cache_dir()
    path = root / f"{key}.json"
    if not refresh:
        hit = read_cache(path, ttl_hours)
        if hit is not None:
            return hit, True
    with file_lock(root / f"{key}.lock"):
        if not refresh:
            hit = read_cache(path, ttl_hours)
            if hit is not None:
                return hit, True
        result = fetch()
        if cacheable(result):
            atomic_write_json(path, {"schema": CACHE_SCHEMA, "fetched_at": time.time(),
                                     "kind": kind, "query": payload, "result": result})
        return result, False

API_BASE = "https://api.openarch.nl/1.0/records"
WEB_BASE = "https://www.openarchieven.nl"
ALLOWED_API_HOSTS = frozenset({"api.openarch.nl"})
TRANSIENT_STATUS_CODES = frozenset({429, 500, 502, 503, 504, 520, 522, 524})
MAX_HTTP_ATTEMPTS = 3
RETRY_BASE_SECONDS = 0.5
ARCHIVE_CODE_RE = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
RECORD_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
PROXY_THUMB_RE = re.compile(
    r"^https?://proxy\.archieven\.nl/thumb/([^/?#]+)/([^/?#]+)(?:[?#].*)?$",
    re.IGNORECASE,
)
IIIF_INFO_RE = re.compile(r"^(https?://.+)/info\.json(?:[?#].*)?$", re.IGNORECASE)
IIIF_JP2_RE = re.compile(r"^(https?://.+/full/[^/?#]+/[^/?#]+/default)\.jp2(?:[?#].*)?$", re.IGNORECASE)
VIEWER_HOSTS = frozenset({
    "www.archieven.nl",
    "archieven.nl",
    "www.zeeuwsarchief.nl",
    "zeeuwsarchief.nl",
    "www.zeeuwengezocht.nl",
    "zeeuwengezocht.nl",
    "hdl.handle.net",
    "collectie-delft.nl",
    "www.collectie-delft.nl",
    "allefriezen.nl",
    "www.allefriezen.nl",
    "westbrabantsarchief.nl",
    "www.westbrabantsarchief.nl",
    "stadsarchief.rotterdam.nl",
    "www.stadsarchief.rotterdam.nl",
    "hetutrechtsarchief.nl",
    "www.hetutrechtsarchief.nl",
    "www.bhic.nl",
    "bhic.nl",
    "www.allegroningers.nl",
    "allegroningers.nl",
})
USER_AGENT = "kinloom/1.0 (genealogy research; https://github.com/tiberriver256/kinloom)"
MIN_INTERVAL_S = 0.25
TIMEOUT = 30.0

KNOWN_SOURCE_TYPES = {
    "bevolkingsregister",
    "passagiersregisters",
    "notariële archieven",
    "militieregisters",
    "bidprentjes",
    "familienamen",
    "gezinskaarten",
    "persoonskaarten",
    "woningkaarten",
    "memorie van successie",
}


def _fail(message: str) -> None:
    click.echo(message, err=True)
    raise SystemExit(1)


def cache_options(func: Callable) -> Callable:
    func = click.option(
        "--cache-ttl-hours",
        type=float,
        default=None,
        help="Cache TTL in hours (default 168, env KINLOOM_OPENARCHIEVEN_CACHE_TTL_HOURS; 0 disables reads).",
    )(func)
    func = click.option(
        "--refresh",
        is_flag=True,
        help="Bypass the disk cache for this request (the fresh result is still cached).",
    )(func)
    return func


def _client() -> httpx.Client:
    return httpx.Client(
        timeout=TIMEOUT,
        follow_redirects=True,
        headers={"User-Agent": USER_AGENT, "Accept": "application/json"},
    )


def _binary_client() -> httpx.Client:
    return httpx.Client(
        timeout=TIMEOUT,
        follow_redirects=True,
        headers={"User-Agent": USER_AGENT, "Accept": "image/*,application/pdf;q=0.9,*/*;q=0.1"},
    )


def validate_api_url(url: str) -> str:
    parsed = urlparse(url)
    if parsed.scheme != "https":
        _fail(f"Refusing non-HTTPS API URL: {url!r}")
    if parsed.username or parsed.password:
        _fail("Refusing API URL containing embedded credentials.")
    host = (parsed.hostname or "").lower()
    if host not in ALLOWED_API_HOSTS:
        _fail(
            f"Refusing API host {host!r}; allowed hosts: {', '.join(sorted(ALLOWED_API_HOSTS))}."
        )
    return url


def validate_scan_url(url: str) -> str:
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        _fail(f"Refusing to download a scan URL that is not http or https: {url}")
    if parsed.username or parsed.password:
        _fail("Refusing scan URL containing embedded credentials.")
    host = (parsed.hostname or "").lower().rstrip(".")
    if not host or host == "localhost" or host.endswith((".localhost", ".local", ".internal")):
        _fail(f"Refusing local or private scan host {host!r}: {url}")
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        ip = None
    if ip is not None and (
        ip.is_private
        or ip.is_loopback
        or ip.is_link_local
        or ip.is_multicast
        or ip.is_reserved
        or ip.is_unspecified
    ):
        _fail(f"Refusing private or reserved IP scan host {host!r}: {url}")
    return url


def _retry_delay(attempt: int, resp: httpx.Response | None = None) -> float:
    if resp is not None:
        raw = resp.headers.get("Retry-After")
        if raw:
            stripped = raw.strip()
            try:
                val = float(stripped)
                if math.isfinite(val) and 0 <= val <= 30:
                    return val
            except ValueError:
                try:
                    dt = email.utils.parsedate_to_datetime(stripped)
                    if dt.tzinfo is None:
                        from datetime import timezone
                        dt = dt.replace(tzinfo=timezone.utc)
                    delta = dt.timestamp() - time.time()
                    if math.isfinite(delta) and 0 <= delta <= 30:
                        return delta
                except (TypeError, ValueError, OverflowError):
                    pass
    if RETRY_BASE_SECONDS <= 0:
        return 0.0
    return RETRY_BASE_SECONDS * (2 ** (attempt - 1))


def _request_with_retry(
    client_factory: Callable[[], httpx.Client],
    url: str,
    *,
    validator: Callable[[str], str],
    params: dict[str, Any] | None = None,
    label: str,
) -> httpx.Response:
    validator(url)
    if MIN_INTERVAL_S > 0:
        time.sleep(MIN_INTERVAL_S)
    last_exc: Exception | None = None
    with client_factory() as client:
        for attempt in range(1, MAX_HTTP_ATTEMPTS + 1):
            try:
                resp = client.get(url, params=params)
            except (httpx.TimeoutException, httpx.TransportError) as exc:
                last_exc = exc
                if attempt < MAX_HTTP_ATTEMPTS:
                    delay = _retry_delay(attempt)
                    if delay > 0:
                        time.sleep(delay)
                    continue
                _fail(f"{label} failed after {attempt} attempt(s): {exc}")
            except httpx.HTTPError as exc:
                _fail(f"{label} failed: {exc}")

            validator(str(resp.url))

            if resp.status_code in TRANSIENT_STATUS_CODES and attempt < MAX_HTTP_ATTEMPTS:
                delay = _retry_delay(attempt, resp)
                if delay > 0:
                    time.sleep(delay)
                continue
            return resp

    _fail(f"{label} failed: {last_exc}")
    raise AssertionError("unreachable")


def _get_json(endpoint: str, params: dict[str, Any]) -> Any:
    """Fetch one JSON response from api.openarch.nl with host allowlist and retries."""
    url = f"{API_BASE}/{endpoint}"
    resp = _request_with_retry(
        _client,
        url,
        validator=validate_api_url,
        params=params,
        label="OpenArchieven request",
    )
    if resp.status_code != 200:
        _fail(f"HTTP {resp.status_code} from {url}")
    try:
        data = resp.json()
    except ValueError as exc:
        _fail(f"Invalid JSON from {url}: {exc}")
    if isinstance(data, dict) and data.get("error_code") is not None:
        desc = data.get("error_description") or data.get("error") or "Unknown API error"
        _fail(f"OpenArchieven API error {data['error_code']}: {desc}")
    return data


def search_window(limit: int, start: int, page: int | None, start_from_user: bool) -> tuple[int, int]:
    """Return (number_show, start) for search.json.

    `--page` is a 1-based alias for start. The offset uses the same limit the
    API receives (1 through 100). Page 1 therefore keeps start at 0, and the
    cache key stays the existing start/number_show payload. Page is never
    stored in that payload.
    """
    number_show = max(1, min(int(limit), 100))
    if page is not None:
        if start_from_user:
            raise click.UsageError("Do not combine --page with --start.")
        if page < 1:
            raise click.BadParameter("Must be an integer >= 1.", param_hint="--page")
        start = (page - 1) * number_show
    return number_show, max(0, min(int(start), 10000))


def _search_cacheable(result: dict[str, Any]) -> bool:
    resp = result.get("response")
    if not isinstance(resp, dict):
        return False
    docs = resp.get("docs")
    found = resp.get("number_found")
    return isinstance(docs, list) and isinstance(found, int) and found >= 0 and (bool(docs) or found == 0)


def _show_cacheable(result: dict[str, Any]) -> bool:
    data = result.get("data")
    if isinstance(data, dict):
        return bool(data)
    if isinstance(data, list):
        return len(data) > 0
    return False


class ScanPayloadError(Exception):
    """The HTTP body is not a non-empty image or PDF."""


class _ScanHttpError(Exception):
    """Non-200 HTTP response while downloading a scan candidate."""

    def __init__(self, status_code: int, url: str) -> None:
        self.status_code = status_code
        self.url = url
        super().__init__(
            f"Scan download failed with HTTP {status_code} for {url}. The response was not cached."
        )


def _is_viewer_url(url: str) -> bool:
    parsed = urlparse(url)
    host = (parsed.hostname or "").lower()
    if host in VIEWER_HOSTS:
        return True
    if host == "sgen.schiedam.nl" and not parsed.path.lower().startswith("/scans/"):
        return True
    return False


def _derive_proxy_download_url(url: str) -> str | None:
    if not url:
        return None
    match = PROXY_THUMB_RE.fullmatch(url.strip())
    if not match:
        return None
    return f"https://proxy.archieven.nl/download/{match.group(1)}/{match.group(2)}"


def _derive_iiif_jpeg_url(url: str) -> str | None:
    if not url:
        return None
    cleaned = url.strip()
    info_match = IIIF_INFO_RE.fullmatch(cleaned)
    if info_match:
        return f"{info_match.group(1)}/full/full/0/default.jpg"
    jp2_match = IIIF_JP2_RE.fullmatch(cleaned)
    if jp2_match:
        return f"{jp2_match.group(1)}.jpg"
    return None


def _append_unique_url(items: list[str], candidate: str | None) -> None:
    if not candidate:
        return
    cleaned = candidate.strip()
    if cleaned and cleaned not in items:
        items.append(cleaned)


class ScanImage:
    """One scan image from an A2A record, after order normalization."""

    def __init__(self, index: int, order: int | None, label: str, uri: str, uri_preview: str) -> None:
        self.index = index
        self.order = order
        self.label = label
        self.uri = uri
        self.uri_preview = uri_preview

    def chosen_url(self, preview: bool) -> str:
        if preview:
            return self.uri_preview or self.uri
        return self.uri or self.uri_preview

    def candidate_urls(self, preview: bool) -> list[tuple[str, bool]]:
        """Return ordered (url, allow_http_5xx_fallback) download candidates."""
        if preview:
            urls: list[str] = []
            _append_unique_url(urls, self.uri_preview)
            _append_unique_url(urls, self.uri)
            return [(u, False) for u in urls]

        proxy_full = _derive_proxy_download_url(self.uri_preview) or _derive_proxy_download_url(self.uri)
        iiif_jpg = _derive_iiif_jpeg_url(self.uri)
        candidates: list[tuple[str, bool]] = []
        seen: set[str] = set()

        def add(url: str | None, fallback_on_5xx: bool) -> None:
            if not url:
                return
            cleaned = url.strip()
            if cleaned and cleaned not in seen:
                seen.add(cleaned)
                candidates.append((cleaned, fallback_on_5xx))

        if self.uri and _is_viewer_url(self.uri) and (proxy_full or self.uri_preview):
            add(proxy_full, True)
            add(self.uri_preview, False)
            return candidates

        add(iiif_jpg, True)
        add(self.uri, False)
        add(proxy_full, True)
        add(self.uri_preview, False)
        return candidates


_CONTENT_TYPE_EXT = {
    "image/jpeg": "jpg",
    "image/jpg": "jpg",
    "image/pjpeg": "jpg",
    "image/png": "png",
    "image/gif": "gif",
    "image/webp": "webp",
    "image/tiff": "tif",
    "image/tif": "tif",
    "image/jp2": "jp2",
    "image/jpeg2000": "jp2",
    "application/pdf": "pdf",
}

_HTML_CONTENT_TYPES = {"text/html", "application/xhtml+xml"}


def _scan_value(scan: dict[str, Any], names: tuple[str, ...]) -> str:
    lowered = {str(key).lower(): value for key, value in scan.items()}
    for name in names:
        if name in scan:
            text = _a2a_text(scan.get(name))
            if text:
                return text
        text = _a2a_text(lowered.get(name.lower()))
        if text:
            return text
    return ""


def _scan_order(scan: dict[str, Any]) -> int | None:
    raw = _scan_value(scan, ("a2a_OrderSequenceNumber", "a2a_Order", "order", "Order"))
    if not raw:
        return None
    try:
        return int(raw)
    except ValueError:
        return None


def _as_show_records(data: Any) -> list[dict[str, Any]]:
    if isinstance(data, dict):
        return [data]
    if isinstance(data, list):
        return [item for item in data if isinstance(item, dict)]
    return []


def extract_scans(record: dict[str, Any]) -> list[ScanImage]:
    """Return full-resolution scan URLs in order. Preview URLs stay on the object."""
    source = record.get("a2a_Source")
    if not isinstance(source, dict):
        return []
    block = source.get("a2a_SourceAvailableScans")
    raw_scans: list[Any]
    if isinstance(block, dict):
        raw = block.get("a2a_Scan")
        if raw is None:
            raw_scans = [block] if _scan_value(block, ("a2a_Uri", "uri", "Uri")) else []
        else:
            raw_scans = _as_list(raw)
    elif isinstance(block, list):
        raw_scans = block
    else:
        return []

    found: list[tuple[int | None, str, str, str]] = []
    for scan in raw_scans:
        if not isinstance(scan, dict):
            continue
        uri = _scan_value(scan, ("a2a_Uri", "uri", "Uri"))
        preview = _scan_value(scan, ("a2a_UriPreview", "uri_preview", "UriPreview"))
        if not uri and not preview:
            continue
        label = _scan_value(
            scan,
            ("a2a_Label", "a2a_Caption", "a2a_Title", "a2a_Description", "label", "caption", "title"),
        )
        found.append((_scan_order(scan), label, uri, preview))

    ordered = sorted(enumerate(found), key=lambda item: (item[1][0] is None, item[1][0] or 0, item[0]))
    scans: list[ScanImage] = []
    for index, (_pos, (order, label, uri, preview)) in enumerate(ordered, start=1):
        scans.append(ScanImage(index, order, label, uri, preview))
    return scans


def extract_scans_from_show(data: Any) -> list[ScanImage]:
    scans: list[ScanImage] = []
    for record in _as_show_records(data):
        scans.extend(extract_scans(record))
    return [
        ScanImage(index, scan.order, scan.label, scan.uri, scan.uri_preview)
        for index, scan in enumerate(scans, start=1)
    ]


def _magic_extension(content: bytes) -> str | None:
    if content.startswith(b"\xff\xd8\xff"):
        return "jpg"
    if content.startswith(b"\x89PNG\r\n\x1a\n") or content.startswith(b"\x89PNG"):
        return "png"
    if content.startswith((b"GIF87a", b"GIF89a")):
        return "gif"
    if content.startswith(b"%PDF"):
        return "pdf"
    if len(content) >= 12 and content.startswith(b"RIFF") and content[8:12] == b"WEBP":
        return "webp"
    if content.startswith((b"II*\x00", b"MM\x00*")):
        return "tif"
    if content.startswith(b"\x00\x00\x00\x0cjP") or content.startswith(b"\xff\x4f\xff\x51"):
        return "jp2"
    return None


def _looks_like_markup(content: bytes) -> bool:
    head = content[:512].lstrip().lower()
    return head.startswith((b"<html", b"<!doctype", b"<head", b"<body", b"<?xml", b"<"))


def classify_scan_payload(content: bytes, content_type: str) -> str:
    """Return a file extension for an image or PDF body."""
    media = content_type.split(";", 1)[0].strip().lower()
    if not content:
        raise ScanPayloadError("The download was empty.")
    if media in _HTML_CONTENT_TYPES:
        shown = media or "unknown type"
        raise ScanPayloadError(
            f"The server returned HTML ({shown}), not an image or PDF. Open the scan URL in a browser."
        )
    magic = _magic_extension(content)
    if magic:
        return magic
    if _looks_like_markup(content):
        raise ScanPayloadError(
            "The server returned HTML, not an image or PDF. Open the scan URL in a browser."
        )
    mapped = _CONTENT_TYPE_EXT.get(media)
    if mapped:
        return mapped
    shown = media or "missing content-type"
    raise ScanPayloadError(
        f"The server did not return an image or PDF ({shown}). Open the scan URL in a browser."
    )


def _scan_cache_paths(url: str) -> tuple[Path, Path, Path]:
    key = hashlib.sha256(url.encode("utf-8")).hexdigest()
    root = cache_dir() / "scans"
    return root / f"{key}.bin", root / f"{key}.json", root / f"{key}.lock"


def _read_cached_scan(bin_path: Path, meta_path: Path, ttl_hours: float) -> tuple[bytes, str] | None:
    if ttl_hours <= 0 or not bin_path.is_file():
        return None
    try:
        entry = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(entry, dict) or entry.get("schema") != CACHE_SCHEMA:
        return None
    fetched = entry.get("fetched_at")
    nbytes = entry.get("nbytes")
    if not isinstance(fetched, (int, float)) or not isinstance(nbytes, int):
        return None
    if (time.time() - fetched) > ttl_hours * 3600:
        return None
    try:
        data = bin_path.read_bytes()
    except OSError:
        return None
    if len(data) != nbytes or nbytes <= 0:
        return None
    try:
        ext = classify_scan_payload(data, "application/octet-stream")
    except ScanPayloadError:
        return None
    return data, ext


def _fetch_scan_bytes(url: str) -> tuple[bytes, str]:
    resp = _request_with_retry(
        _binary_client,
        url,
        validator=validate_scan_url,
        label=f"Scan download for {url}",
    )
    if resp.status_code != 200:
        raise _ScanHttpError(resp.status_code, url)
    return bytes(resp.content), resp.headers.get("content-type", "")


def _cached_scan_bytes_checked(url: str, *, refresh: bool, ttl_hours: float) -> tuple[bytes, str, bool]:
    """Return (body, extension, cache_hit), raising ScanPayloadError or _ScanHttpError on failure."""
    bin_path, meta_path, lock_path = _scan_cache_paths(url)
    if not refresh:
        hit = _read_cached_scan(bin_path, meta_path, ttl_hours)
        if hit is not None:
            return hit[0], hit[1], True
    with file_lock(lock_path):
        if not refresh:
            hit = _read_cached_scan(bin_path, meta_path, ttl_hours)
            if hit is not None:
                return hit[0], hit[1], True
        body, content_type = _fetch_scan_bytes(url)
        ext = classify_scan_payload(body, content_type)
        atomic_write_bytes(bin_path, body)
        atomic_write_json(
            meta_path,
            {"schema": CACHE_SCHEMA, "fetched_at": time.time(), "nbytes": len(body), "ext": ext},
        )
        return body, ext, False


def cached_scan_bytes(url: str, *, refresh: bool, ttl_hours: float) -> tuple[bytes, str, bool]:
    """Return (body, extension, cache_hit). Only a non-empty image or PDF is stored."""
    try:
        return _cached_scan_bytes_checked(url, refresh=refresh, ttl_hours=ttl_hours)
    except ScanPayloadError as exc:
        _fail(f"{exc} URL: {url}. Nothing was saved or cached.")
    except _ScanHttpError as exc:
        _fail(str(exc))
    raise AssertionError("unreachable")


def download_scan_candidates(
    candidates: list[tuple[str, bool]], *, refresh: bool, ttl_hours: float
) -> tuple[bytes, str, str, bool]:
    """Try ordered scan URL candidates and return (body, ext, resolved_url, cache_hit)."""
    last_error: str | None = None
    for idx, (candidate_url, fallback_on_5xx) in enumerate(candidates):
        has_next = idx + 1 < len(candidates)
        try:
            body, ext, hit = _cached_scan_bytes_checked(
                candidate_url, refresh=refresh, ttl_hours=ttl_hours
            )
            return body, ext, candidate_url, hit
        except ScanPayloadError as exc:
            last_error = f"{exc} URL: {candidate_url}. Nothing was saved or cached."
            if has_next:
                continue
            _fail(last_error)
        except _ScanHttpError as exc:
            last_error = str(exc)
            if has_next and (fallback_on_5xx or exc.status_code in {403, 404, 410}):
                continue
            _fail(last_error)
    _fail(last_error or "No downloadable scan URL was found.")
    raise AssertionError("unreachable")


def _load_show(code: str, ident: str, lang: str, *, refresh: bool, ttl_hours: float) -> tuple[Any, bool]:
    params = {"archive": code, "identifier": ident, "lang": lang}

    def _fetch() -> dict[str, Any]:
        return {"data": _get_json("show.json", params)}

    wrapped, hit = cached_call(
        "show",
        params,
        _fetch,
        refresh=refresh,
        ttl_hours=ttl_hours,
        cacheable=_show_cacheable,
    )
    return wrapped.get("data"), hit


def _scan_filename(archive: str, identifier: str, index: int, ext: str) -> str:
    short = re.sub(r"[^A-Za-z0-9]", "", identifier)[:8].lower() or "record"
    safe_archive = re.sub(r"[^A-Za-z0-9_-]", "", archive).lower() or "archive"
    safe_ext = re.sub(r"[^A-Za-z0-9]", "", ext).lower() or "img"
    return f"{safe_archive}-{short}-scan-{index:02d}.{safe_ext}"


def _is_source_type(value: str) -> bool:
    low = value.strip().lower()
    return low.startswith("bs ") or low.startswith("dtb ") or low in KNOWN_SOURCE_TYPES


def _fmt_eventdate(date_obj: Any) -> str:
    if not isinstance(date_obj, dict):
        return ""
    year = date_obj.get("year")
    month = date_obj.get("month")
    day = date_obj.get("day")
    if year is None:
        return ""
    if month and day:
        return f"{int(year):04d}-{int(month):02d}-{int(day):02d}"
    if month:
        return f"{int(year):04d}-{int(month):02d}"
    return f"{int(year):04d}"


def _a2a_text(node: Any) -> str:
    """Unwrap OpenArchieven's nested A2A JSON single-key string wrappers."""
    if node is None:
        return ""
    if isinstance(node, str):
        return node.strip()
    if isinstance(node, (int, float)):
        return str(node)
    if isinstance(node, dict):
        for key, val in node.items():
            if isinstance(val, (str, int, float)):
                return str(val).strip()
            if isinstance(val, dict) and key in val:
                return _a2a_text(val[key])
        for val in node.values():
            found = _a2a_text(val)
            if found:
                return found
    return ""


def _as_list(val: Any) -> list[Any]:
    if val is None:
        return []
    return val if isinstance(val, list) else [val]


def _fmt_a2a_date(date_node: Any) -> str:
    if not isinstance(date_node, dict):
        return _a2a_text(date_node)
    year = _a2a_text(date_node.get("a2a_Year"))
    month = _a2a_text(date_node.get("a2a_Month"))
    day = _a2a_text(date_node.get("a2a_Day"))
    if year and month and day:
        try:
            return f"{int(year):04d}-{int(month):02d}-{int(day):02d}"
        except ValueError:
            pass
    if year and month:
        try:
            return f"{int(year):04d}-{int(month):02d}"
        except ValueError:
            pass
    if year:
        return year
    return _a2a_text(date_node.get("a2a_LiteralDate"))


def _fmt_a2a_person_name(name_node: Any) -> str:
    if not isinstance(name_node, dict):
        return _a2a_text(name_node)
    parts = [
        _a2a_text(name_node.get("a2a_PersonNameFirstName")),
        _a2a_text(name_node.get("a2a_PersonNamePatronym")),
        _a2a_text(name_node.get("a2a_PersonNamePrefixLastName")),
        _a2a_text(name_node.get("a2a_PersonNameLastName")),
    ]
    return " ".join(p for p in parts if p)


def _validate_record_ref(code: str, ident: str) -> tuple[str, str]:
    cleaned_code = code.strip()
    cleaned_ident = ident.strip()
    if not ARCHIVE_CODE_RE.fullmatch(cleaned_code) or not RECORD_ID_RE.fullmatch(cleaned_ident):
        raise click.UsageError(
            f"Invalid archive or record identifier ({cleaned_code!r}, {cleaned_ident!r})."
        )
    return cleaned_code, cleaned_ident


def _parse_record_ref(archive: str, identifier: str | None) -> tuple[str, str]:
    """Accept either (archive, identifier), 'archive:identifier', or an openarchieven.nl URL."""
    if identifier:
        return _validate_record_ref(archive, identifier)
    match = re.search(r"openarchieven\.nl/([a-z0-9_-]+):([A-Za-z0-9_-]+)", archive, re.I)
    if match:
        return _validate_record_ref(match.group(1), match.group(2))
    if ":" in archive:
        code, ident = archive.split(":", 1)
        ident = ident.split("/", 1)[0].split("?", 1)[0]
        if code.strip() and ident.strip():
            return _validate_record_ref(code, ident)
    raise click.UsageError(
        "Pass ARCHIVE and IDENTIFIER, an 'archive:uuid' token, or an openarchieven.nl record URL."
    )


def _format_a2a_record(archive: str, identifier: str, record: dict[str, Any]) -> str:
    lines = [
        f"Record: {archive}:{identifier}",
        f"  URL: {WEB_BASE}/{archive}:{identifier}",
    ]
    source = record.get("a2a_Source") or {}
    source_type = _a2a_text(source.get("a2a_SourceType"))
    source_place = _a2a_text((source.get("a2a_SourcePlace") or {}).get("a2a_Place"))
    ref = source.get("a2a_SourceReference") or {}
    inst = _a2a_text(ref.get("a2a_InstitutionName"))
    book = _a2a_text(ref.get("a2a_Book"))
    collection = _a2a_text(ref.get("a2a_Collection"))
    doc_num = _a2a_text(ref.get("a2a_DocumentNumber"))
    archive_num = _a2a_text(ref.get("a2a_Archive"))
    reg_num = _a2a_text(ref.get("a2a_RegistryNumber"))

    if source_type:
        lines.append(f"  Source type: {source_type}")
    if inst:
        lines.append(f"  Institution: {inst}")
    if source_place:
        lines.append(f"  Source place: {source_place}")
    ref_parts = [
        f"Archive {archive_num}" if archive_num else "",
        f"Registry {reg_num}" if reg_num else "",
        book,
        collection,
        f"Document {doc_num}" if doc_num else "",
    ]
    ref_line = " | ".join(p for p in ref_parts if p)
    if ref_line:
        lines.append(f"  Reference: {ref_line}")

    events = _as_list(record.get("a2a_Event"))
    for ev in events:
        if not isinstance(ev, dict):
            continue
        ev_type = _a2a_text(ev.get("a2a_EventType"))
        ev_date = _fmt_a2a_date(ev.get("a2a_EventDate"))
        ev_place = _a2a_text((ev.get("a2a_EventPlace") or {}).get("a2a_Place"))
        summary = " | ".join(p for p in (ev_type, ev_date, ev_place) if p)
        if summary:
            lines.append(f"  Event: {summary}")

    roles_by_pid: dict[str, list[str]] = {}
    for rel in _as_list(record.get("a2a_RelationEP")):
        if not isinstance(rel, dict):
            continue
        pid = _a2a_text(rel.get("a2a_PersonKeyRef"))
        role = _a2a_text(rel.get("a2a_RelationType"))
        if pid and role:
            roles_by_pid.setdefault(pid, []).append(role)

    persons = _as_list(record.get("a2a_Person"))
    if persons:
        lines.append("  Persons:")
        for person in persons:
            if not isinstance(person, dict):
                continue
            pid = str(person.get("pid") or "")
            name = _fmt_a2a_person_name(person.get("a2a_PersonName")) or "(unnamed)"
            role_str = ", ".join(roles_by_pid.get(pid, []))
            bdate = _fmt_a2a_date(person.get("a2a_BirthDate"))
            bplace = _a2a_text((person.get("a2a_BirthPlace") or {}).get("a2a_Place"))
            res = _a2a_text((person.get("a2a_Residence") or {}).get("a2a_Place"))
            occ = _a2a_text(person.get("a2a_Profession"))
            details = []
            if role_str:
                details.append(role_str)
            if bdate or bplace:
                details.append("b. " + ", ".join(p for p in (bdate, bplace) if p))
            if res:
                details.append(f"res. {res}")
            if occ:
                details.append(f"occ. {occ}")
            suffix = f" ({'; '.join(details)})" if details else ""
            lines.append(f"    - {name}{suffix}")

    scans = extract_scans(record)
    if scans:
        lines.append("  Scans:")
        for scan in scans[:5]:
            lines.append(f"    - {scan.chosen_url(False)}")
        if len(scans) > 5:
            lines.append(f"    - (+{len(scans) - 5} more)")

    orig = _a2a_text(source.get("a2a_SourceDigitalOriginal"))
    if orig:
        lines.append(f"  Original: {orig}")

    return "\n".join(lines)


@click.group(context_settings={"help_option_names": ["-h", "--help"]})
def cli() -> None:
    """Search and inspect Dutch and Belgian archive records on OpenArchieven."""


def _is_direct_scan_url(value: str) -> bool:
    cleaned = value.strip()
    if not cleaned.lower().startswith(("http://", "https://")):
        return False
    return re.search(r"openarchieven\.nl/([a-z0-9_-]+):([A-Za-z0-9_-]+)", cleaned, re.I) is None


def _is_complete_record_ref(value: str) -> bool:
    cleaned = value.strip()
    if _is_direct_scan_url(cleaned):
        return True
    if re.search(r"openarchieven\.nl/([a-z0-9_-]+):([A-Za-z0-9_-]+)", cleaned, re.I):
        return True
    return ":" in cleaned


@cli.command()
@click.argument("name_arg", required=False, default=None)
@click.option("--name", "--query", "-q", "name_opt", default=None, help="Person name query (may include '&' for two names).")
@click.option("--first", "--first-name", "--given", "--given-name", "first_name", default=None, help="Given name (combined with --last/--surname).")
@click.option("--last", "--last-name", "--surname", "last_name", default=None, help="Surname (combined with --first/--given).")
@click.option("--place", default=None, help="Filter by event place (eventplace), e.g. Zundert or Rotterdam.")
@click.option("--birth-place", default=None, help="Filter by person birth place (birthplace).")
@click.option(
    "--event-type",
    default=None,
    help="Event type (e.g. Geboorte, Huwelijk, Overlijden) or source type (e.g. 'BS Geboorte', Bevolkingsregister).",
)
@click.option(
    "--source-type",
    default=None,
    help="Explicit OpenArchieven source type (e.g. 'BS Geboorte', 'BS Huwelijk', 'BS Overlijden', Bevolkingsregister, Passagiersregisters).",
)
@click.option(
    "--year",
    default=None,
    help="Year or year range (e.g. 1853 or 1850-1860), appended to the name query as required by the API.",
)
@click.option("--archive", default=None, help="Archive code filter, e.g. bhi, wba, srt, saa, zal.")
@click.option("--relation", default=None, help="Relation/role filter, e.g. Kind, Vader, Bruid, Geregistreerde.")
@click.option("--country", default=None, help="Country code filter, e.g. nl, be, fr.")
@click.option(
    "--lang",
    default="nl",
    show_default=True,
    type=click.Choice(["nl", "en", "de", "fr"]),
    help="Language for returned archive and type labels.",
)
@click.option("--limit", "-n", "--rows", "limit", type=int, default=10, show_default=True, help="Results to return (max 100).")
@click.option("--start", "--offset", "start", type=int, default=0, show_default=True, help="Offset for paging (max 10000).")
@click.option(
    "--page",
    type=click.IntRange(min=1),
    default=None,
    help="1-based page. Sets start to (page - 1) times the limit sent to the API. Do not combine with --start.",
)
@click.option("--json", "as_json", is_flag=True, help="Emit raw API JSON output.")
@cache_options
def search(
    name_arg: str | None,
    name_opt: str | None,
    first_name: str | None,
    last_name: str | None,
    place: str | None,
    birth_place: str | None,
    event_type: str | None,
    source_type: str | None,
    year: str | None,
    archive: str | None,
    relation: str | None,
    country: str | None,
    lang: str,
    limit: int,
    start: int,
    page: int | None,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Search OpenArchieven records.

    Example: openarchieven search --name "Vincent van Gogh" --place Zundert --year 1853
    """
    combined_parts = " ".join(part.strip() for part in (first_name, last_name) if part and part.strip())
    raw_name = (name_opt or name_arg or combined_parts).strip()
    if not raw_name:
        raise click.UsageError("Provide a name via --name, --first/--last, or a positional argument.")
    if year:
        raw_name = f"{raw_name} {year.strip()}"

    ctx = click.get_current_context()
    start_from_user = ctx.get_parameter_source("start") is click.core.ParameterSource.COMMANDLINE
    number_show, start = search_window(limit, start, page, start_from_user)
    params: dict[str, Any] = {
        "name": raw_name,
        "number_show": number_show,
        "start": start,
        "lang": lang,
    }
    if place:
        params["eventplace"] = place
    if birth_place:
        params["birthplace"] = birth_place
    if source_type:
        params["sourcetype"] = source_type
    if event_type:
        if _is_source_type(event_type) and "sourcetype" not in params:
            params["sourcetype"] = event_type
        else:
            params["eventtype"] = event_type
    if archive:
        params["archive"] = archive
    if relation:
        params["relationtype"] = relation
    if country:
        params["country_code"] = country

    ttl = resolve_ttl_hours(cache_ttl_hours)

    def _fetch() -> dict[str, Any]:
        fetched = _get_json("search.json", params)
        if not isinstance(fetched, dict):
            _fail(f"Unexpected non-object search response from {API_BASE}/search.json")
        return fetched

    data, hit = cached_call(
        "search",
        params,
        _fetch,
        refresh=refresh,
        ttl_hours=ttl,
        cacheable=_search_cacheable,
    )
    if as_json:
        shown = dict(data)
        shown["cache_hit"] = bool(hit)
        click.echo(json.dumps(shown, indent=2, ensure_ascii=False))
        return

    resp = data.get("response") or {}
    total = resp.get("number_found", 0)
    docs = resp.get("docs") or []
    marker = " [cache]" if hit else ""
    click.echo(f"Found {total} records (showing {len(docs)} from offset {start}){marker}")
    for doc in docs:
        code = doc.get("archive_code") or ""
        ident = doc.get("identifier") or ""
        person = doc.get("personname") or "(unnamed)"
        role = doc.get("relationtype") or ""
        stype = doc.get("sourcetype") or doc.get("eventtype") or ""
        date_str = _fmt_eventdate(doc.get("eventdate"))
        places = doc.get("eventplace") or []
        place_str = ", ".join(places) if isinstance(places, list) else str(places)
        url = doc.get("url") or f"{WEB_BASE}/{code}:{ident}"
        click.echo(
            f"- {code}:{ident} | {person} ({role}) | {stype} | {date_str} | {place_str}\n"
            f"  {url}"
        )


@cli.command()
@click.argument("archive")
@click.argument("identifier", required=False, default=None)
@click.option(
    "--lang",
    default="nl",
    show_default=True,
    type=click.Choice(["nl", "en", "de", "fr"]),
    help="Language for returned labels.",
)
@click.option("--json", "as_json", is_flag=True, help="Emit raw A2A JSON output.")
@cache_options
def show(
    archive: str,
    identifier: str | None,
    lang: str,
    as_json: bool,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Fetch full A2A details for one record by ARCHIVE IDENTIFIER, archive:uuid, or URL."""
    code, ident = _parse_record_ref(archive, identifier)
    ttl = resolve_ttl_hours(cache_ttl_hours)
    data, hit = _load_show(code, ident, lang, refresh=refresh, ttl_hours=ttl)
    if as_json:
        if isinstance(data, dict):
            click.echo(json.dumps({**data, "cache_hit": bool(hit)}, indent=2, ensure_ascii=False))
        else:
            click.echo(json.dumps({"records": data, "cache_hit": bool(hit)}, indent=2, ensure_ascii=False))
        return
    records = data if isinstance(data, list) else [data]
    if not records:
        click.echo("No record data returned.")
        return
    for idx, rec in enumerate(records):
        if idx > 0:
            click.echo("")
        if isinstance(rec, dict):
            formatted = _format_a2a_record(code, ident, rec)
            if idx == 0 and hit:
                first_line, sep, rest = formatted.partition("\n")
                formatted = f"{first_line} [cache]{sep}{rest}"
            click.echo(formatted)


cli.add_command(show, name="get")


def _emit_download_json(payload: dict[str, Any]) -> None:
    click.echo(json.dumps(payload, indent=2, ensure_ascii=False))


@cli.command()
@click.argument("archive")
@click.argument("identifier", required=False, default=None)
@click.option("--scan-index", type=click.IntRange(min=1), default=1, show_default=True,
              help="1-based scan to download. Ignored with --all and with --list.")
@click.option("--all", "download_all", is_flag=True, help="Download every scan into --out-dir.")
@click.option("--list", "list_only", is_flag=True, help="Print scan index, label, and URL. Do not download.")
@click.option("--preview", is_flag=True, help="Use uri_preview instead of the full-resolution scan uri.")
@click.option("--out", "--output", "-o", "--out-dir", "--output-dir", "dest", default=None,
              help="Output file for one scan, or the output directory when --all is set.")
@click.option("--json", "as_json", is_flag=True, help="Emit JSON with cache_hit and files or scans.")
@click.option("--lang", default="nl", show_default=True, type=click.Choice(["nl", "en", "de", "fr"]),
              help="Language passed to the cached show lookup.")
@cache_options
def download(
    archive: str,
    identifier: str | None,
    scan_index: int,
    download_all: bool,
    list_only: bool,
    preview: bool,
    dest: str | None,
    as_json: bool,
    lang: str,
    refresh: bool,
    cache_ttl_hours: float | None,
) -> None:
    """Download scan images for one OpenArchieven record or a direct scan URL.

    Accepts ARCHIVE IDENTIFIER, archive:uuid, an openarchieven.nl record URL,
    or a direct scan image URL. Record metadata comes from the same disk cache as `show`.
    """
    if identifier and not dest and _is_complete_record_ref(archive):
        dest = identifier
        identifier = None

    ttl = resolve_ttl_hours(cache_ttl_hours)

    if not identifier and _is_direct_scan_url(archive):
        direct_url = validate_scan_url(archive.strip())
        if list_only:
            rows = [{"index": 1, "order": 1, "label": "", "url": direct_url}]
            if as_json:
                _emit_download_json({"url": direct_url, "scans": rows, "cache_hit": False})
                return
            click.echo(f"1. order=1\n   {direct_url}")
            return
        if not dest:
            raise click.UsageError("Pass --out FILE (or a positional output path) to download a direct scan URL.")
        dest_path = Path(dest).expanduser()
        if not (dest_path.exists() and dest_path.is_dir()):
            dest_path.parent.mkdir(parents=True, exist_ok=True)
        candidates: list[tuple[str, bool]] = []
        iiif_jpg = _derive_iiif_jpeg_url(direct_url)
        if iiif_jpg:
            candidates.append((iiif_jpg, True))
        proxy_full = _derive_proxy_download_url(direct_url)
        if proxy_full and not preview:
            candidates.append((proxy_full, True))
        candidates.append((direct_url, False))
        body, ext, resolved_url, file_hit = download_scan_candidates(
            candidates, refresh=refresh, ttl_hours=ttl
        )
        if dest_path.exists() and dest_path.is_dir():
            digest = hashlib.sha256(resolved_url.encode("utf-8")).hexdigest()[:8]
            out_file = dest_path / f"scan-{digest}.{ext}"
        else:
            out_file = dest_path
        atomic_write_bytes(out_file, body)
        item = {
            "index": 1,
            "order": 1,
            "label": "",
            "url": resolved_url,
            "path": str(out_file),
            "bytes": len(body),
            "cache_hit": file_hit,
        }
        if as_json:
            _emit_download_json({"url": resolved_url, "files": [item], "cache_hit": bool(file_hit)})
            return
        marker = " [cache]" if file_hit else ""
        click.echo(f"scan 1: {item['path']} ({item['bytes']} bytes){marker}")
        return

    code, ident = _parse_record_ref(archive, identifier)
    data, show_hit = _load_show(code, ident, lang, refresh=refresh, ttl_hours=ttl)
    scans = extract_scans_from_show(data)
    if list_only:
        rows = [
            {"index": scan.index, "order": scan.order, "label": scan.label, "url": scan.chosen_url(preview)}
            for scan in scans
        ]
        if as_json:
            _emit_download_json({
                "archive": code,
                "identifier": ident,
                "scans": rows,
                "cache_hit": bool(show_hit),
            })
            return
        marker = " [cache]" if show_hit else ""
        click.echo(f"Scans for {code}:{ident} ({len(rows)}){marker}")
        if not rows:
            click.echo("No scans.")
            return
        for row in rows:
            order = "-" if row["order"] is None else str(row["order"])
            label = f" {row['label']}" if row["label"] else ""
            click.echo(f"{row['index']}. order={order}{label}")
            click.echo(f"   {row['url']}")
        return

    if not scans:
        _fail(
            f"No scans are available for {code}:{ident}. "
            "The record has no a2a_SourceAvailableScans image URL."
        )
    if not dest:
        if download_all:
            raise click.UsageError("Pass --out-dir DIR (or --out DIR) when using --all.")
        raise click.UsageError("Pass --out FILE for one scan, or --all --out-dir DIR for every scan.")

    selected = scans
    if not download_all:
        match = next((scan for scan in scans if scan.index == scan_index), None)
        if match is None:
            _fail(f"Scan index {scan_index} is outside 1-{len(scans)} for {code}:{ident}.")
        selected = [match]

    dest_path = Path(dest).expanduser()
    if download_all:
        if dest_path.exists() and not dest_path.is_dir():
            _fail(f"--out-dir must be a directory. {dest_path} is a file.")
        dest_path.mkdir(parents=True, exist_ok=True)
    elif dest_path.exists() and dest_path.is_dir():
        pass
    else:
        dest_path.parent.mkdir(parents=True, exist_ok=True)

    files: list[dict[str, Any]] = []
    file_hits: list[bool] = []
    for scan in selected:
        candidates = scan.candidate_urls(preview)
        body, ext, resolved_url, file_hit = download_scan_candidates(
            candidates, refresh=refresh, ttl_hours=ttl
        )
        filename = _scan_filename(code, ident, scan.index, ext)
        if download_all or (dest_path.exists() and dest_path.is_dir()):
            out_file = dest_path / filename
        else:
            out_file = dest_path
        atomic_write_bytes(out_file, body)
        file_hits.append(file_hit)
        files.append({
            "index": scan.index,
            "order": scan.order,
            "label": scan.label,
            "url": resolved_url,
            "path": str(out_file),
            "bytes": len(body),
            "cache_hit": file_hit,
        })

    overall_hit = bool(show_hit and all(file_hits))
    if as_json:
        _emit_download_json({
            "archive": code,
            "identifier": ident,
            "files": files,
            "cache_hit": overall_hit,
        })
        return
    for item in files:
        marker = " [cache]" if item["cache_hit"] else ""
        click.echo(f"scan {item['index']}: {item['path']} ({item['bytes']} bytes){marker}")


@cli.command()
@click.option("--name", default=None, help="Person name query.")
@click.option("--place", default=None, help="Event place.")
@click.option("--year", default=None, help="Year or year range (e.g. 1853 or 1850-1860).")
@click.option("--record", default=None, help="Record token 'archive:uuid' to build a direct record URL.")
def url(name: str | None, place: str | None, year: str | None, record: str | None) -> None:
    """Print a shareable OpenArchieven website URL offline."""
    if record:
        code, ident = _parse_record_ref(record, None)
        click.echo(f"{WEB_BASE}/{code}:{ident}")
        return
    if not name:
        raise click.UsageError("Pass --name or --record.")
    q = f"{name.strip()} {year.strip()}" if year else name.strip()
    params = [("name", q)]
    if place:
        params.append(("eventplace", place.strip()))
    click.echo(f"{WEB_BASE}/search.php?{urlencode(params)}")


def main() -> None:
    try:
        cli()
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        try:
            os.dup2(devnull, sys.stdout.fileno())
        except (OSError, ValueError):
            pass
        finally:
            os.close(devnull)
        raise SystemExit(0)


if __name__ == "__main__":
    main()
